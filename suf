#!/usr/bin/env bash
set -Eeuo pipefail

APP_VERSION="1.2.4"
APP_NAME="suf"
APP_REPOSITORY="https://github.com/xhpx7301/suf"
DEFAULT_SSH_PORT="28377"
SSH_MAIN="/etc/ssh/sshd_config"
SSH_DROPIN_DIR="/etc/ssh/sshd_config.d"
SSH_DROPIN="${SSH_DROPIN_DIR}/00-suf-hardening.conf"
BACKUP_ROOT="/var/backups/${APP_NAME}"
FAIL2BAN_JAIL_DIR="/etc/fail2ban/jail.d"
FAIL2BAN_JAIL_FILE="${FAIL2BAN_JAIL_DIR}/${APP_NAME}.local"
LAST_CONFIGURED_USER=""
export LC_ALL=C

if [[ -t 1 ]]; then
  C_RED=$'\033[31m'
  C_GREEN=$'\033[32m'
  C_YELLOW=$'\033[33m'
  C_BLUE=$'\033[34m'
  C_RESET=$'\033[0m'
else
  C_RED=""
  C_GREEN=""
  C_YELLOW=""
  C_BLUE=""
  C_RESET=""
fi

info() { printf '%s[INFO]%s %s\n' "$C_BLUE" "$C_RESET" "$*"; }
ok() { printf '%s[ OK ]%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn() { printf '%s[WARN]%s %s\n' "$C_YELLOW" "$C_RESET" "$*"; }
die() { printf '%s[FAIL]%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; exit 1; }

pause() {
  printf '\n'
  read -r -p "按 Enter 返回菜单..." _
}

confirm() {
  local prompt=$1 answer
  while true; do
    if ! read -r -p "${prompt} [y/N，默认 N] " answer; then
      printf '\n' >&2
      return 1
    fi
    case "$answer" in
      [Yy]) return 0 ;;
      ""|[Nn]) return 1 ;;
      *) warn "请输入 y 或 n；直接按 Enter 默认为 n。" ;;
    esac
  done
}

require_root() {
  if [[ $EUID -eq 0 ]]; then
    return
  fi
  command -v sudo >/dev/null 2>&1 || die "需要 root 权限，但系统未安装 sudo。"
  [[ -t 0 ]] || die "非交互环境请使用 sudo suf。"
  exec sudo -- "$0" "$@"
}

load_os() {
  [[ -r /etc/os-release ]] || die "无法识别操作系统。"
  # shellcheck disable=SC1091
  source /etc/os-release
  case "${ID:-}" in
    debian|ubuntu) ;;
    *) die "当前仅支持 Debian/Ubuntu；检测到：${ID:-unknown}。" ;;
  esac
  command -v apt-get >/dev/null 2>&1 || die "未找到 apt-get。"
  command -v systemctl >/dev/null 2>&1 || die "当前系统未使用 systemd。"
}

apt_install() {
  local missing=() package
  for package in "$@"; do
    dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q 'install ok installed' || missing+=("$package")
  done

  if ((${#missing[@]} == 0)); then
    return
  fi

  info "安装软件包：${missing[*]}"
  apt-get update
  DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
}

suf_project_dir() {
  local sudo_home
  if [[ -n ${SUF_HOME:-} ]]; then
    printf '%s\n' "$SUF_HOME"
    return
  fi

  if [[ -n ${SUDO_USER:-} && $SUDO_USER != root ]]; then
    sudo_home=$(user_home "$SUDO_USER")
    if [[ -n $sudo_home ]]; then
      printf '%s/suf\n' "$sudo_home"
      return
    fi
  fi

  printf '%s/suf\n' "$HOME"
}

update_suf_project() {
  local project_dir origin
  project_dir=$(suf_project_dir)
  apt_install git

  [[ ! -L $project_dir ]] || die "${project_dir} 是符号链接，拒绝更新。"
  if [[ -d ${project_dir}/.git ]]; then
    origin=$(git -C "$project_dir" remote get-url origin 2>/dev/null || true)
    [[ $origin == "${APP_REPOSITORY}.git" ]] || die "${project_dir} 的远程仓库不是 ${APP_REPOSITORY}。"
    [[ -z $(git -C "$project_dir" status --porcelain) ]] || die "${project_dir} 存在未提交修改，请先处理后再更新。"
    info "正在从 GitHub 获取 SUF 更新..."
    git -C "$project_dir" pull --ff-only
  elif [[ -e $project_dir ]]; then
    die "${project_dir} 已存在但不是 SUF Git 仓库，拒绝覆盖。"
  else
    info "未找到本地 SUF 仓库，正在克隆..."
    git clone --depth 1 "${APP_REPOSITORY}.git" "$project_dir"
  fi

  [[ -f ${project_dir}/install.sh && -f ${project_dir}/suf ]] || die "SUF 仓库内容不完整，未执行安装。"
  bash "${project_dir}/install.sh" --no-launch
  ok "SUF 已更新。退出后重新执行 suf 即可使用新版本。"
}

find_sshd_bin() {
  if command -v sshd >/dev/null 2>&1; then
    command -v sshd
  elif [[ -x /usr/sbin/sshd ]]; then
    printf '%s\n' /usr/sbin/sshd
  else
    return 1
  fi
}

find_ssh_service() {
  if systemctl list-unit-files ssh.service --no-legend 2>/dev/null | grep -q '^ssh\.service'; then
    printf '%s\n' ssh
  elif systemctl list-unit-files sshd.service --no-legend 2>/dev/null | grep -q '^sshd\.service'; then
    printf '%s\n' sshd
  else
    return 1
  fi
}

ensure_openssh() {
  apt_install openssh-server openssh-client
  SSHD_BIN=$(find_sshd_bin) || die "未找到 sshd。"
  SSH_SERVICE=$(find_ssh_service) || die "未找到 SSH systemd 服务。"
}

effective_sshd_value() {
  local key=$1
  # Consume all sshd output: exiting awk early can make sshd receive SIGPIPE.
  "$SSHD_BIN" -T 2>/dev/null | awk -v wanted="$key" '$1 == wanted && !found { print $2; found=1 }'
}

effective_sshd_values() {
  local key=$1
  "$SSHD_BIN" -T 2>/dev/null | awk -v wanted="$key" '$1 == wanted { print $2 }'
}

current_ssh_port() {
  local port
  port=$(effective_sshd_value port || true)
  printf '%s\n' "${port:-22}"
}

valid_port() {
  [[ $1 =~ ^[0-9]+$ ]] && ((10#$1 >= 1 && 10#$1 <= 65535))
}

prompt_port() {
  local default_port=$1 label=${2:-端口} entered
  while true; do
    read -r -p "${label} [${default_port}]：" entered
    entered=${entered:-$default_port}
    if valid_port "$entered"; then
      printf '%s\n' "$((10#$entered))"
      return
    fi
    warn "端口必须是 1 到 65535 的整数。"
  done
}

prompt_protocol() {
  local protocol
  while true; do
    read -r -p "协议 tcp/udp [tcp]：" protocol
    protocol=${protocol:-tcp}
    case "$protocol" in
      tcp|udp) printf '%s\n' "$protocol"; return ;;
      *) warn "协议只能是 tcp 或 udp。" ;;
    esac
  done
}

prompt_positive_integer() {
  local prompt=$1 default_value=$2 value
  while true; do
    read -r -p "${prompt} [${default_value}]：" value
    value=${value:-$default_value}
    if [[ $value =~ ^[0-9]+$ ]] && ((10#$value > 0)); then
      printf '%s\n' "$((10#$value))"
      return
    fi
    warn "请输入大于 0 的整数。"
  done
}

prompt_duration() {
  local prompt=$1 default_value=$2 value
  while true; do
    read -r -p "${prompt} [${default_value}]：" value
    value=${value:-$default_value}
    if [[ $value =~ ^([0-9]+)([smhdw]?)$ ]] && ((10#${BASH_REMATCH[1]} > 0)); then
      printf '%s\n' "$value"
      return
    fi
    warn "时间格式无效，可使用 600、10m、1h、1d 或 1w。"
  done
}

user_home() {
  getent passwd "$1" | cut -d: -f6
}

user_has_sudo() {
  id -nG "$1" 2>/dev/null | tr ' ' '\n' | grep -qxE 'sudo|wheel'
}

ensure_admin_user() {
  local target_user=$1

  [[ $target_user =~ ^[a-z_][a-z0-9_-]*$ ]] || die "用户名格式无效。"
  if [[ $target_user == root ]]; then
    return
  fi

  if ! id "$target_user" >/dev/null 2>&1; then
    info "创建运维账号 ${target_user}。请为 sudo 设置一个强本地密码。"
    adduser "$target_user"
  fi

  if ! user_has_sudo "$target_user"; then
    usermod -aG sudo "$target_user"
    ok "已把 ${target_user} 加入 sudo 组。"
  fi
}

validate_public_key() {
  local key=$1 tmp
  [[ $key != *$'\n'* ]] || return 1
  [[ $key =~ ^(ssh-ed25519|sk-ssh-ed25519@openssh.com)[[:space:]]+[A-Za-z0-9+/=]+([[:space:]].*)?$ ]] || return 1
  tmp=$(mktemp)
  printf '%s\n' "$key" >"$tmp"
  if ! ssh-keygen -lf "$tmp" >/dev/null 2>&1; then
    rm -f "$tmp"
    return 1
  fi
  rm -f "$tmp"
}

install_public_key() {
  local target_user home ssh_dir auth_file public_key key_type key_body fingerprint

  printf '\n默认给 root 安装公钥，可直接获得完整管理权限；输入其他用户名则创建普通 sudo 管理员。\n'
  read -r -p "密钥登录用户名 [root]：" target_user
  target_user=${target_user:-root}
  ensure_admin_user "$target_user"

  home=$(user_home "$target_user")
  [[ -n $home && -d $home ]] || die "找不到 ${target_user} 的家目录。"

  printf '\n请准备登录设备上的 Ed25519 公钥；可使用已有公钥，也可在登录设备上生成新密钥对：\n'
  printf '  ssh-keygen -t ed25519 -a 100\n'
  printf '不要在服务器上生成登录密钥，私钥不要上传服务器或 GitHub。\n\n'
  read -r -p "准备好公钥后按 Enter 继续：" _
  read -r -p "粘贴 id_ed25519.pub 的完整单行内容：" public_key
  validate_public_key "$public_key" || die "公钥无效；仅接受 Ed25519 公钥。"

  ssh_dir="${home}/.ssh"
  auth_file="${ssh_dir}/authorized_keys"
  install -d -m 700 -o "$target_user" -g "$target_user" "$ssh_dir"
  touch "$auth_file"
  chown "$target_user:$target_user" "$auth_file"
  chmod 600 "$auth_file"

  read -r key_type key_body _ <<<"$public_key"
  if awk -v type="$key_type" -v body="$key_body" '
    {
      for (i = 1; i < NF; i++) {
        if ($i == type && $(i + 1) == body) {
          found = 1
        }
      }
    }
    END { exit !found }
  ' "$auth_file"; then
    warn "该公钥已存在，未重复写入。"
  else
    printf '%s\n' "$public_key" >>"$auth_file"
    ok "公钥已写入 ${auth_file}。"
  fi

  fingerprint=$(printf '%s\n' "$public_key" | ssh-keygen -lf - | awk '{print $2}')
  LAST_CONFIGURED_USER=$target_user
  printf '账号：%s\n指纹：%s\n' "$target_user" "$fingerprint"
  printf '\n请保持当前 SSH 会话不关闭，并在第二个终端测试密钥登录：\n'
  printf '  ssh -p %s %s@服务器IP\n' "$(current_ssh_port)" "$target_user"
  if [[ $target_user == root ]]; then
    printf '登录后执行 whoami，输出必须是 root。\n'
  else
    printf '登录后执行 sudo -v，确认该用户可以提权。\n'
  fi
}

backup_ssh_config() {
  local stamp backup_dir
  stamp=$(date +%Y%m%d-%H%M%S)
  backup_dir="${BACKUP_ROOT}/${stamp}"
  mkdir -p "$backup_dir"
  cp -a "$SSH_MAIN" "${backup_dir}/sshd_config"
  if [[ -e $SSH_DROPIN ]]; then
    cp -a "$SSH_DROPIN" "${backup_dir}/00-suf-hardening.conf"
  else
    : >"${backup_dir}/dropin-was-absent"
  fi
  if [[ -d $SSH_DROPIN_DIR ]]; then
    cp -a "$SSH_DROPIN_DIR" "${backup_dir}/sshd_config.d"
  else
    : >"${backup_dir}/dropin-dir-was-absent"
  fi
  printf '%s\n' "$backup_dir"
}

restore_ssh_backup() {
  local backup_dir=$1
  cp -a "${backup_dir}/sshd_config" "$SSH_MAIN"
  if [[ -e ${backup_dir}/dropin-dir-was-absent ]]; then
    rm -rf "$SSH_DROPIN_DIR"
  elif [[ -d ${backup_dir}/sshd_config.d ]]; then
    rm -rf "$SSH_DROPIN_DIR"
    cp -a "${backup_dir}/sshd_config.d" "$SSH_DROPIN_DIR"
  elif [[ -e ${backup_dir}/dropin-was-absent ]]; then
    rm -f "$SSH_DROPIN"
  else
    cp -a "${backup_dir}/00-suf-hardening.conf" "$SSH_DROPIN"
  fi
}

ssh_config_includes_dropin_dir() {
  local escaped_dir=${SSH_DROPIN_DIR//./\\.}
  # Match the distribution-provided glob, not SUF's own explicit Include block.
  grep -qE "^[[:space:]]*[Ii][Nn][Cc][Ll][Uu][Dd][Ee][[:space:]]+${escaped_dir}/\\*" "$SSH_MAIN"
}

remove_suf_managed_include() {
  local tmp
  grep -q '^# BEGIN SUF managed include$' "$SSH_MAIN" || return
  tmp=$(mktemp)
  awk '
    $0 == "# BEGIN SUF managed include" { skip = 1; next }
    $0 == "# END SUF managed include" { skip = 0; next }
    !skip { print }
  ' "$SSH_MAIN" >"$tmp"
  install -m 600 -o root -g root "$tmp" "$SSH_MAIN"
  rm -f "$tmp"
}

ensure_dropin_include_first() {
  local tmp
  # Debian/Ubuntu normally includes this directory already. Do not include SUF twice.
  if ssh_config_includes_dropin_dir; then
    remove_suf_managed_include
    return
  fi
  if head -n 4 "$SSH_MAIN" | grep -q '^# BEGIN SUF managed include$'; then
    return
  fi

  tmp=$(mktemp)
  {
    printf '%s\n' '# BEGIN SUF managed include'
    printf '%s\n' "Include ${SSH_DROPIN}"
    printf '%s\n' '# END SUF managed include'
    cat "$SSH_MAIN"
  } >"$tmp"
  install -m 600 -o root -g root "$tmp" "$SSH_MAIN"
  rm -f "$tmp"
}

active_foreign_ssh_port_directives() {
  local file
  while IFS= read -r -d '' file; do
    [[ $file == "$SSH_DROPIN" ]] && continue
    awk -v file="$file" '
      /^[[:space:]]*[Pp][Oo][Rr][Tt][[:space:]]+/ {
        printf "%s:%d:%s\\n", file, NR, $0
      }
    ' "$file"
  done < <(
    printf '%s\0' "$SSH_MAIN"
    if [[ -d $SSH_DROPIN_DIR ]]; then
      find "$SSH_DROPIN_DIR" -maxdepth 1 -type f -name '*.conf' -print0
    fi
  )
}

disable_foreign_ssh_port_directives() {
  local file
  while IFS= read -r -d '' file; do
    [[ $file == "$SSH_DROPIN" ]] && continue
    if grep -qE '^[[:space:]]*[Pp][Oo][Rr][Tt][[:space:]]+' "$file"; then
      sed -i -E 's/^[[:space:]]*([Pp][Oo][Rr][Tt][[:space:]]+)/# Disabled by SUF when setting SSH port: &/' "$file"
    fi
  done < <(
    printf '%s\0' "$SSH_MAIN"
    if [[ -d $SSH_DROPIN_DIR ]]; then
      find "$SSH_DROPIN_DIR" -maxdepth 1 -type f -name '*.conf' -print0
    fi
  )
}

authorized_key_count() {
  local target_user=$1 home auth_file
  home=$(user_home "$target_user")
  auth_file="${home}/.ssh/authorized_keys"
  [[ -r $auth_file ]] || { printf '0\n'; return; }
  awk '
    {
      for (i = 1; i < NF; i++) {
        if ($i ~ /^(ssh-ed25519|sk-ssh-ed25519@openssh.com)$/ && $(i + 1) != "") {
          count++
          break
        }
      }
    }
    END { print count+0 }
  ' "$auth_file"
}

require_tested_key_login() {
  local target_user=$1 count
  id "$target_user" >/dev/null 2>&1 || die "账号 ${target_user} 不存在。"
  if [[ $target_user != root ]]; then
    user_has_sudo "$target_user" || die "账号 ${target_user} 没有 sudo 权限。"
  fi
  count=$(authorized_key_count "$target_user")
  ((count > 0)) || die "账号 ${target_user} 没有有效的 Ed25519 authorized_keys。"

  if [[ $target_user == root ]]; then
    warn "只有在第二个终端已用 root 密钥登录，并确认 whoami 输出 root 后才能继续。"
  else
    warn "只有在第二个终端已用 ${target_user} 的密钥登录并成功执行 sudo -v 后才能继续。"
  fi
  confirm "确认已完成上述测试吗？" || die "未确认测试，取消 SSH 加固。"
}

write_sshd_hardening() {
  local port=$1 target_user=$2 backup_dir effective permit_root effective_root
  if [[ $target_user == root ]]; then
    permit_root='prohibit-password'
  else
    permit_root='no'
  fi
  backup_dir=$(backup_ssh_config)
  mkdir -p "$SSH_DROPIN_DIR"

  ensure_dropin_include_first
  cat >"$SSH_DROPIN" <<EOF
# Managed by SUF ${APP_VERSION}
Port ${port}
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
ChallengeResponseAuthentication no
PermitEmptyPasswords no
AuthenticationMethods publickey
PermitRootLogin ${permit_root}
MaxAuthTries 3
LoginGraceTime 30
EOF
  chmod 600 "$SSH_DROPIN"
  chown root:root "$SSH_DROPIN"

  if ! "$SSHD_BIN" -t; then
    warn "sshd 配置校验失败，正在自动恢复。"
    restore_ssh_backup "$backup_dir"
    "$SSHD_BIN" -t || die "旧配置恢复后仍无法通过校验，请保持当前会话并人工检查 ${SSH_MAIN}。"
    die "没有应用任何 SSH 变更。"
  fi

  effective=$("$SSHD_BIN" -T -C "user=root,host=$(hostname),addr=127.0.0.1")
  for expected in \
    "port ${port}" \
    "pubkeyauthentication yes" \
    "passwordauthentication no" \
    "kbdinteractiveauthentication no" \
    "authenticationmethods publickey"; do
    if ! grep -qx "$expected" <<<"$effective"; then
      warn "最终 SSH 配置未生效：${expected}，正在自动恢复。"
      restore_ssh_backup "$backup_dir"
      "$SSHD_BIN" -t || die "恢复后的旧配置无法通过校验。"
      die "没有应用任何 SSH 变更。"
    fi
  done

  effective_root=$(awk '$1 == "permitrootlogin" {print $2; exit}' <<<"$effective")
  if [[ $target_user == root ]]; then
    if [[ $effective_root != prohibit-password && $effective_root != without-password ]]; then
      warn "Root 密钥登录策略未生效，正在自动恢复。"
      restore_ssh_backup "$backup_dir"
      "$SSHD_BIN" -t || die "恢复后的旧配置无法通过校验。"
      die "没有应用任何 SSH 变更。"
    fi
  elif [[ $effective_root != no ]]; then
    warn "禁止 Root 登录的策略未生效，正在自动恢复。"
    restore_ssh_backup "$backup_dir"
    "$SSHD_BIN" -t || die "恢复后的旧配置无法通过校验。"
    die "没有应用任何 SSH 变更。"
  fi

  if ! systemctl reload "$SSH_SERVICE"; then
    warn "SSH 配置重新加载失败，正在自动恢复。"
    restore_ssh_backup "$backup_dir"
    "$SSHD_BIN" -t && systemctl reload "$SSH_SERVICE" || die "自动恢复失败；不要关闭当前 SSH 会话。"
    die "SSH 变更已撤销。"
  fi

  if [[ $target_user == root ]]; then
    ok "SSH 已设置为 root 仅密钥登录，所有密码认证均已禁止。"
  else
    ok "SSH 已设置为 ${target_user} 仅密钥登录，Root 登录和所有密码认证均已禁止。"
  fi
  info "原 SSH 配置备份位于 ${backup_dir}。"
  printf '\n不要关闭当前会话。请立即在第三个终端测试：\n'
  printf '  ssh -p %s %s@服务器IP\n' "$port" "$target_user"
}

enable_key_only_login() {
  local current_port target_user
  ensure_openssh
  current_port=$(current_ssh_port)
  read -r -p "已验证密钥登录的用户名 [root]：" target_user
  target_user=${target_user:-root}
  require_tested_key_login "$target_user"

  warn "应用后将禁止所有 SSH 密码和键盘交互认证，只保留公钥登录。"
  write_sshd_hardening "$current_port" "$target_user"
}

write_sshd_port() {
  local port=$1 backup_dir effective_ports tmp
  backup_dir=$(backup_ssh_config)
  mkdir -p "$SSH_DROPIN_DIR"
  ensure_dropin_include_first

  tmp=$(mktemp)
  if [[ -e $SSH_DROPIN ]]; then
    awk -v port="$port" '
      tolower($1) == "port" {
        if (!written++) print "Port " port
        next
      }
      { print }
      END {
        if (!written) print "Port " port
      }
    ' "$SSH_DROPIN" >"$tmp"
  else
    printf '# Managed by SUF %s\nPort %s\n' "$APP_VERSION" "$port" >"$tmp"
  fi
  install -m 600 -o root -g root "$tmp" "$SSH_DROPIN"
  rm -f "$tmp"

  if ! disable_foreign_ssh_port_directives; then
    warn "无法禁用其它 SSH Port 配置，正在自动恢复。"
    restore_ssh_backup "$backup_dir"
    die "没有应用任何 SSH 端口变更。"
  fi

  if ! "$SSHD_BIN" -t; then
    warn "sshd 配置校验失败，正在自动恢复。"
    restore_ssh_backup "$backup_dir"
    "$SSHD_BIN" -t || die "旧配置恢复后仍无法通过校验，请保持当前会话并人工检查 ${SSH_MAIN}。"
    die "没有应用任何 SSH 变更。"
  fi

  effective_ports=$(effective_sshd_values port)
  if [[ $effective_ports != "$port" ]]; then
    warn "最终 SSH 端口未收敛为 TCP/${port}，当前生效端口：${effective_ports//$'\n'/, }。正在自动恢复。"
    restore_ssh_backup "$backup_dir"
    "$SSHD_BIN" -t || die "恢复后的旧配置无法通过校验。"
    die "没有应用任何 SSH 变更。"
  fi

  if ! systemctl reload "$SSH_SERVICE"; then
    warn "SSH 配置重新加载失败，正在自动恢复。"
    restore_ssh_backup "$backup_dir"
    "$SSHD_BIN" -t && systemctl reload "$SSH_SERVICE" || die "自动恢复失败；不要关闭当前 SSH 会话。"
    die "SSH 端口变更已撤销。"
  fi

  ok "SSH 端口已修改为 ${port}，认证策略未做改变。"
  info "原 SSH 配置备份位于 ${backup_dir}。"
  warn "不要关闭当前会话。请在新终端测试：ssh -p ${port} 用户名@服务器IP"
}

change_ssh_port() {
  local current_port target_port active_ports foreign_directives
  ensure_openssh
  current_port=$(current_ssh_port)
  target_port=$(prompt_port "$DEFAULT_SSH_PORT" "新的 SSH 端口")
  active_ports=$(effective_sshd_values port)
  foreign_directives=$(active_foreign_ssh_port_directives)
  [[ $target_port != "$current_port" || $active_ports != "$target_port" ]] || {
    info "目标端口与当前端口相同，未做修改。"
    return
  }

  warn "请先确认云厂商安全组已放行 TCP/${target_port}。"
  confirm "已经放行或服务器没有外部安全组吗？" || die "取消操作。"

  if [[ -n $foreign_directives ]]; then
    warn "检测到以下额外的 SSH Port 配置："
    printf '%s\n' "$foreign_directives"
    warn "继续后将注释以上配置，仅保留 TCP/${target_port}。"
    confirm "确认仅保留新的 SSH 端口吗？" || die "取消操作。"
  fi

  if command -v ufw >/dev/null 2>&1; then
    ufw allow "${target_port}/tcp" comment 'SUF SSH 管理' >/dev/null
    ok "UFW 已放行 TCP/${target_port}。"
  else
    warn "尚未安装 UFW。建议先从菜单安装 UFW，再修改 SSH。"
    confirm "仍要继续吗？" || die "取消操作。"
  fi

  write_sshd_port "$target_port"
}

allow_extra_ufw_ports() {
  local input entry port proto
  printf '\n额外端口格式示例：8443/tcp,51820/udp。留空表示不添加。\n'
  read -r -p "需要额外放行的端口：" input
  [[ -n $input ]] || return

  IFS=',' read -r -a entries <<<"$input"
  for entry in "${entries[@]}"; do
    entry=${entry//[[:space:]]/}
    if [[ $entry =~ ^([0-9]+)/(tcp|udp)$ ]]; then
      port=${BASH_REMATCH[1]}
      proto=${BASH_REMATCH[2]}
      if valid_port "$port"; then
        ufw allow "$((10#$port))/${proto}" comment '额外服务'
        continue
      fi
    fi
    die "无效端口规则：${entry}。应使用 端口/tcp 或 端口/udp。"
  done
}

configure_ufw() {
  local current_port ssh_port
  apt_install ufw
  ensure_openssh
  current_port=$(current_ssh_port)
  ssh_port=$(prompt_port "$current_port" "SSH 端口")

  warn "请确保云安全组同时放行 TCP/${ssh_port}。"
  confirm "确认继续配置 UFW 吗？" || die "取消操作。"

  ufw default deny incoming
  ufw default allow outgoing
  ufw allow "${ssh_port}/tcp" comment 'SUF SSH 管理'
  if [[ $current_port != "$ssh_port" ]]; then
    ufw allow "${current_port}/tcp" comment '当前 SSH 临时端口'
  fi

  if confirm "这台服务器需要对公网提供 HTTP/HTTPS 吗？"; then
    ufw allow 80/tcp comment '网页 HTTP'
    ufw allow 443/tcp comment '加密网页 HTTPS'
  fi
  allow_extra_ufw_ports

  warn "启用后，未明确放行的入站端口将被阻止。"
  ufw show added || true
  confirm "确认以上规则完整，可以启用 UFW 吗？" || die "UFW 尚未启用。"
  ufw --force enable
  ok "UFW 已启用。当前和目标 SSH 端口均已放行，旧规则不会被脚本自动删除。"
  show_ufw_status
}

require_ufw() {
  command -v ufw >/dev/null 2>&1 || die "UFW 尚未安装，请先选择安装。"
}

install_ufw_service() {
  apt_install ufw
  ok "UFW 已安装。安装不会自动启用防火墙。"
}

translate_ufw_output() {
  local line
  while IFS= read -r line || [[ -n $line ]]; do
    case "$line" in
      'Status: active') printf '状态：已启用\n'; continue ;;
      'Status: inactive') printf '状态：未启用\n'; continue ;;
      To*Action*From) printf '目标                         操作          来源\n'; continue ;;
    esac

    line=${line//Default: /默认策略：}
    line=${line//Logging: /日志记录：}
    line=${line//deny \(incoming\)/拒绝（入站）}
    line=${line//allow \(incoming\)/允许（入站）}
    line=${line//allow \(outgoing\)/允许（出站）}
    line=${line//deny \(outgoing\)/拒绝（出站）}
    line=${line//disabled \(routed\)/禁用（转发）}
    line=${line//allow \(routed\)/允许（转发）}
    line=${line//deny \(routed\)/拒绝（转发）}
    line=${line//Anywhere \(v6\)/任意来源（IPv6）}
    line=${line//Anywhere/任意来源}
    line=${line//ALLOW IN/允许入站}
    line=${line//DENY IN/拒绝入站}
    line=${line//REJECT IN/拒绝并通知入站}
    line=${line//LIMIT IN/限制入站连接}
    line=${line//ALLOW OUT/允许出站}
    line=${line//DENY OUT/拒绝出站}
    line=${line//on \(low\)/开启（低）}
    line=${line//on \(medium\)/开启（中）}
    line=${line//on \(high\)/开启（高）}
    line=${line//off/关闭}
    printf '%s\n' "$line"
  done
}

show_ufw_status() {
  if command -v ufw >/dev/null 2>&1; then
    printf 'UFW 防火墙状态\n'
    ufw status verbose | translate_ufw_output
  else
    printf 'UFW：未安装\n'
  fi
}

show_ufw_rules() {
  require_ufw
  printf 'UFW 规则（按编号）\n'
  ufw status numbered | translate_ufw_output
  printf '\n待应用的底层 UFW 规则命令：\n'
  ufw show added || true
}

show_ufw_allowed_ports() {
  local found=0 line rule
  require_ufw

  printf 'UFW 已保存的放行/限速端口\n'
  if ! ufw_is_active; then
    warn "UFW 当前未启用；以下规则将在启用后生效。"
  fi

  while IFS= read -r line; do
    case "$line" in
      'ufw allow '*)
        rule=${line#ufw allow }
        rule=${rule// from /，来源 }
        rule=${rule// to any port /，目标端口 }
        rule=${rule// proto /，协议 }
        rule=${rule// comment /，备注 }
        printf '  放行：%s\n' "$rule"
        found=1
        ;;
      'ufw limit '*)
        rule=${line#ufw limit }
        rule=${rule// comment /，备注 }
        printf '  限速：%s\n' "$rule"
        found=1
        ;;
    esac
  done < <(ufw show added 2>/dev/null || true)

  ((found)) || printf '  没有保存的放行或连接限速规则。\n'
}

public_listening_candidates() {
  ss -H -lntu 2>/dev/null | awk '
    $1 ~ /^(tcp|udp)$/ {
      local_address = $5
      port = local_address
      sub(/^.*:/, "", port)
      host = local_address
      sub(/:[^:]*$/, "", host)
      gsub(/^\[/, "", host)
      gsub(/\]$/, "", host)
      if (host !~ /^127\./ && host != "::1") {
        printf "%s %s %s\n", $1, port, host
      }
    }
  ' | sort -u
}

is_public_listening_port() {
  local port=$1 protocol=$2
  public_listening_candidates | awk -v wanted_port="$port" -v wanted_protocol="$protocol" '
    $1 == wanted_protocol && $2 == wanted_port { found = 1 }
    END { exit !found }
  '
}

show_listening_ports() {
  local candidates port protocol
  printf '以下是实际监听端口，不代表已被 UFW 放行：\n\n'
  if command -v ss >/dev/null 2>&1; then
    candidates=$(public_listening_candidates || true)
    if [[ -n $candidates ]]; then
      printf '可考虑对公网放行的监听端口（协议 / 端口 / 绑定地址）：\n'
      awk '{ printf "  %-4s %-7s %s\n", $1, $2, $3 }' <<<"$candidates"
      printf '\n'
    else
      printf '没有检测到对公网或指定网卡监听的端口。\n\n'
    fi

    printf '完整监听详情：\n'
    ss -lntup
  else
    die "未找到 ss，请安装 iproute2。"
  fi

  command -v ufw >/dev/null 2>&1 || {
    info "安装 UFW 后，可从此处选择监听端口加入放行规则。"
    return
  }
  [[ -n $candidates ]] || return
  confirm "要从上述公网监听端口中选择一个加入 UFW 放行规则吗？" || return

  read -r -p "输入要放行的端口号：" port
  valid_port "$port" || die "端口必须是 1 到 65535 的整数。"
  port=$((10#$port))
  protocol=$(prompt_protocol)

  is_public_listening_port "$port" "$protocol" || die "未检测到 ${port}/${protocol} 的公网监听；仅本机监听的服务不能通过此菜单开放。"
  if ufw show added | grep -Eq "^ufw (allow|limit) ${port}/${protocol}([[:space:]]|$)"; then
    warn "已存在 ${port}/${protocol} 的广泛放行或限速规则，未重复添加。"
  else
    ufw allow "${port}/${protocol}" comment '从监听服务放行'
    ok "已将正在监听的 ${port}/${protocol} 加入 UFW 放行规则。"
  fi
  printf '\n'
  show_ufw_allowed_ports
}

ufw_allow_port() {
  local port protocol
  require_ufw
  port=$(prompt_port 443 "要放行的端口")
  protocol=$(prompt_protocol)
  ufw allow "${port}/${protocol}" comment '受 SUF 管理的服务'
  ok "已放行 ${port}/${protocol}。"
}

remove_broad_ufw_allows() {
  local port=$1 protocol=$2 action rule_spec attempts
  local -a broad_actions=(allow limit)
  local -a broad_specs=("${port}/${protocol}" "${port}")

  if ! ufw show added | grep -Eq "^ufw (allow|limit) (${port}/${protocol}|${port})([[:space:]]|$)"; then
    return
  fi

  warn "检测到 ${port}/${protocol} 仍有对所有来源开放的规则。"
  ufw show added || true
  confirm "删除这些广泛放行规则，使 IP 限制真正生效吗？" || die "已保留广泛规则，因此不能称为仅允许指定 IP。"

  for action in "${broad_actions[@]}"; do
    for rule_spec in "${broad_specs[@]}"; do
      attempts=0
      while ufw show added | grep -Eq "^ufw ${action} ${rule_spec}([[:space:]]|$)"; do
        ((attempts += 1))
        ((attempts <= 20)) || die "广泛放行规则过多，请通过编号规则菜单人工处理。"
        ufw --force delete "$action" "$rule_spec"
      done
    done
  done

  if ufw show added | grep -Eq "^ufw (allow|limit) (${port}/${protocol}|${port})([[:space:]]|$)"; then
    die "仍检测到广泛放行规则，请通过编号规则菜单人工删除。"
  fi
}

docker_user_chain_exists() {
  local firewall=$1 family
  if command -v "$firewall" >/dev/null 2>&1 && "$firewall" -nL DOCKER-USER >/dev/null 2>&1; then
    return 0
  fi
  command -v nft >/dev/null 2>&1 || return 1
  [[ $firewall == ip6tables ]] && family=ip6 || family=ip
  nft list chain "$family" filter DOCKER-USER >/dev/null 2>&1
}

docker_uses_nft_backend() {
  local firewall=$1
  command -v nft >/dev/null 2>&1 || return 1
  "$firewall" -V 2>/dev/null | grep -q 'nf_tables'
}

apply_docker_nft_family_drop() {
  local family=$1 port=$2 protocol=$3 drop_comment=$4
  # If Docker has IPv4/IPv6 disabled, there may be no corresponding chain.
  nft list chain "$family" filter DOCKER-USER >/dev/null 2>&1 || return 0
  if ! nft list chain "$family" filter DOCKER-USER 2>/dev/null | grep -Fq "comment \"${drop_comment}\""; then
    nft insert rule "$family" filter DOCKER-USER meta l4proto "$protocol" ct original proto-dst "$port" counter drop comment "$drop_comment"
  fi
}

apply_docker_source_restriction_nft() {
  local source=$1 port=$2 protocol=$3 family opposite address_expr allow_comment drop_comment
  [[ $source == *:* ]] && family=ip6 || family=ip
  [[ $family == ip6 ]] && opposite=ip || opposite=ip6
  nft list chain "$family" filter DOCKER-USER >/dev/null 2>&1 || return 2

  if [[ $family == ip6 ]]; then
    address_expr=(ip6 saddr "$source")
  else
    address_expr=(ip saddr "$source")
  fi
  allow_comment="SUF-DOCKER-ALLOW-${source}-${port}-${protocol}"
  drop_comment="SUF-DOCKER-DROP-${port}-${protocol}"

  # Native nft rules are required when iptables-nft reports a chain as
  # incompatible.  Insert the drop first, then put each whitelist entry in
  # front of it so repeated calls remain additive.
  if ! nft list chain "$family" filter DOCKER-USER 2>/dev/null | grep -Fq "comment \"${drop_comment}\""; then
    nft insert rule "$family" filter DOCKER-USER meta l4proto "$protocol" ct original proto-dst "$port" counter drop comment "$drop_comment"
  fi
  if ! nft list chain "$family" filter DOCKER-USER 2>/dev/null | grep -Fq "comment \"${allow_comment}\""; then
    nft insert rule "$family" filter DOCKER-USER "${address_expr[@]}" meta l4proto "$protocol" ct original proto-dst "$port" counter accept comment "$allow_comment"
  fi

  # A whitelist for one address family must not leave the other published
  # family open.  A later whitelist call for that family is inserted before
  # this drop rule, so IPv4 and IPv6 sources can still be configured separately.
  apply_docker_nft_family_drop "$opposite" "$port" "$protocol" "SUF-DOCKER-DROP-${port}-${protocol}-${opposite}"
}

apply_docker_source_restriction() {
  local source=$1 port=$2 protocol=$3 firewall allow_rule drop_rule

  # Docker publishes ports through FORWARD/DOCKER, so UFW INPUT rules do not
  # reliably see that traffic.  DOCKER-USER is evaluated before Docker's own
  # accept rules; --ctorigdstport matches the host port before DNAT.
  if [[ $source == *:* ]]; then
    firewall=ip6tables
  else
    firewall=iptables
  fi

  docker_user_chain_exists "$firewall" || return 2

  if docker_uses_nft_backend "$firewall"; then
    apply_docker_source_restriction_nft "$source" "$port" "$protocol"
    return
  fi

  "$firewall" -N SUF-DOCKER 2>/dev/null || true
  if ! "$firewall" -C DOCKER-USER -j SUF-DOCKER >/dev/null 2>&1; then
    "$firewall" -I DOCKER-USER 1 -j SUF-DOCKER
  fi

  allow_rule=(-s "$source" -p "$protocol" -m conntrack --ctorigdstport "$port" -m comment --comment SUF-DOCKER-ALLOW -j ACCEPT)
  drop_rule=(-p "$protocol" -m conntrack --ctorigdstport "$port" -m comment --comment SUF-DOCKER-DROP -j DROP)

  if ! "$firewall" -C SUF-DOCKER "${drop_rule[@]}" >/dev/null 2>&1; then
    "$firewall" -A SUF-DOCKER "${drop_rule[@]}"
  fi
  if ! "$firewall" -C SUF-DOCKER "${allow_rule[@]}" >/dev/null 2>&1; then
    # Put every allow before the chain's final drop so multiple whitelist
    # entries remain additive instead of blocking an earlier source.
    "$firewall" -I SUF-DOCKER 1 "${allow_rule[@]}"
  fi
}

ufw_allow_source_to_port() {
  local source port protocol firewall
  require_ufw
  read -r -p "允许的来源 IP 或 CIDR：" source
  [[ $source =~ ^[0-9A-Fa-f:./]+$ ]] || die "IP/CIDR 包含无效字符。"
  port=$(prompt_port 22 "要限制来源的端口")
  protocol=$(prompt_protocol)

  # UFW performs the final IPv4/IPv6 and CIDR validation.
  ufw allow from "$source" to any port "$port" proto "$protocol" comment '仅限指定来源'
  remove_broad_ufw_allows "$port" "$protocol"

  if [[ $source == *:* ]]; then
    firewall=ip6tables
  else
    firewall=iptables
  fi
  if docker_user_chain_exists "$firewall"; then
    if ! apply_docker_source_restriction "$source" "$port" "$protocol"; then
      die "UFW 规则已添加，但 Docker-USER 规则写入失败；Docker 端口仍可能绕过来源限制。请检查 ${firewall} conntrack 支持后重试。"
    fi
    warn "已同步限制 Docker 发布端口：${firewall} DOCKER-USER（按原始目标端口匹配）。"
  elif command -v docker >/dev/null 2>&1; then
    die "检测到 Docker，但 ${firewall} 的 DOCKER-USER 链不可用；UFW 规则不能限制 Docker 转发流量。请启动 Docker 后重试。"
  fi
  ok "已限制为 ${source} 可访问 ${port}/${protocol}。"
}

ufw_limit_port() {
  local default_port port
  require_ufw
  ensure_openssh
  default_port=$(current_ssh_port)
  port=$(prompt_port "$default_port" "要限制新连接的 TCP 端口")
  ufw limit "${port}/tcp" comment '连接限速服务'
  ok "已为 ${port}/tcp 添加连接限速规则。UFW limit 仅用于 TCP 连接。"
}

ufw_delete_numbered_rule() {
  local number
  require_ufw
  show_ufw_rules
  read -r -p "要删除的规则编号：" number
  [[ $number =~ ^[0-9]+$ ]] && ((10#$number > 0)) || die "规则编号无效。"
  warn "删除后其他规则编号会变化。"
  confirm "确认删除规则 ${number} 吗？" || die "取消删除。"
  ufw --force delete "$((10#$number))"
  show_ufw_rules
}

ufw_delete_port_rules() {
  local port protocol index
  local -a numbers=()
  require_ufw

  printf '请选择要删除的已放行或限速端口：\n'
  show_ufw_allowed_ports
  printf '\n'
  port=$(prompt_port 443 "要删除规则的端口")
  protocol=$(prompt_protocol)

  # A single UFW rule normally creates adjacent IPv4 and IPv6 entries.  Capture
  # their current numbers first, then delete in reverse so renumbering is harmless.
  mapfile -t numbers < <(
    ufw status numbered | sed -nE "s/^\\[[[:space:]]*([0-9]+)\\][[:space:]]+${port}\\/${protocol}( \\(v6\\))?([[:space:]].*)?$/\\1/p"
  )
  ((${#numbers[@]} > 0)) || die "未找到 ${port}/${protocol} 的 UFW 规则。"

  printf '将删除 %s/%s 的以下规则编号：%s\n' "$port" "$protocol" "${numbers[*]}"
  warn "这会同时删除匹配的 IPv4 和 IPv6 规则；删除后其他规则编号会变化。"
  confirm "确认删除这些规则吗？请输入 y 执行删除" || die "取消删除。"

  for ((index = ${#numbers[@]} - 1; index >= 0; index--)); do
    ufw --force delete "${numbers[index]}"
  done
  ok "已删除 ${port}/${protocol} 的 ${#numbers[@]} 条规则。"
  show_ufw_rules
}

ufw_is_active() {
  command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q '^Status: active$'
}

enable_ufw_service() {
  local ssh_port source_ip
  require_ufw
  if ufw_is_active; then
    ok "UFW 已经处于启用状态。"
    return
  fi

  ensure_openssh
  ssh_port=$(current_ssh_port)
  source_ip=${SSH_CONNECTION:-}
  source_ip=${source_ip%% *}

  if [[ -n ${SSH_CONNECTION:-} && $source_ip =~ ^[0-9A-Fa-f:.]+$ ]]; then
    info "为当前 SSH 来源 ${source_ip} 保留 TCP/${ssh_port} 访问权限。"
    ufw insert 1 allow from "$source_ip" to any port "$ssh_port" proto tcp comment '当前 SSH 客户端'
  else
    warn "未检测到当前 SSH 来源，将放行所有来源访问 TCP/${ssh_port}。"
    confirm "确认按此方式保护当前管理入口吗？" || die "取消启用。"
    ufw insert 1 allow "${ssh_port}/tcp" comment 'SSH 管理入口'
  fi

  warn "UFW 启用后，未明确放行的入站端口将被阻止。"
  warn "云安全组不受 UFW 控制；Docker 发布端口也需要单独审核。"
  ufw show added || true
  confirm "确认以上规则完整，可以启用 UFW 吗？" || die "未启用 UFW。"
  ufw --force enable
  show_ufw_status
}

reload_ufw_service() {
  require_ufw
  ufw reload
  ok "UFW 规则已重新加载。"
}

disable_ufw_service() {
  require_ufw
  warn "关闭 UFW 会让监听端口失去这层防火墙保护。"
  confirm "确认关闭 UFW 吗？" || die "取消关闭。"
  ufw --force disable
  ok "UFW 已关闭。"
}

uninstall_ufw_service() {
  require_ufw
  warn "将关闭 UFW 并移除软件包，但保留 /etc/ufw 配置文件。"
  confirm "确认卸载 UFW 并保留配置吗？" || die "取消卸载。"
  ufw --force disable || true
  DEBIAN_FRONTEND=noninteractive apt-get remove -y ufw
  ok "UFW 软件包已移除，配置文件仍保留。"
}

backup_fail2ban_jail() {
  local jail_file=$1 backup_file
  [[ -e $jail_file ]] || return 0
  mkdir -p "${BACKUP_ROOT}/fail2ban"
  backup_file="${BACKUP_ROOT}/fail2ban/suf.$(date +%Y%m%d-%H%M%S).local"
  cp -a "$jail_file" "$backup_file"
  printf '%s\n' "$backup_file"
}

restore_fail2ban_jail() {
  local jail_file=$1 backup_file=$2
  if [[ -n $backup_file ]]; then
    cp -a "$backup_file" "$jail_file"
  else
    rm -f "$jail_file"
  fi
}

configure_fail2ban_sshd() {
  local ssh_port=$1 maxretry=$2 findtime=$3 bantime=$4
  local jail_file=$FAIL2BAN_JAIL_FILE backup_file
  mkdir -p "$FAIL2BAN_JAIL_DIR"
  backup_file=$(backup_fail2ban_jail "$jail_file")

  cat >"$jail_file" <<EOF
[sshd]
enabled = true
port = ${ssh_port}
backend = systemd
maxretry = ${maxretry}
findtime = ${findtime}
bantime = ${bantime}
bantime.increment = true
bantime.factor = 2
EOF
  chmod 600 "$jail_file"
  chown root:root "$jail_file"

  if ! fail2ban-client -t; then
    restore_fail2ban_jail "$jail_file" "$backup_file"
    die "Fail2ban 配置校验失败，已恢复原配置。"
  fi
  systemctl enable fail2ban
  systemctl reset-failed fail2ban || true
  if ! systemctl restart fail2ban; then
    restore_fail2ban_jail "$jail_file" "$backup_file"
    fail2ban-client -t && systemctl restart fail2ban || true
    show_fail2ban_start_diagnostics
    die "Fail2ban SSH 防护规则未启用，已恢复原配置。"
  fi

  sleep 1
  if ! systemctl is-active --quiet fail2ban; then
    restore_fail2ban_jail "$jail_file" "$backup_file"
    fail2ban-client -t && systemctl restart fail2ban || true
    show_fail2ban_start_diagnostics
    die "Fail2ban 启动后退出，已恢复原配置。"
  fi

  ok "Fail2ban SSH 防护已启用。"
}

configure_fail2ban() {
  local ssh_port maxretry findtime bantime
  apt_install fail2ban python3-systemd
  ensure_openssh
  ssh_port=$(current_ssh_port)
  info "已检测到当前 SSH 端口：${ssh_port}，Fail2ban 将保护此端口。"
  maxretry=$(prompt_positive_integer "最大失败次数" 5)
  findtime=$(prompt_duration "统计时间窗口" 10m)
  bantime=$(prompt_duration "首次封禁时间" 1h)

  configure_fail2ban_sshd "$ssh_port" "$maxretry" "$findtime" "$bantime"
  show_fail2ban_sshd_status
}

require_fail2ban() {
  command -v fail2ban-client >/dev/null 2>&1 || die "Fail2ban 尚未安装，请先选择安装。"
}

show_fail2ban_start_diagnostics() {
  warn "Fail2ban 未能保持运行，以下是 systemd 诊断信息："
  systemctl status fail2ban --no-pager -l || true
  printf '\n最近的 Fail2ban 日志：\n'
  journalctl -u fail2ban -b -n 80 --no-pager || true
}

ensure_fail2ban_running() {
  # Fail2ban may report active briefly before a jail initialization failure exits.
  sleep 1
  if ! systemctl is-active --quiet fail2ban; then
    show_fail2ban_start_diagnostics
    die "Fail2ban 启动失败；请根据以上日志修复后再重试。"
  fi
}

install_fail2ban_service() {
  apt_install fail2ban python3-systemd
  ensure_fail2ban_systemd_backend
  if ! fail2ban-client -t; then
    show_fail2ban_start_diagnostics
    die "Fail2ban 配置校验失败，服务尚未启动；请先修复上面的配置错误。"
  fi
  systemctl enable fail2ban
  systemctl reset-failed fail2ban || true
  if ! systemctl start fail2ban; then
    show_fail2ban_start_diagnostics
    die "Fail2ban 启动失败，未显示为已启用。"
  fi
  ensure_fail2ban_running
  ok "Fail2ban 已安装并启动。下一步请配置 SSH 防护规则。"
}

ensure_fail2ban_systemd_backend() {
  mkdir -p "$FAIL2BAN_JAIL_DIR"

  # Debian may enable the sshd jail by default while still expecting
  # /var/log/auth.log. Override only the backend so journald-only systems work.
  if [[ -e $FAIL2BAN_JAIL_FILE ]]; then
    return
  fi

  cat >"$FAIL2BAN_JAIL_FILE" <<'EOF'
# Managed by SUF: use journald when /var/log/auth.log is unavailable.
[sshd]
backend = systemd
EOF
  chmod 600 "$FAIL2BAN_JAIL_FILE"
  chown root:root "$FAIL2BAN_JAIL_FILE"
}

fail2ban_status_value() {
  local status=$1 label=$2
  awk -v label="$label" '
    index($0, label ":") {
      value = substr($0, index($0, label ":") + length(label) + 1)
      sub(/^[[:space:]]+/, "", value)
      print value
      exit
    }
  ' <<<"$status"
}

show_fail2ban_sshd_status() {
  local status current_failed total_failed current_banned total_banned banned_ips
  if ! status=$(fail2ban-client status sshd 2>/dev/null); then
    printf 'SSH 防护规则：尚未启用。\n'
    return
  fi

  current_failed=$(fail2ban_status_value "$status" 'Currently failed')
  total_failed=$(fail2ban_status_value "$status" 'Total failed')
  current_banned=$(fail2ban_status_value "$status" 'Currently banned')
  total_banned=$(fail2ban_status_value "$status" 'Total banned')
  banned_ips=$(fail2ban_status_value "$status" 'Banned IP list')

  printf 'SSH 防护规则（sshd）\n'
  printf '  当前失败次数：%s\n' "${current_failed:-0}"
  printf '  累计失败次数：%s\n' "${total_failed:-0}"
  printf '  当前封禁数量：%s\n' "${current_banned:-0}"
  printf '  累计封禁数量：%s\n' "${total_banned:-0}"
  printf '  已封禁 IP：%s\n' "${banned_ips:-无}"
  printf '  日志来源：systemd SSH 日志\n'
}

show_fail2ban_status() {
  local state status jail_list
  if ! command -v fail2ban-client >/dev/null 2>&1; then
    printf 'Fail2ban：未安装\n'
    return
  fi

  state=$(systemctl is-active fail2ban 2>/dev/null || true)
  case "$state" in
    active) printf '服务状态：运行中\n' ;;
    inactive) printf '服务状态：已停止\n' ;;
    failed) printf '服务状态：启动失败\n' ;;
    *) printf '服务状态：%s\n' "${state:-未知}" ;;
  esac

  if [[ $state != active ]] || ! status=$(fail2ban-client status 2>/dev/null); then
    printf '防护规则：服务未运行，无法读取。\n'
    return
  fi
  jail_list=$(fail2ban_status_value "$status" 'Jail list')
  printf '已启用防护规则：%s\n\n' "${jail_list:-无}"
  show_fail2ban_sshd_status
}

reload_fail2ban_service() {
  require_fail2ban
  fail2ban-client -t
  if systemctl is-active --quiet fail2ban; then
    fail2ban-client reload
  else
    systemctl enable fail2ban
    systemctl reset-failed fail2ban || true
    if ! systemctl start fail2ban; then
      show_fail2ban_start_diagnostics
      die "Fail2ban 启动失败，未重新加载配置。"
    fi
  fi
  ensure_fail2ban_running
  ok "Fail2ban 配置已重新加载。"
}

unban_fail2ban_ip() {
  local address
  require_fail2ban
  read -r -p "要解封的 IPv4/IPv6 地址：" address
  [[ $address =~ ^[0-9A-Fa-f:.]+$ ]] || die "IP 地址格式无效。"
  fail2ban-client set sshd unbanip "$address"
  ok "已提交解封：${address}。"
}

stop_fail2ban_service() {
  require_fail2ban
  warn "停止 Fail2ban 后将不再自动封禁新的攻击来源。"
  confirm "确认停止 Fail2ban 吗？" || die "取消停止。"
  systemctl disable --now fail2ban
  ok "Fail2ban 已停止并取消开机启动。"
}

uninstall_fail2ban_service() {
  require_fail2ban
  warn "将停止 Fail2ban 并移除软件包，但保留 /etc/fail2ban 配置。"
  confirm "确认卸载 Fail2ban 并保留配置吗？" || die "取消卸载。"
  systemctl disable --now fail2ban || true
  DEBIAN_FRONTEND=noninteractive apt-get remove -y fail2ban
  ok "Fail2ban 软件包已移除，配置文件仍保留。"
}

restore_latest_ssh_backup() {
  local backup_dir
  ensure_openssh
  [[ -d $BACKUP_ROOT ]] || die "没有找到 SSH 配置备份。"
  backup_dir=$(find "$BACKUP_ROOT" -mindepth 2 -maxdepth 2 -type f -name sshd_config -printf '%h\n' 2>/dev/null | sort | tail -n 1)
  [[ -n $backup_dir ]] || die "没有找到 SSH 配置备份。"
  warn "将恢复最新备份：${backup_dir}"
  confirm "确认恢复吗？" || die "取消操作。"
  restore_ssh_backup "$backup_dir"
  "$SSHD_BIN" -t || die "备份配置校验失败，未重新加载 SSH。"
  systemctl reload "$SSH_SERVICE"
  ok "已恢复 ${backup_dir}。请保持当前会话并测试新连接。"
}

show_ssh_status() {
  local sshd_bin ssh_service service_state service_state_cn config root_config
  local port login_grace max_auth root_login pubkey password kbd auth_methods
  local root_text pubkey_text password_text kbd_text auth_text summary
  if sshd_bin=$(find_sshd_bin 2>/dev/null) && ssh_service=$(find_ssh_service 2>/dev/null); then
    service_state=$(systemctl is-active "$ssh_service" 2>/dev/null || true)
    case "$service_state" in
      active) service_state_cn='运行中' ;;
      inactive) service_state_cn='已停止' ;;
      failed) service_state_cn='启动失败' ;;
      activating) service_state_cn='正在启动' ;;
      deactivating) service_state_cn='正在停止' ;;
      *) service_state_cn=${service_state:-未知} ;;
    esac

    config=$("$sshd_bin" -T 2>/dev/null) || die "无法读取 SSH 生效配置。"
    root_config=$("$sshd_bin" -T -C "user=root,host=$(hostname),addr=127.0.0.1" 2>/dev/null) || root_config=$config

    port=$(awk '$1 == "port" { ports = ports ? ports ", " $2 : $2 } END { print ports }' <<<"$config")
    login_grace=$(awk '$1 == "logingracetime" {print $2; exit}' <<<"$config")
    max_auth=$(awk '$1 == "maxauthtries" {print $2; exit}' <<<"$config")
    pubkey=$(awk '$1 == "pubkeyauthentication" {print $2; exit}' <<<"$config")
    password=$(awk '$1 == "passwordauthentication" {print $2; exit}' <<<"$config")
    kbd=$(awk '$1 == "kbdinteractiveauthentication" {print $2; exit}' <<<"$config")
    auth_methods=$(awk '$1 == "authenticationmethods" {print $2; exit}' <<<"$config")
    root_login=$(awk '$1 == "permitrootlogin" {print $2; exit}' <<<"$root_config")

    case "$root_login" in
      no) root_text='已禁止' ;;
      prohibit-password|without-password) root_text='仅允许密钥（符合默认模式）' ;;
      forced-commands-only) root_text='仅允许强制命令（受限）' ;;
      yes) root_text='未限制（风险，取决于其他认证设置）' ;;
      *) root_text="${root_login:-未知}" ;;
    esac
    [[ $pubkey == yes ]] && pubkey_text='已启用' || pubkey_text='未启用（风险）'
    [[ $password == no ]] && password_text='已禁止（安全）' || password_text='允许（建议关闭）'
    [[ $kbd == no ]] && kbd_text='已禁止（安全）' || kbd_text='允许（建议关闭）'
    case "$auth_methods" in
      publickey) auth_text='仅允许公钥' ;;
      any) auth_text='任意可用认证方式' ;;
      *) auth_text=${auth_methods:-未知} ;;
    esac

    if [[ $service_state != active ]]; then
      summary='SSH 服务未正常运行'
    elif [[ ($root_login == no || $root_login == prohibit-password || $root_login == without-password) && $pubkey == yes && $password == no && $kbd == no && $auth_methods == publickey ]]; then
      if [[ $root_login == prohibit-password || $root_login == without-password ]]; then
        summary='Root 仅可使用密钥登录，所有密码认证均已禁止'
      else
        summary='Root 登录已禁止，所有密码认证均已禁止'
      fi
    else
      summary='存在未加固项目，请检查标注为“风险”或“建议关闭”的设置'
    fi

    printf 'SSH 服务状态\n'
    printf '  服务名称：%s\n' "$ssh_service"
    printf '  运行状态：%s\n' "$service_state_cn"
    printf '  监听端口：%s\n' "${port:-未知}"
    printf '  登录等待时间：%s 秒\n' "${login_grace:-未知}"
    printf '  最大认证尝试：%s 次\n' "${max_auth:-未知}"
    printf '\nSSH 认证安全\n'
    printf '  Root 登录策略：%s\n' "$root_text"
    printf '  公钥认证：%s\n' "$pubkey_text"
    printf '  密码认证：%s\n' "$password_text"
    printf '  键盘交互认证：%s\n' "$kbd_text"
    printf '  强制认证方式：%s\n' "$auth_text"
    printf '\n安全判断：%s\n' "$summary"
  else
    printf 'SSH 服务：未安装\n'
  fi
}

