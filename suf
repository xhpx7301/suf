      1) ssh_menu ;;
      2) ufw_menu ;;
      3) fail2ban_menu ;;
      4) run_menu_action show_status ;;
      5) run_menu_action all_in_one ;;
      0) exit 0 ;;
      *) warn "无效选项。"; pause ;;
    esac
  done
}

usage() {
  cat <<EOF
SUF ${APP_VERSION} - Server UFW & SSH Fortress

用法：
  suf               打开交互式菜单
  suf menu          打开交互式菜单
  suf status        查看整体安全状态
  suf --version     显示版本
  suf --help        显示帮助

项目：${APP_REPOSITORY}
EOF
}

main() {
  case "${1:-menu}" in
    -V|--version|version)
      printf 'suf %s\n' "$APP_VERSION"
      ;;
    -h|--help|help)
      usage
      ;;
    menu|"")
      require_root "$@"
      load_os
      menu
      ;;
    status)
      require_root "$@"
      load_os
      show_status
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
