all_in_one() {
  local target_user current_port target_port confirmation
  ensure_openssh
  install_public_key

  target_user=$LAST_CONFIGURED_USER
  require_tested_key_login "$target_user"

  current_port=$(current_ssh_port)
  target_port=$(prompt_port "$current_port")
  warn "请先在云安全组放行 TCP/${target_port}，当前 SSH 会话不要关闭。"
  read -r -p "完成后输入 FIREWALL-READY：" confirmation
  [[ $confirmation == FIREWALL-READY ]] || die "未确认云防火墙，取消操作。"

  apt_install ufw fail2ban python3-systemd
  ufw default deny incoming
  ufw default allow outgoing
  ufw allow "${target_port}/tcp" comment 'SUF SSH 管理'
  if [[ $current_port != "$target_port" ]]; then
    ufw allow "${current_port}/tcp" comment '当前 SSH 临时端口'
  fi
  if confirm "需要开放 HTTP/HTTPS 端口吗？"; then
    ufw allow 80/tcp comment '网页 HTTP'
    ufw allow 443/tcp comment '加密网页 HTTPS'
  fi
  allow_extra_ufw_ports
  warn "启用后，未明确放行的入站端口将被阻止。"
  ufw show added || true
  confirm "确认以上规则完整，可以启用 UFW 吗？" || die "取消操作。"
  ufw --force enable

  write_sshd_hardening "$target_port" "$target_user"

  cat >/etc/fail2ban/jail.d/suf.local <<EOF
[sshd]
enabled = true
port = ${target_port}
backend = systemd
maxretry = 5
findtime = 10m
bantime = 1h
bantime.increment = true
bantime.factor = 2
EOF
  chmod 600 /etc/fail2ban/jail.d/suf.local
  fail2ban-client -t
  systemctl enable --now fail2ban
  systemctl restart fail2ban

  ok "一键加固完成。"
  warn "不要关闭当前会话，先测试：ssh -p ${target_port} ${target_user}@服务器IP"
  warn "确认新连接成功后，再手动删除 UFW 中不需要的旧 SSH 端口规则。"
}

