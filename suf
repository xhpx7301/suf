show_security_setup_preview() {
  cat <<'EOF'
安全初始化向导将执行以下步骤：

  1. 在用于登录服务器的电脑上生成密钥对，不要在服务器上生成；
     仅上传公钥并安装；
     完成后要求在第二个终端验证密钥登录。
  2. 修改新的 SSH 端口；请先在云安全组放行该端口。
  3. 显示当前监听端口，安装并启用 UFW。
     新 SSH 端口和当前 SSH 端口会自动放行。
  4. 启用仅密钥 SSH 登录，并在修改前备份配置。
  5. 安装并配置 Fail2ban 的 SSH 防护规则。

仅建议用于新服务器或已确认全部公网服务端口的服务器。
EOF
}

security_initialization_wizard() {
  local target_user current_port target_port
  show_security_setup_preview
  confirm "确认执行安全初始化向导吗？" || die "取消安全初始化。"

  ensure_openssh
  install_public_key

  target_user=$LAST_CONFIGURED_USER
  require_tested_key_login "$target_user"

  current_port=$(current_ssh_port)
  target_port=$(prompt_port "$DEFAULT_SSH_PORT" "新的 SSH 端口")
  warn "请先在云安全组放行 TCP/${target_port}，当前 SSH 会话不要关闭。"
  confirm "已经放行或服务器没有外部安全组吗？" || die "未确认云防火墙，取消操作。"

  apt_install ufw fail2ban python3-systemd
  show_listening_ports
  ufw default deny incoming
  ufw default allow outgoing
  ufw allow "${target_port}/tcp" comment 'SUF SSH 管理'
  if [[ $current_port != "$target_port" ]]; then
    ufw allow "${current_port}/tcp" comment '当前 SSH 临时端口'
  fi
  if confirm "需要开放 HTTP/HTTPS 端口吗？"; then
    ufw allow 80/tcp comment '网页 HTTP'
    ufw allow 443/tcp comment '加密网页 HTTPS'
  fi
  allow_extra_ufw_ports
  warn "启用后，未明确放行的入站端口将被阻止。"
  ufw show added || true
  confirm "确认以上规则完整，可以启用 UFW 吗？" || die "取消操作。"
  ufw --force enable

  write_sshd_hardening "$target_port" "$target_user"

  configure_fail2ban_sshd "$target_port" 5 10m 1h

  ok "安全初始化完成。"
  warn "不要关闭当前会话，先测试：ssh -p ${target_port} ${target_user}@服务器IP"
  warn "确认新连接成功后，再手动删除 UFW 中不需要的旧 SSH 端口规则。"
}

