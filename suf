  require_ufw
  warn "将关闭 UFW 并移除软件包，但保留 /etc/ufw 配置文件。"
  read -r -p "确认卸载请输入 UNINSTALL-UFW：" confirmation
  [[ $confirmation == UNINSTALL-UFW ]] || die "取消卸载。"
  ufw --force disable || true
  DEBIAN_FRONTEND=noninteractive apt-get remove -y ufw
  ok "UFW 软件包已移除，配置文件仍保留。"
}

configure_fail2ban() {
  local default_port ssh_port maxretry findtime bantime
  local jail_file=/etc/fail2ban/jail.d/suf.local
  local backup_file=""
  apt_install fail2ban python3-systemd
  ensure_openssh
  default_port=$(current_ssh_port)
  ssh_port=$(prompt_port "$default_port")
  maxretry=$(prompt_positive_integer "最大失败次数" 5)
  findtime=$(prompt_duration "统计时间窗口" 10m)
  bantime=$(prompt_duration "首次封禁时间" 1h)

  if [[ -e $jail_file ]]; then
    mkdir -p "${BACKUP_ROOT}/fail2ban"
    backup_file="${BACKUP_ROOT}/fail2ban/suf.$(date +%Y%m%d-%H%M%S).local"
    cp -a "$jail_file" "$backup_file"
  fi

  cat >"$jail_file" <<EOF
[sshd]
enabled = true
port = ${ssh_port}
backend = systemd
maxretry = ${maxretry}
findtime = ${findtime}
bantime = ${bantime}
bantime.increment = true
bantime.factor = 2
EOF
  chmod 600 "$jail_file"
  chown root:root "$jail_file"

  if ! fail2ban-client -t; then
    if [[ -n $backup_file ]]; then
      cp -a "$backup_file" "$jail_file"
    else
      rm -f "$jail_file"
    fi
    die "Fail2ban 配置校验失败，已恢复原配置。"
  fi
  systemctl enable fail2ban
  systemctl reset-failed fail2ban || true
  if ! systemctl restart fail2ban; then
    show_fail2ban_start_diagnostics
    die "Fail2ban SSH 防护规则未启用。"
  fi
  ensure_fail2ban_running
  ok "Fail2ban SSH 防护已启用。"
  fail2ban-client status sshd || true
}

require_fail2ban() {
  command -v fail2ban-client >/dev/null 2>&1 || die "Fail2ban 尚未安装，请先选择安装。"
}

show_fail2ban_start_diagnostics() {
  warn "Fail2ban 未能保持运行，以下是 systemd 诊断信息："
  systemctl status fail2ban --no-pager -l || true
  printf '\n最近的 Fail2ban 日志：\n'
  journalctl -u fail2ban -b -n 80 --no-pager || true
}

ensure_fail2ban_running() {
  # Fail2ban may report active briefly before a jail initialization failure exits.
  sleep 1
  if ! systemctl is-active --quiet fail2ban; then
    show_fail2ban_start_diagnostics
    die "Fail2ban 启动失败；请根据以上日志修复后再重试。"
  fi
}

install_fail2ban_service() {
  apt_install fail2ban python3-systemd
  systemctl enable fail2ban
  systemctl reset-failed fail2ban || true
  if ! systemctl start fail2ban; then
    show_fail2ban_start_diagnostics
    die "Fail2ban 启动失败，未显示为已启用。"
  fi
  ensure_fail2ban_running
  ok "Fail2ban 已安装并启动。下一步请配置 SSH 防护规则。"
}

show_fail2ban_status() {
  if command -v fail2ban-client >/dev/null 2>&1; then
    printf '服务状态：%s\n' "$(systemctl is-active fail2ban 2>/dev/null || true)"
    fail2ban-client status || true
    printf '\nSSH 防护规则：\n'
    fail2ban-client status sshd 2>/dev/null || printf '  SSH 防护规则尚未启用。\n'
  else
    printf 'Fail2ban：未安装\n'
  fi
}

reload_fail2ban_service() {
  require_fail2ban
  fail2ban-client -t
  if systemctl is-active --quiet fail2ban; then
    fail2ban-client reload
  else
    systemctl enable fail2ban
    systemctl reset-failed fail2ban || true
    if ! systemctl start fail2ban; then
      show_fail2ban_start_diagnostics
      die "Fail2ban 启动失败，未重新加载配置。"
    fi
  fi
  ensure_fail2ban_running
  ok "Fail2ban 配置已重新加载。"
}

unban_fail2ban_ip() {
