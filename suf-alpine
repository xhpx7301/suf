explain_menu_failure() {
  local action=$1 status=$2 label
  label=$(menu_action_label "$action")
  warn "操作未完成：${label}（退出码 ${status}）。"
  case "${action}:${status}" in
    change_ssh_port:141)
      warn "问题位置：读取 SSH 当前生效配置。退出码 141 表示输出管道提前关闭（SIGPIPE）。"
      warn "配置文件可能已写入，但 SSH 尚未重载，服务仍可能监听旧端口。可用菜单 6 校验并加载，或菜单 7 恢复备份。"
      ;;
    *:141)
      warn "问题位置：${label} 使用的命令输出管道。退出码 141 表示输出被提前关闭（SIGPIPE）。"
      ;;
    *)
      warn "问题位置：${label}。请查看上方第一条 [FAIL] 或系统命令错误；该行给出直接失败原因。"
      ;;
  esac
}

run_menu_action() {
  local status
  set +e
  (set -Eeuo pipefail; "$@")
  status=$?
  set -e
  ((status == 0)) || explain_menu_failure "$1" "$status"
  pause
}

