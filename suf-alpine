#!/usr/bin/env bash
set -Eeuo pipefail

APP_VERSION="1.2.23"
APP_NAME="suf"
APP_REPOSITORY="https://github.com/xhpx7301/suf"
DEFAULT_SSH_PORT="28377"
SSH_MAIN="/etc/ssh/sshd_config"
SSH_DROPIN_DIR="/etc/ssh/sshd_config.d"
SSH_DROPIN="${SSH_DROPIN_DIR}/00-suf-hardening.conf"
BACKUP_ROOT="/var/backups/${APP_NAME}"
FAIL2BAN_JAIL_DIR="/etc/fail2ban/jail.d"
FAIL2BAN_JAIL_FILE="${FAIL2BAN_JAIL_DIR}/${APP_NAME}.local"
NFT_CONF="/etc/nftables.d/${APP_NAME}.nft"
NFT_MAIN="/etc/nftables.nft"
NFT_RULES_FILE="/etc/${APP_NAME}/nftables-rules.conf"
NFT_BACKUP_DIR="${BACKUP_ROOT}/nftables"
SSHD_BIN=""
LAST_CONFIGURED_USER=""
export LC_ALL=C

if [[ -t 1 ]]; then
  C_RED=$'\033[31m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_BLUE=$'\033[34m'; C_RESET=$'\033[0m'
else
  C_RED=""; C_GREEN=""; C_YELLOW=""; C_BLUE=""; C_RESET=""
fi

info() { printf '%s[INFO]%s %s\n' "$C_BLUE" "$C_RESET" "$*"; }
ok() { printf '%s[ OK ]%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn() { printf '%s[WARN]%s %s\n' "$C_YELLOW" "$C_RESET" "$*"; }
die() { printf '%s[FAIL]%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; exit 1; }
colored_status() {
  local state=$1 color="$C_RESET"
  case "$state" in
    运行中|已启用|已安装) color=$C_GREEN ;;
    已停止|已关闭|未启用) color=$C_YELLOW ;;
    未安装|失败|启动失败|异常*) color=$C_RED ;;
  esac
  printf '%s%s%s' "$color" "$state" "$C_RESET"
}
pause() { printf '\n'; read -r -p "按 Enter 返回菜单..." _; }
confirm() {
  local prompt=$1 answer
  while true; do
    if ! read -r -p "${prompt} [y/N，默认 N] " answer; then
      printf '\n' >&2
      return 1
    fi
    case "$answer" in
      [Yy]) return 0 ;;
      ""|[Nn]) return 1 ;;
      *) warn "请输入 y 或 n；直接按 Enter 默认为 n。" ;;
    esac
  done
}

require_root() {
  [[ $EUID -eq 0 ]] && return
  command -v doas >/dev/null 2>&1 || die "需要 root 权限，请使用 doas 或 root 执行 suf。"
  exec doas -- "$0" "$@"
}

load_os() {
  [[ -r /etc/os-release ]] || die "无法识别操作系统。"
  # shellcheck disable=SC1091
  source /etc/os-release
  [[ ${ID:-} == alpine ]] || die "Alpine 分支只能运行在 Alpine Linux。"
  command -v apk >/dev/null 2>&1 || die "未找到 apk。"
  command -v rc-service >/dev/null 2>&1 || die "未找到 OpenRC rc-service。"
  command -v rc-update >/dev/null 2>&1 || die "未找到 OpenRC rc-update。"
}

apk_install() {
  local missing=() package
  for package in "$@"; do
    apk info -e "$package" >/dev/null 2>&1 || missing+=("$package")
  done
  ((${#missing[@]} == 0)) && return
  info "安装软件包：${missing[*]}"
  apk add --no-cache "${missing[@]}"
}

user_home() { getent passwd "$1" | cut -d: -f6; }
user_is_admin() { id -nG "$1" 2>/dev/null | tr ' ' '\n' | grep -qx 'wheel'; }

set_local_account_password() {
  local target=$1 password confirmation
  while true; do
    read -r -s -p "请设置本地提权密码：" password
    printf '\n'
    [[ -n $password ]] || { warn "密码不能为空。"; continue; }
    [[ $password != *:* ]] || { warn "密码不能包含冒号，请重新设置。"; unset password; continue; }
    read -r -s -p "请再次输入本地密码：" confirmation
    printf '\n'
    [[ $password == "$confirmation" ]] && break
    warn "两次输入不一致，请重新设置。"
  done
  printf '%s:%s\n' "$target" "$password" | chpasswd || die "设置账号本地密码失败。"
  unset password confirmation
  ok "本地提权密码已设置。"
}

ensure_openssh() {
  apk_install openssh
  command -v sshd >/dev/null 2>&1 || die "未找到 sshd。"
  SSHD_BIN=$(command -v sshd)
  rc-update add sshd default >/dev/null 2>&1 || true
  rc-service sshd start >/dev/null 2>&1 || true
}

find_sshd() {
  command -v sshd >/dev/null 2>&1 || return 1
  SSHD_BIN=$(command -v sshd)
}

effective_sshd_value() {
  # Consume all sshd output: exiting awk early can make sshd receive SIGPIPE.
  "$SSHD_BIN" -T 2>/dev/null | awk -v wanted="$1" '$1 == wanted && !found { print $2; found=1 }'
}
effective_sshd_values() { "$SSHD_BIN" -T 2>/dev/null | awk -v wanted="$1" '$1 == wanted { print $2 }'; }
current_ssh_port() { local port; port=$(effective_sshd_value port || true); printf '%s\n' "${port:-22}"; }
valid_port() { [[ $1 =~ ^[0-9]+$ ]] && ((10#$1 >= 1 && 10#$1 <= 65535)); }

prompt_port() {
  local default_port=$1 label=${2:-端口} entered
  while true; do
    read -r -p "${label} [${default_port}]：" entered
    entered=${entered:-$default_port}
    valid_port "$entered" && { printf '%s\n' "$((10#$entered))"; return; }
    warn "端口必须是 1 到 65535 的整数。"
  done
}

prompt_protocol() {
  local protocol
  while true; do
    read -r -p "协议 tcp/udp [tcp]：" protocol
    protocol=${protocol:-tcp}
    case "$protocol" in
      tcp|udp) printf '%s\n' "$protocol"; return ;;
      *) warn "协议只能是 tcp 或 udp。" ;;
    esac
  done
}

prompt_allow_protocols() {
  local default_selection=${1:-1} selection
  while true; do
    read -r -p "放行协议：1=TCP+UDP，2=仅 TCP，3=仅 UDP [${default_selection}]：" selection
    case "${selection:-$default_selection}" in
      1) printf 'tcp udp\n'; return ;;
      2) printf 'tcp\n'; return ;;
      3) printf 'udp\n'; return ;;
      *) warn "请选择 1、2 或 3；直接按 Enter 使用默认选项。" ;;
    esac
  done
}

prompt_rule_comment() {
  local default_comment=$1 comment cleaned
  while true; do
    if ! read -r -p "备注 [${default_comment}]：" comment; then
      printf '\n' >&2
      return 1
    fi
    comment=${comment:-$default_comment}
    if [[ $comment == *'|'* || $comment == *'"'* || $comment == *'\'* ]]; then
      warn '备注不能包含 |、" 或 \，请重新输入。'
      continue
    fi
    cleaned=$(printf '%s' "$comment" | tr -d '\001-\037\177')
    if [[ $cleaned != "$comment" ]]; then
      warn '备注不能包含控制字符，请重新输入。'
      continue
    fi
    if ((${#comment} > 96)); then
      warn "备注过长（${#comment} 字节，最多 96 字节），请精简。"
      continue
    fi
    printf '%s\n' "$comment"
    return
  done
}

prompt_positive_integer() {
  local prompt=$1 default_value=$2 value
  while true; do
    read -r -p "${prompt} [${default_value}]：" value
    value=${value:-$default_value}
    if [[ $value =~ ^[0-9]+$ ]] && ((10#$value > 0)); then
      printf '%s\n' "$((10#$value))"
      return
    fi
    warn "请输入大于 0 的整数。"
  done
}

prompt_duration() {
  local prompt=$1 default_value=$2 value
  while true; do
    read -r -p "${prompt} [${default_value}]：" value
    value=${value:-$default_value}
    if [[ $value =~ ^([0-9]+)([smhdw]?)$ ]] && ((10#${BASH_REMATCH[1]} > 0)); then
      printf '%s\n' "$value"
      return
    fi
    warn "时间格式无效，可使用 600、10m、1h、1d 或 1w。"
  done
}

valid_ip_or_cidr() {
  local value=$1
  awk -v input="$value" '
    function valid_ipv4(ip,    parts, n, i) {
      if (ip !~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) return 0
      n = split(ip, parts, ".")
      if (n != 4) return 0
      for (i = 1; i <= 4; i++) {
        if (parts[i] + 0 > 255) return 0
      }
      return 1
    }
    function valid_ipv6(ip,    halves, nh, left, right, nl, nr, i, groups, ng, tail) {
      if (ip == "" || ip !~ /^[0-9A-Fa-f:.]+$/) return 0
      if (index(ip, ":::") > 0) return 0
      if (ip ~ /\./) {
        tail = ip
        sub(/^.*:/, "", tail)
        if (!valid_ipv4(tail)) return 0
        sub(/:[^:]*$/, ":0:0", ip)
      }
      if (index(ip, "::") > 0) {
        nh = split(ip, halves, "::")
        if (nh > 2) return 0
        nl = (halves[1] == "" ? 0 : split(halves[1], left, ":"))
        nr = (halves[2] == "" ? 0 : split(halves[2], right, ":"))
        for (i = 1; i <= nl; i++) if (left[i] !~ /^[0-9A-Fa-f]{1,4}$/) return 0
        for (i = 1; i <= nr; i++) if (right[i] !~ /^[0-9A-Fa-f]{1,4}$/) return 0
        return (nl + nr < 8)
      }
      ng = split(ip, groups, ":")
      if (ng != 8) return 0
      for (i = 1; i <= ng; i++) if (groups[i] !~ /^[0-9A-Fa-f]{1,4}$/) return 0
      return 1
    }
    BEGIN {
      if (input == "") exit 1
      n = split(input, segs, "/")
      if (n > 2) exit 1
      ip = segs[1]
      has_prefix = (n == 2)
      prefix = (has_prefix ? segs[2] : "")
      if (has_prefix && prefix !~ /^[0-9]+$/) exit 1
      if (ip ~ /:/) {
        if (!valid_ipv6(ip)) exit 1
        if (has_prefix && (prefix + 0 < 0 || prefix + 0 > 128)) exit 1
        exit 0
      }
      if (!valid_ipv4(ip)) exit 1
      if (has_prefix && (prefix + 0 < 0 || prefix + 0 > 32)) exit 1
      exit 0
    }
  '
}

current_ssh_client_ip() {
  local candidate=""
  if [[ -n ${SSH_CONNECTION:-} ]]; then
    candidate=${SSH_CONNECTION%% *}
  elif [[ -n ${SSH_CLIENT:-} ]]; then
    candidate=${SSH_CLIENT%% *}
  elif command -v who >/dev/null 2>&1; then
    candidate=$(who -m 2>/dev/null | sed -nE 's/.*\(([^)]+)\)[[:space:]]*$/\1/p' | head -n 1 || true)
  fi
  candidate=${candidate#[}
  candidate=${candidate%]}
  candidate=${candidate%%\%*}
  if [[ -n $candidate && $candidate =~ ^[0-9A-Fa-f:.]+$ ]] && [[ $candidate == *.* || $candidate == *:* ]]; then
    printf '%s\n' "$candidate"
  fi
}

ip_matches_source() {
  local client_ip=$1 source=$2
  [[ $source == any ]] && return 0
  [[ $client_ip == "$source" ]] && return 0
  awk -v client="$client_ip" -v src="$source" '
    function hex_val(ch,    pos) {
      pos = index("0123456789abcdef", tolower(ch))
      return pos > 0 ? pos - 1 : -1
    }
    function expand_v4(ip,    p, n) {
      n = split(ip, p, ".")
      if (n != 4) return ""
      return sprintf("%02x%02x%02x%02x", p[1] + 0, p[2] + 0, p[3] + 0, p[4] + 0)
    }
    function expand_v6(ip,    tail, v4h, halves, nh, left, right, nl, nr, i, out, g) {
      if (ip ~ /\./) {
        tail = ip
        sub(/^.*:/, "", tail)
        v4h = expand_v4(tail)
        if (v4h == "") return ""
        sub(/:[^:]*$/, ":" substr(v4h, 1, 4) ":" substr(v4h, 5, 4), ip)
      }
      if (index(ip, "::") > 0) {
        nh = split(ip, halves, "::")
        if (nh > 2) return ""
        nl = (halves[1] == "" ? 0 : split(halves[1], left, ":"))
        nr = (halves[2] == "" ? 0 : split(halves[2], right, ":"))
        if (nl + nr >= 8) return ""
        out = ""
        for (i = 1; i <= nl; i++) out = out sprintf("%04x", strtonum_hex(left[i]))
        for (i = 1; i <= 8 - nl - nr; i++) out = out "0000"
        for (i = 1; i <= nr; i++) out = out sprintf("%04x", strtonum_hex(right[i]))
        return out
      }
      g = split(ip, left, ":")
      if (g != 8) return ""
      out = ""
      for (i = 1; i <= 8; i++) out = out sprintf("%04x", strtonum_hex(left[i]))
      return out
    }
    function strtonum_hex(s,    i, v, c) {
      v = 0
      for (i = 1; i <= length(s); i++) {
        c = hex_val(substr(s, i, 1))
        if (c < 0) return -1
        v = v * 16 + c
      }
      return v
    }
    function match_hex_prefix(a, b, prefix,    full, rem, mask, va, vb, i) {
      if (a == "" || b == "" || length(a) != length(b)) return 0
      full = int(prefix / 4)
      rem = prefix % 4
      if (full > 0 && substr(a, 1, full) != substr(b, 1, full)) return 0
      if (rem == 0) return 1
      va = hex_val(substr(a, full + 1, 1))
      vb = hex_val(substr(b, full + 1, 1))
      mask = (rem == 1 ? 8 : rem == 2 ? 12 : 14)
      return (int(va / (16 - mask)) == int(vb / (16 - mask)))
    }
    BEGIN {
      n = split(src, segs, "/")
      sip = segs[1]
      if (sip ~ /:/) {
        prefix = (n == 2 ? segs[2] + 0 : 128)
        sh = expand_v6(sip)
        if (client ~ /:/) {
          ch = expand_v6(client)
        } else {
          v4 = expand_v4(client)
          ch = (v4 == "" ? "" : "00000000000000000000ffff" v4)
        }
        exit !match_hex_prefix(ch, sh, prefix)
      } else {
        prefix = (n == 2 ? segs[2] + 0 : 32)
        sh = expand_v4(sip)
        if (client ~ /^::[fF]{4}:[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) {
          sub(/^::[fF]{4}:/, "", client)
        }
        if (client ~ /:/) exit 1
        ch = expand_v4(client)
        exit !match_hex_prefix(ch, sh, prefix)
      }
    }
  '
}

ensure_admin_user() {
  local target=$1
  [[ $target =~ ^[a-z_][a-z0-9_-]*$ ]] || die "用户名格式无效。"
  if [[ $target == root ]]; then return; fi
  if ! id "$target" >/dev/null 2>&1; then
    info "创建管理员账号。"
    adduser -D "$target"
    set_local_account_password "$target"
  fi
  addgroup "$target" wheel >/dev/null 2>&1 || true
  apk_install doas
  install -d -m 755 /etc/doas.d
  printf 'permit setenv { SSH_CONNECTION SSH_CLIENT SUF_HOME } :wheel\n' >/etc/doas.d/00-suf.conf
  chmod 400 /etc/doas.d/00-suf.conf
}

ensure_unprivileged_user() {
  local target=$1
  [[ $target =~ ^[a-z_][a-z0-9_-]*$ ]] || die "用户名格式无效。"
  [[ $target != root ]] || die "普通用户模式不能使用 root。"
  if id "$target" >/dev/null 2>&1; then
    if user_is_admin "$target"; then
      die "账号 ${target} 已属于 wheel 管理组，请选择其他账号或管理员模式。"
    fi
  else
    info "创建无系统密码的普通账号 ${target}，不会加入 wheel 管理组。"
    adduser -D "$target"
  fi
  return 0
}

validate_public_key() {
  local key=$1 tmp
  [[ $key != *$'\n'* ]] || return 1
  [[ $key =~ ^(ssh-ed25519|sk-ssh-ed25519@openssh.com)[[:space:]]+[A-Za-z0-9+/=]+([[:space:]].*)?$ ]] || return 1
  tmp=$(mktemp); printf '%s\n' "$key" >"$tmp"
  local result
  if ssh-keygen -lf "$tmp" >/dev/null 2>&1; then result=0; else result=$?; fi
  rm -f "$tmp"
  return "$result"
}

authorized_key_count() {
  local file=$1
  [[ -r $file ]] || { printf '0\n'; return; }
  awk '{for (i=1;i<NF;i++) if ($i ~ /^(ssh-ed25519|sk-ssh-ed25519@openssh.com)$/ && $(i+1)!="") {count++; break}} END {print count+0}' "$file"
}

install_public_key() {
  local target_user home ssh_dir auth_file public_key key_type key_body fingerprint access_mode
  printf '\n选择该密钥登录账号的权限：\n（1）管理员权限（root 或 doas）\n（2）普通用户（无 doas）\n'
  read -r -p "请选择 [1]：" access_mode
  access_mode=${access_mode:-1}
  case "$access_mode" in
    1)
      read -r -p "管理员登录用户名 [root]：" target_user
      target_user=${target_user:-root}
      ensure_admin_user "$target_user"
      ;;
    2)
      read -r -p "普通登录用户名（不能是 root）：" target_user
      [[ -n $target_user ]] || die "普通用户模式必须指定用户名。"
      ensure_unprivileged_user "$target_user"
      ;;
    *) die "权限选项无效。" ;;
  esac
  home=$(user_home "$target_user")
  [[ -n $home && -d $home ]] || die "找不到 ${target_user} 的家目录。"
  printf '\n请在本地电脑生成 Ed25519 密钥（已有密钥可跳过）：\n'
  printf '  Windows PowerShell：ssh-keygen -t ed25519 -a 100 -f "$env:USERPROFILE\.ssh\id_ed25519_suf_ai"\n'
  printf '  macOS/Linux：      ssh-keygen -t ed25519 -a 100 -f ~/.ssh/id_ed25519_suf_ai\n'
  printf '按提示设置私钥口令；公钥文件是 id_ed25519_suf_ai.pub。\n'
  printf '  Windows 复制公钥：Get-Content "$env:USERPROFILE\.ssh\id_ed25519_suf_ai.pub" | Set-Clipboard\n'
  printf '  macOS/Linux 查看：cat ~/.ssh/id_ed25519_suf_ai.pub\n'
  printf '只粘贴 .pub 内容，私钥不要上传服务器。\n\n'
  read -r -p "准备好公钥后按 Enter 继续：" _
  read -r -p "粘贴公钥文件（.pub）的完整单行内容：" public_key
  validate_public_key "$public_key" || die "公钥无效；仅接受 Ed25519 公钥。"
  ssh_dir="${home}/.ssh"; auth_file="${ssh_dir}/authorized_keys"
  install -d -m 700 -o "$target_user" -g "$target_user" "$ssh_dir"
  touch "$auth_file"; chown "$target_user:$target_user" "$auth_file"; chmod 600 "$auth_file"
  read -r key_type key_body _ <<<"$public_key"
  if awk -v type="$key_type" -v body="$key_body" '{for(i=1;i<NF;i++) if($i==type && $(i+1)==body) found=1} END {exit !found}' "$auth_file"; then
    warn "该公钥已存在，未重复写入。"
  else
    printf '%s\n' "$public_key" >>"$auth_file"
    ok "公钥已写入 ${auth_file}。"
  fi
  fingerprint=$(printf '%s\n' "$public_key" | ssh-keygen -lf - | awk '{print $2}')
  LAST_CONFIGURED_USER=$target_user
  printf '账号：%s\n指纹：%s\n' "$target_user" "$fingerprint"
  printf '\n请保持当前 SSH 会话不关闭，并在第二个终端测试：\n'
  printf '  ssh -p %s %s@服务器IP\n' "$(current_ssh_port)" "$target_user"
  if [[ $target_user == root ]]; then
    printf '登录后执行 whoami，输出必须是 root。\n'
  elif user_is_admin "$target_user"; then
    printf '登录后执行 doas -n true，确认该用户可以提权。\n'
  else
    printf '登录后执行 whoami，确认输出是 %s；该账号没有 doas 权限。\n' "$target_user"
  fi
}

authorized_key_file() {
  local target_user=$1 home
  home=$(user_home "$target_user")
  [[ -n $home ]] || return 1
  printf '%s/.ssh/authorized_keys\n' "$home"
}

authorized_key_entries() {
  local auth_file=$1
  [[ -r $auth_file ]] || return 0
  awk '{for(i=1;i<NF;i++) if($i ~ /^(ssh-ed25519|sk-ssh-ed25519@openssh.com)$/ && $(i+1)!="") {comment=""; for(j=i+2;j<=NF;j++) comment=comment (comment ? " " : "") $j; printf "%d\t%s\t%s\t%s\n", NR,$i,$(i+1),comment; break}}' "$auth_file"
}

all_authorized_key_entries() {
  local target_user passwd uid gid gecos home shell auth_file line key_type key_body comment
  while IFS=: read -r target_user passwd uid gid gecos home shell; do
    [[ -n $target_user && -n $home ]] || continue
    auth_file="$home/.ssh/authorized_keys"
    [[ -r $auth_file ]] || continue
    while IFS=$'\t' read -r line key_type key_body comment; do
      [[ -n $key_type ]] || continue
      printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$target_user" "$auth_file" "$line" "$key_type" "$key_body" "$comment"
    done < <(authorized_key_entries "$auth_file")
  done < <(getent passwd)
}
show_authorized_keys() {
  local target_user auth_file line key_type key_body comment fingerprint index=0
  printf '\n所有账号的已安装公钥：\n'
  while IFS=$'\t' read -r target_user auth_file line key_type key_body comment; do
    fingerprint=$(printf '%s %s\n' "$key_type" "$key_body" | ssh-keygen -lf - | awk '{print $2}')
    index=$((index + 1))
    [[ -n $comment ]] || comment=-
    printf '  [%d] 用户：%s  %s  %s\n' "$index" "$target_user" "$fingerprint" "$comment"
  done < <(all_authorized_key_entries)
  ((index > 0)) || printf '  没有有效的 Ed25519 公钥。\n'
}

remove_authorized_key() {
  local target_user auth_file entries choice selected_line selected_key_type selected_key_body
  local line key_type key_body comment fingerprint index=0
  entries=$(all_authorized_key_entries)
  [[ -n $entries ]] || die "没有找到有效的 Ed25519 公钥。"
  printf '\n所有账号的已安装公钥：\n'
  while IFS=$'\t' read -r target_user auth_file line key_type key_body comment; do
    fingerprint=$(printf '%s %s\n' "$key_type" "$key_body" | ssh-keygen -lf - | awk '{print $2}')
    index=$((index + 1))
    [[ -n $comment ]] || comment=-
    printf '  [%d] 用户：%s  %s  %s\n' "$index" "$target_user" "$fingerprint" "$comment"
  done <<<"$entries"
  read -r -p "输入要删除的编号（直接回车取消）：" choice
  [[ -n $choice ]] || die "取消删除公钥。"
  [[ $choice =~ ^[0-9]+$ ]] || die "编号无效。"
  ((choice >= 1 && choice <= index)) || die "编号超出范围。"
  IFS=$'\t' read -r target_user auth_file selected_line selected_key_type selected_key_body _ < <(printf '%s\n' "$entries" | sed -n "$choice"p)
  if (( $(authorized_key_count "$auth_file") <= 1 )); then
    warn "账号 $target_user 只剩这一把有效公钥；删除后将无法通过 SSH 密钥登录该账号。"
  fi
  fingerprint=$(printf '%s %s\n' "$selected_key_type" "$selected_key_body" | ssh-keygen -lf - | awk '{print $2}')
  warn "将从账号 $target_user（$auth_file）删除公钥 $fingerprint。"
  confirm "确认删除吗？" || die "取消删除公钥。"
  sed -i "${selected_line}d" "$auth_file"
  chown "$target_user:$target_user" "$auth_file"
  chmod 600 "$auth_file"
  ok "已删除公钥 ${fingerprint}。"
}

public_key_menu() {
  while true; do
    clear 2>/dev/null || true
    cat <<EOF
公钥管理

（1）查看已安装公钥
（2）添加公钥
（3）删除指定公钥
（0）返回 SSH 菜单
EOF
    printf '\n'
    read -r -p "请选择：" choice
    case "${choice:-}" in
      1) run_menu_action show_authorized_keys ;;
      2) run_menu_action ensure_openssh_and_key ;;
      3) run_menu_action remove_authorized_key ;;
      0) return ;;
      *) warn "无效选项。"; pause ;;
    esac
