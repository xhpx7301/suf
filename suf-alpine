#!/usr/bin/env bash
set -Eeuo pipefail

APP_VERSION="1.0.1-alpine"
APP_NAME="suf"
APP_REPOSITORY="https://github.com/xhpx7301/suf"
SSH_MAIN="/etc/ssh/sshd_config"
SSH_DROPIN_DIR="/etc/ssh/sshd_config.d"
SSH_DROPIN="${SSH_DROPIN_DIR}/00-suf-hardening.conf"
BACKUP_ROOT="/var/backups/${APP_NAME}"
FAIL2BAN_JAIL_DIR="/etc/fail2ban/jail.d"
FAIL2BAN_JAIL_FILE="${FAIL2BAN_JAIL_DIR}/${APP_NAME}.local"
NFT_CONF="/etc/nftables.d/${APP_NAME}.nft"
NFT_MAIN="/etc/nftables.nft"
SSHD_BIN=""
SSH_SERVICE="sshd"
LAST_CONFIGURED_USER=""
export LC_ALL=C

if [[ -t 1 ]]; then
  C_RED=$'\033[31m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_BLUE=$'\033[34m'; C_RESET=$'\033[0m'
else
  C_RED=""; C_GREEN=""; C_YELLOW=""; C_BLUE=""; C_RESET=""
fi

info() { printf '%s[INFO]%s %s\n' "$C_BLUE" "$C_RESET" "$*"; }
ok() { printf '%s[ OK ]%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn() { printf '%s[WARN]%s %s\n' "$C_YELLOW" "$C_RESET" "$*"; }
die() { printf '%s[FAIL]%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; exit 1; }
pause() { printf '\n'; read -r -p "按 Enter 返回菜单..." _; }
confirm() { local prompt=$1 answer; read -r -p "${prompt} [y/N]：" answer; [[ ${answer:-n} =~ ^[Yy]$ ]]; }

require_root() {
  [[ $EUID -eq 0 ]] && return
  command -v doas >/dev/null 2>&1 || die "需要 root 权限，请使用 doas 或 root 执行 suf。"
  exec doas -- "$0" "$@"
}

load_os() {
  [[ -r /etc/os-release ]] || die "无法识别操作系统。"
  # shellcheck disable=SC1091
  source /etc/os-release
  [[ ${ID:-} == alpine ]] || die "Alpine 分支只能运行在 Alpine Linux。"
  command -v apk >/dev/null 2>&1 || die "未找到 apk。"
  command -v rc-service >/dev/null 2>&1 || die "未找到 OpenRC rc-service。"
  command -v rc-update >/dev/null 2>&1 || die "未找到 OpenRC rc-update。"
}

apk_install() {
  local missing=() package
  for package in "$@"; do
    apk info -e "$package" >/dev/null 2>&1 || missing+=("$package")
  done
  ((${#missing[@]} == 0)) && return
  info "安装软件包：${missing[*]}"
  apk add --no-cache "${missing[@]}"
}

user_home() { getent passwd "$1" | cut -d: -f6; }
user_is_admin() { id -nG "$1" 2>/dev/null | tr ' ' '\n' | grep -qx 'wheel'; }

ensure_openssh() {
  apk_install openssh
  command -v sshd >/dev/null 2>&1 || die "未找到 sshd。"
  SSHD_BIN=$(command -v sshd)
  rc-update add sshd default >/dev/null 2>&1 || true
  rc-service sshd start >/dev/null 2>&1 || true
}

find_sshd() {
  command -v sshd >/dev/null 2>&1 || return 1
  SSHD_BIN=$(command -v sshd)
}

effective_sshd_value() { "$SSHD_BIN" -T 2>/dev/null | awk -v wanted="$1" '$1 == wanted { print $2; exit }'; }
current_ssh_port() { local port; port=$(effective_sshd_value port || true); printf '%s\n' "${port:-22}"; }
valid_port() { [[ $1 =~ ^[0-9]+$ ]] && ((10#$1 >= 1 && 10#$1 <= 65535)); }

prompt_port() {
  local default_port=$1 label=${2:-端口} entered
  while true; do
    read -r -p "${label} [${default_port}]：" entered
    entered=${entered:-$default_port}
    valid_port "$entered" && { printf '%s\n' "$((10#$entered))"; return; }
    warn "端口必须是 1 到 65535 的整数。"
  done
}

ensure_admin_user() {
  local target=$1
  [[ $target =~ ^[a-z_][a-z0-9_-]*$ ]] || die "用户名格式无效。"
  if [[ $target == root ]]; then return; fi
  if ! id "$target" >/dev/null 2>&1; then
    adduser -D "$target"
  fi
  addgroup "$target" wheel >/dev/null 2>&1 || true
  apk_install doas
  install -d -m 755 /etc/doas.d
  printf 'permit :wheel\n' >/etc/doas.d/00-suf.conf
  chmod 400 /etc/doas.d/00-suf.conf
}

validate_public_key() {
  local key=$1 tmp
  [[ $key != *$'\n'* ]] || return 1
  [[ $key =~ ^(ssh-ed25519|sk-ssh-ed25519@openssh.com)[[:space:]]+[A-Za-z0-9+/=]+([[:space:]].*)?$ ]] || return 1
  tmp=$(mktemp); printf '%s\n' "$key" >"$tmp"
  local result
  if ssh-keygen -lf "$tmp" >/dev/null 2>&1; then result=0; else result=$?; fi
  rm -f "$tmp"
  return "$result"
}

authorized_key_count() {
  local file=$1
  [[ -r $file ]] || { printf '0\n'; return; }
  awk '{for (i=1;i<NF;i++) if ($i ~ /^(ssh-ed25519|sk-ssh-ed25519@openssh.com)$/ && $(i+1)!="") {count++; break}} END {print count+0}' "$file"
}

install_public_key() {
  local target_user home ssh_dir auth_file public_key key_type key_body fingerprint
  printf '\n请在用于登录服务器的电脑上生成 SSH 密钥对（不要在服务器上生成）：\n'
  printf '  ssh-keygen -t ed25519 -a 100\n\n'
  read -r -p "确认已生成公钥后按 Enter 继续：" _
  read -r -p "密钥登录用户名 [root]：" target_user
  target_user=${target_user:-root}
  ensure_admin_user "$target_user"
  home=$(user_home "$target_user")
  [[ -n $home && -d $home ]] || die "找不到 ${target_user} 的家目录。"
  read -r -p "粘贴 id_ed25519.pub 的完整单行内容：" public_key
  validate_public_key "$public_key" || die "公钥无效；仅接受 Ed25519 公钥。"
  ssh_dir="${home}/.ssh"; auth_file="${ssh_dir}/authorized_keys"
  install -d -m 700 -o "$target_user" -g "$target_user" "$ssh_dir"
  touch "$auth_file"; chown "$target_user:$target_user" "$auth_file"; chmod 600 "$auth_file"
  read -r key_type key_body _ <<<"$public_key"
  if ! awk -v type="$key_type" -v body="$key_body" '{for(i=1;i<NF;i++) if($i==type && $(i+1)==body) found=1} END {exit !found}' "$auth_file"; then
    printf '%s\n' "$public_key" >>"$auth_file"
  fi
  fingerprint=$(printf '%s\n' "$public_key" | ssh-keygen -lf - | awk '{print $2}')
  LAST_CONFIGURED_USER=$target_user
  printf '账号：%s\n指纹：%s\n' "$target_user" "$fingerprint"
  printf '请保持当前会话不关闭，并在第二个终端测试密钥登录。\n'
}

require_tested_key_login() {
  local target=$1 answer count home
  home=$(user_home "$target"); count=$(authorized_key_count "${home}/.ssh/authorized_keys")
  ((count > 0)) || die "账号 ${target} 没有有效的 Ed25519 公钥。"
  [[ $target == root ]] || user_is_admin "$target" || die "账号 ${target} 不在 wheel 管理组。"
  [[ $target == root ]] && warn "请在第二个终端用 root 密钥登录并确认 whoami 输出 root。" || warn "请在第二个终端用 ${target} 密钥登录并确认 doas -n true 成功。"
  read -r -p "确认已完成测试？[y/N]：" answer
  [[ ${answer:-n} =~ ^[Yy]$ ]] || die "未确认测试。"
}

backup_ssh_config() {
  local stamp backup_dir; stamp=$(date +%Y%m%d-%H%M%S); backup_dir="${BACKUP_ROOT}/${stamp}"; mkdir -p "$backup_dir"
  cp -a "$SSH_MAIN" "${backup_dir}/sshd_config"
  [[ -e $SSH_DROPIN ]] && cp -a "$SSH_DROPIN" "${backup_dir}/00-suf-hardening.conf" || : >"${backup_dir}/dropin-was-absent"
  printf '%s\n' "$backup_dir"
}

restore_ssh_backup() {
  local dir=$1; cp -a "${dir}/sshd_config" "$SSH_MAIN"
  [[ -e ${dir}/dropin-was-absent ]] && rm -f "$SSH_DROPIN" || cp -a "${dir}/00-suf-hardening.conf" "$SSH_DROPIN"
}

ensure_dropin_include_first() {
  local tmp
  head -n 4 "$SSH_MAIN" | grep -q '^# BEGIN SUF managed include$' && return
  tmp=$(mktemp); { printf '# BEGIN SUF managed include\nInclude %s\n# END SUF managed include\n' "$SSH_DROPIN"; cat "$SSH_MAIN"; } >"$tmp"
  install -m 600 -o root -g root "$tmp" "$SSH_MAIN"; rm -f "$tmp"
}

reload_ssh() { "$SSHD_BIN" -t || return 1; rc-service sshd reload >/dev/null 2>&1 || rc-service sshd restart; }

write_sshd_hardening() {
  local port=$1 target=$2 backup_dir permit_root effective
  permit_root=$([[ $target == root ]] && printf 'prohibit-password' || printf 'no')
  backup_dir=$(backup_ssh_config); mkdir -p "$SSH_DROPIN_DIR"; ensure_dropin_include_first
  cat >"$SSH_DROPIN" <<EOF
# Managed by SUF ${APP_VERSION}
Port ${port}
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
ChallengeResponseAuthentication no
PermitEmptyPasswords no
AuthenticationMethods publickey
PermitRootLogin ${permit_root}
MaxAuthTries 3
LoginGraceTime 30
EOF
  chmod 600 "$SSH_DROPIN"; chown root:root "$SSH_DROPIN"
  if ! "$SSHD_BIN" -t; then restore_ssh_backup "$backup_dir"; die "SSH 配置校验失败，已恢复原配置。"; fi
  effective=$($SSHD_BIN -T -C "user=root,host=$(hostname),addr=127.0.0.1")
  grep -qx "port ${port}" <<<"$effective" || { restore_ssh_backup "$backup_dir"; die "SSH 端口未生效，已恢复原配置。"; }
  if ! reload_ssh; then restore_ssh_backup "$backup_dir"; reload_ssh || true; die "SSH 重载失败，已恢复原配置。"; fi
  info "SSH 配置备份：${backup_dir}"
}

write_sshd_port() {
  local port=$1 backup_dir tmp
  backup_dir=$(backup_ssh_config); mkdir -p "$SSH_DROPIN_DIR"; ensure_dropin_include_first; tmp=$(mktemp)
  if [[ -e $SSH_DROPIN ]]; then
    awk -v port="$port" 'tolower($1)=="port" {if(!written++) print "Port " port; next} {print} END {if(!written) print "Port " port}' "$SSH_DROPIN" >"$tmp"
  else
    printf '# Managed by SUF %s\nPort %s\n' "$APP_VERSION" "$port" >"$tmp"
  fi
  install -m 600 -o root -g root "$tmp" "$SSH_DROPIN"; rm -f "$tmp"
  reload_ssh || { restore_ssh_backup "$backup_dir"; reload_ssh || true; die "SSH 端口修改失败，已恢复原配置。"; }
  ok "SSH 端口已修改为 ${port}。"
}

ssh_status() {
  if ! find_sshd; then
    printf 'SSH 服务：未安装\n'
    return
  fi
  printf 'SSH 服务：%s\n' "$(rc-service sshd status >/dev/null 2>&1 && printf 运行中 || printf 已停止)"
  printf 'SSH 端口：%s\n' "$(current_ssh_port)"
  "$SSHD_BIN" -T 2>/dev/null | awk '/^(passwordauthentication|pubkeyauthentication|permitrootlogin) / {print}'
}

install_openssh_service() { ensure_openssh; "$SSHD_BIN" -t; rc-service sshd start; ok "OpenSSH 已安装并启动。"; }

configure_ssh() {
  local target current target_port
  ensure_openssh; read -r -p "已验证密钥登录的用户名 [root]：" target; target=${target:-root}; require_tested_key_login "$target"
  current=$(current_ssh_port); target_port=$(prompt_port "$current" "SSH 端口")
  confirm "启用仅密钥登录并应用 SSH 端口 ${target_port} 吗？" || die "取消 SSH 配置。"
  write_sshd_hardening "$target_port" "$target"
}

change_ssh_port() { local current target; ensure_openssh; current=$(current_ssh_port); target=$(prompt_port "$current" "SSH 端口"); [[ $target == "$current" ]] && return; write_sshd_port "$target"; }

NFT_ACTIVE=0
nft_table_exists() { nft list table inet suf >/dev/null 2>&1; }
nft_persistence() {
  install -d -m 755 /etc/nftables.d
  touch "$NFT_MAIN"
  grep -Fqx "include \"${NFT_CONF}\"" "$NFT_MAIN" || printf '\ninclude "%s"\n' "$NFT_CONF" >>"$NFT_MAIN"
}
nft_disable_persistence() {
  [[ -f $NFT_MAIN ]] || return 0
  local tmp; tmp=$(mktemp)
  grep -Fvx "include \"${NFT_CONF}\"" "$NFT_MAIN" >"$tmp" || true
  install -m 600 -o root -g root "$tmp" "$NFT_MAIN"; rm -f "$tmp"
}
nft_write_base() {
  local ssh_port=$1 extra=${2:-}
  install -d -m 755 /etc/nftables.d
  cat >"$NFT_CONF" <<EOF
table inet suf {
  chain input {
    type filter hook input priority -100; policy drop;
    iifname "lo" accept
    ct state established,related accept
    ip protocol icmp accept
    ip6 nexthdr icmpv6 accept
    tcp dport ${ssh_port} accept comment "SUF SSH"
${extra}
  }
  chain output { type filter hook output priority 100; policy accept; }
}
EOF
  nft delete table inet suf 2>/dev/null || true
  nft -f "$NFT_CONF"
  nft_persistence
}

require_nftables() { command -v nft >/dev/null 2>&1 || die "nftables 尚未安装，请先选择安装。"; }
install_nftables_service() { apk_install nftables; nft_persistence; rc-update add nftables default >/dev/null 2>&1 || true; ok "nftables 已安装。"; }
enable_nftables_service() {
  local port; require_nftables; ensure_openssh; port=$(current_ssh_port); nft_write_base "$port"; rc-service nftables start >/dev/null 2>&1 || true; ok "nftables 已启用，SSH 端口 ${port} 已放行。";
}
disable_nftables_service() { require_nftables; confirm "确认关闭 nftables 吗？" || die "取消关闭。"; nft delete table inet suf 2>/dev/null || true; nft_disable_persistence; ok "SUF nftables 防火墙规则已移除。"; }
uninstall_nftables_service() { require_nftables; confirm "确认卸载 nftables 并保留配置吗？" || die "取消卸载。"; nft delete table inet suf 2>/dev/null || true; nft_disable_persistence; rc-service nftables stop >/dev/null 2>&1 || true; apk del nftables; ok "nftables 已卸载。"; }
show_nftables_status() { if ! command -v nft >/dev/null 2>&1; then printf 'nftables：未安装\n'; elif nft_table_exists; then printf 'nftables：SUF 规则运行中\n'; nft list table inet suf; else printf 'nftables：未启用 SUF 规则\n'; fi; }
reload_nftables() { require_nftables; [[ -f $NFT_CONF ]] || die "未找到 SUF nftables 配置。"; nft delete table inet suf 2>/dev/null || true; nft -f "$NFT_CONF"; ok "nftables 规则已重新加载。"; }
allow_nft_port() { local port protocol; require_nftables; nft_table_exists || die "请先启用 nftables。"; port=$(prompt_port 443 "要放行的端口"); read -r -p "协议 [tcp]：" protocol; protocol=${protocol:-tcp}; [[ $protocol == tcp || $protocol == udp ]] || die "协议只能是 tcp 或 udp。"; nft add rule inet suf input "$protocol" dport "$port" accept comment "SUF extra"; nft list table inet suf >"$NFT_CONF"; nft_persistence; ok "已放行 ${port}/${protocol}。"; }

ensure_alpine_syslog() {
  local service="" probe="SUF-syslog-probe-$$"
  if [[ -x /etc/init.d/syslog ]]; then
    service=syslog
  elif [[ -x /etc/init.d/syslog-ng ]]; then
    service=syslog-ng
  else
    info "未找到 Alpine syslog 服务，尝试安装 syslog-ng。"
    apk_install syslog-ng
    service=syslog-ng
  fi

  rc-update add "$service" boot >/dev/null 2>&1 || true
  rc-service "$service" start >/dev/null 2>&1 || rc-service "$service" restart >/dev/null 2>&1 || die "无法启动 ${service}。"
  install -d -m 755 /var/log
  [[ -e /var/log/messages ]] || touch /var/log/messages

  if command -v logger >/dev/null 2>&1; then
    logger -t suf "$probe" || true
    for _ in 1 2 3 4 5; do
      grep -Fq "$probe" /var/log/messages 2>/dev/null && return
      sleep 1
    done
  fi
  die "syslog 已启动，但没有确认日志写入 /var/log/messages；未配置 Fail2ban。"
}

configure_fail2ban() {
  local port=$1 jail_file=$FAIL2BAN_JAIL_FILE backup=""
  apk_install fail2ban
  ensure_openssh
  ensure_alpine_syslog
  mkdir -p "$FAIL2BAN_JAIL_DIR"; [[ -e $jail_file ]] && { backup="${BACKUP_ROOT}/fail2ban/suf.$(date +%Y%m%d-%H%M%S).local"; mkdir -p "${BACKUP_ROOT}/fail2ban"; cp -a "$jail_file" "$backup"; }
  cat >"$jail_file" <<EOF
[sshd]
enabled = true
port = ${port}
backend = auto
logpath = /var/log/messages
maxretry = 5
findtime = 10m
bantime = 1h
EOF
  chmod 600 "$jail_file"; chown root:root "$jail_file"
  if ! fail2ban-client -t; then [[ -n $backup ]] && cp -a "$backup" "$jail_file" || rm -f "$jail_file"; die "Fail2ban 配置校验失败，已恢复原配置。"; fi
  rc-update add fail2ban default >/dev/null 2>&1 || true
  if ! rc-service fail2ban restart >/dev/null 2>&1; then
    [[ -n $backup ]] && cp -a "$backup" "$jail_file" || rm -f "$jail_file"
    rc-service fail2ban restart >/dev/null 2>&1 || true
    die "Fail2ban 启动失败，已恢复原配置。"
  fi
  sleep 1; if ! rc-service fail2ban status >/dev/null 2>&1; then [[ -n $backup ]] && cp -a "$backup" "$jail_file" || rm -f "$jail_file"; rc-service fail2ban restart >/dev/null 2>&1 || true; die "Fail2ban 启动后退出，已恢复原配置。"; fi
  ok "Fail2ban SSH 防护已启用。"
}

fail2ban_status() { if ! command -v fail2ban-client >/dev/null 2>&1; then printf 'Fail2ban：未安装\n'; elif rc-service fail2ban status >/dev/null 2>&1; then printf 'Fail2ban：运行中\n'; fail2ban-client status sshd 2>/dev/null || true; else printf 'Fail2ban：已停止或启动失败\n'; fi; }
configure_current_fail2ban() { ensure_openssh; configure_fail2ban "$(current_ssh_port)"; }
install_fail2ban() { apk_install fail2ban; rc-update add fail2ban default >/dev/null 2>&1 || true; rc-service fail2ban start; ok "Fail2ban 已安装。请使用配置选项启用 SSH jail。"; }
stop_fail2ban() { command -v fail2ban-client >/dev/null 2>&1 || die "Fail2ban 尚未安装。"; confirm "确认停止 Fail2ban 吗？" || die "取消停止。"; rc-service fail2ban stop; ok "Fail2ban 已停止。"; }
uninstall_fail2ban() { command -v fail2ban-client >/dev/null 2>&1 || die "Fail2ban 尚未安装。"; confirm "确认卸载 Fail2ban 并保留配置吗？" || die "取消卸载。"; rc-service fail2ban stop >/dev/null 2>&1 || true; apk del fail2ban; ok "Fail2ban 已卸载。"; }

security_initialization_wizard() {
  local target current port
  cat <<'EOF'
安全初始化向导将执行：
  1. 安装公钥并验证密钥登录
  2. 修改 SSH 端口并放行 nftables
  3. 启用 SSH 仅密钥登录
  4. 启用 nftables 入站默认拒绝
  5. 安装并配置 Fail2ban SSH jail
仅建议用于新服务器或已确认全部公网服务端口的服务器。
EOF
  confirm "确认执行安全初始化向导吗？" || die "取消安全初始化。"
  ensure_openssh; install_public_key; target=$LAST_CONFIGURED_USER; require_tested_key_login "$target"; current=$(current_ssh_port); port=$(prompt_port "$current" "SSH 端口")
  confirm "确认云安全组已放行 TCP/${port} 吗？" || die "取消初始化。"
  install_nftables_service; nft_write_base "$port"; rc-service nftables start >/dev/null 2>&1 || true
  write_sshd_hardening "$port" "$target"; configure_fail2ban "$port"; ok "Alpine 安全初始化完成。"
}

project_dir() { [[ -n ${SUF_HOME:-} ]] && printf '%s\n' "$SUF_HOME" || printf '%s/suf\n' "$HOME"; }
update_project() { local dir; apk_install git; dir=$(project_dir); [[ ! -L $dir ]] || die "${dir} 是符号链接，拒绝更新。"; if [[ -d ${dir}/.git ]]; then [[ $(git -C "$dir" remote get-url origin 2>/dev/null || true) == "${APP_REPOSITORY}.git" ]] || die "远程仓库不是 SUF。"; [[ -z $(git -C "$dir" status --porcelain) ]] || die "仓库存在未提交修改。"; git -C "$dir" pull --ff-only; elif [[ -e $dir ]]; then die "${dir} 不是 SUF Git 仓库。"; else git clone --depth 1 "${APP_REPOSITORY}.git" "$dir"; fi; [[ -f ${dir}/install.sh ]] || die "仓库中缺少 install.sh。"; bash "${dir}/install.sh" --no-launch; ok "SUF Alpine 已更新。"; }

run_menu_action() { local status; set +e; (set -Eeuo pipefail; "$@"); status=$?; set -e; ((status == 0)) || warn "操作未完成（退出码 ${status}）。"; pause; }

ssh_menu() { while true; do clear 2>/dev/null || true; cat <<EOF
SSH 与密钥管理

（1）查看 SSH 状态
（2）安装/修复 OpenSSH
（3）安装公钥并验证
（4）启用仅密钥登录或修改端口
（5）修改 SSH 端口
（0）返回
EOF
read -r -p "请选择：" choice; case ${choice:-} in 1) run_menu_action ssh_status;; 2) run_menu_action install_openssh_service;; 3) run_menu_action install_public_key;; 4) run_menu_action configure_ssh;; 5) run_menu_action change_ssh_port;; 0) return;; *) warn "无效选项。"; pause;; esac; done; }

firewall_menu() { while true; do clear 2>/dev/null || true; cat <<EOF
nftables 防火墙管理

（1）查看状态
（2）安装 nftables
（3）启用 nftables
（4）关闭 SUF 防火墙规则
（5）卸载 nftables
（6）重新加载规则
（7）放行指定端口
（0）返回
EOF
