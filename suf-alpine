sync_fail2ban_ssh_port() {
  local new_port=$1 backup="" tmp
  [[ -f $FAIL2BAN_JAIL_FILE ]] || return 0
  command -v fail2ban-client >/dev/null 2>&1 || return 0
  backup="${BACKUP_ROOT}/fail2ban/suf.$(date +%Y%m%d-%H%M%S).local"
  mkdir -p "${BACKUP_ROOT}/fail2ban"
  cp -a "$FAIL2BAN_JAIL_FILE" "$backup"

  tmp=$(mktemp)
  awk -v new_port="$new_port" '
    BEGIN { in_sshd = 0; seen_sshd = 0; wrote_port = 0 }
    /^[[:space:]]*\[/ {
      if (in_sshd && !wrote_port) {
        print "port = " new_port
        wrote_port = 1
      }
      section = $0
      sub(/^[[:space:]]*\[/, "", section)
      sub(/\].*$/, "", section)
      in_sshd = (tolower(section) == "sshd")
      if (in_sshd) seen_sshd = 1
      print
      next
    }
    in_sshd && tolower($0) ~ /^[[:space:]]*port[[:space:]]*=/ {
      if (!wrote_port) {
        print "port = " new_port
        wrote_port = 1
      }
      next
    }
    { print }
    END {
      if (in_sshd && !wrote_port) {
        print "port = " new_port
      } else if (!seen_sshd) {
        print ""
        print "[sshd]"
        print "port = " new_port
      }
    }
  ' "$FAIL2BAN_JAIL_FILE" >"$tmp"
  install -m 600 -o root -g root "$tmp" "$FAIL2BAN_JAIL_FILE"
  rm -f "$tmp"

  if ! fail2ban-client -t >/dev/null 2>&1; then
    cp -a "$backup" "$FAIL2BAN_JAIL_FILE"
    warn "同步 Fail2ban SSH 端口校验失败，已恢复原 Fail2ban 配置。"
    return 0
  fi
  if rc-service fail2ban status >/dev/null 2>&1; then
    if ! fail2ban-client reload >/dev/null 2>&1 && ! rc-service fail2ban restart >/dev/null 2>&1; then
      cp -a "$backup" "$FAIL2BAN_JAIL_FILE"
      rc-service fail2ban restart >/dev/null 2>&1 || true
      warn "同步 Fail2ban SSH 端口后重载失败，已恢复原 Fail2ban 配置。"
      return 0
    fi
  fi
  ok "Fail2ban SSH 监控端口已同步更新为 ${new_port}。"
}

configure_fail2ban_sshd() {
  local port=$1 maxretry=$2 findtime=$3 bantime=$4 ignoreip=$5
  local jail_file=$FAIL2BAN_JAIL_FILE backup=""
  mkdir -p "$FAIL2BAN_JAIL_DIR"
  if [[ -e $jail_file ]]; then
    backup="${BACKUP_ROOT}/fail2ban/suf.$(date +%Y%m%d-%H%M%S).local"
    mkdir -p "${BACKUP_ROOT}/fail2ban"
    cp -a "$jail_file" "$backup"
  fi
  cat >"$jail_file" <<EOF
[sshd]
enabled = true
port = ${port}
backend = auto
logpath = /var/log/messages
maxretry = ${maxretry}
findtime = ${findtime}
bantime = ${bantime}
bantime.increment = true
bantime.factor = 2
ignoreip = ${ignoreip}
EOF
  chmod 600 "$jail_file"
  chown root:root "$jail_file"
  if ! fail2ban-client -t; then
    if [[ -n $backup ]]; then cp -a "$backup" "$jail_file"; else rm -f "$jail_file"; fi
    show_fail2ban_start_diagnostics
    die "Fail2ban 配置校验失败，已恢复原配置。"
  fi
  rc-update add fail2ban default >/dev/null 2>&1 || true
  if ! rc-service fail2ban restart >/dev/null 2>&1; then
    if [[ -n $backup ]]; then cp -a "$backup" "$jail_file"; else rm -f "$jail_file"; fi
    rc-service fail2ban restart >/dev/null 2>&1 || true
    show_fail2ban_start_diagnostics
    die "Fail2ban 启动失败，已恢复原配置。"
  fi
  sleep 1
  if ! rc-service fail2ban status >/dev/null 2>&1; then
    if [[ -n $backup ]]; then cp -a "$backup" "$jail_file"; else rm -f "$jail_file"; fi
    rc-service fail2ban restart >/dev/null 2>&1 || true
    show_fail2ban_start_diagnostics
    die "Fail2ban 启动后退出，已恢复原配置。"
  fi
  unban_current_ssh_ip_if_needed
  ok "Fail2ban SSH 防护已启用。"
}

configure_fail2ban() {
  local port default_maxretry default_findtime default_bantime default_ignoreip
  local maxretry findtime bantime ignoreip
  apk_install fail2ban
  ensure_openssh
  ensure_alpine_syslog
  port=$(current_ssh_port)
  info "已检测到当前 SSH 端口：${port}，Fail2ban 将保护此端口。"
  default_maxretry=$(fail2ban_jail_value maxretry)
  default_findtime=$(fail2ban_jail_value findtime)
  default_bantime=$(fail2ban_jail_value bantime)
  [[ $default_maxretry =~ ^[0-9]+$ ]] && ((10#$default_maxretry > 0)) || default_maxretry=5
  [[ $default_findtime =~ ^[0-9]+[smhdw]?$ ]] || default_findtime=10m
  [[ $default_bantime =~ ^[0-9]+[smhdw]?$ ]] || default_bantime=1h
  default_ignoreip=$(merge_fail2ban_ignoreip)

  maxretry=$(prompt_positive_integer "最大失败次数" "$default_maxretry")
  findtime=$(prompt_duration "统计时间窗口" "$default_findtime")
  bantime=$(prompt_duration "首次封禁时间" "$default_bantime")
  ignoreip=$(prompt_fail2ban_ignoreip "$default_ignoreip")

  configure_fail2ban_sshd "$port" "$maxretry" "$findtime" "$bantime" "$ignoreip"
  show_fail2ban_sshd_status
}

fail2ban_status_value() {
  local status=$1 label=$2
  awk -v label="$label" '
    index($0, label ":") {
      value = substr($0, index($0, label ":") + length(label) + 1)
      sub(/^[[:space:]]+/, "", value)
      sub(/[[:space:]]+$/, "", value)
      print value
      exit
    }
  ' <<<"$status"
}

fail2ban_effective_ignoreip() {
  local raw="" parsed=""
  if raw=$(fail2ban-client get sshd ignoreip 2>/dev/null); then
    parsed=$(awk '
      /^[[:space:]]*(\||`)-/ {
        sub(/^[[:space:]]*(\||`)-[[:space:]]*/, "", $0)
        gsub(/[[:space:]]+$/, "", $0)
        if ($0 != "") out = out (out ? " " : "") $0
      }
      END { print out }
    ' <<<"$raw")
  fi
  if [[ -z $parsed && -r $FAIL2BAN_JAIL_FILE ]]; then
    parsed=$(fail2ban_jail_value ignoreip)
  fi
  printf '%s\n' "${parsed:-未配置}"
}

show_fail2ban_sshd_status() {
  local status current_failed total_failed current_banned total_banned banned_ips ignore_ips
  if ! status=$(fail2ban-client status sshd 2>/dev/null); then
    printf 'SSH 防护规则：尚未启用。\n'
    return
  fi

  current_failed=$(fail2ban_status_value "$status" 'Currently failed')
  total_failed=$(fail2ban_status_value "$status" 'Total failed')
  current_banned=$(fail2ban_status_value "$status" 'Currently banned')
  total_banned=$(fail2ban_status_value "$status" 'Total banned')
  banned_ips=$(fail2ban_status_value "$status" 'Banned IP list')
  ignore_ips=$(fail2ban_effective_ignoreip)

  printf 'SSH 防护规则（sshd）\n'
  printf '  当前失败次数：%s\n' "${current_failed:-0}"
  printf '  累计失败次数：%s\n' "${total_failed:-0}"
  printf '  当前封禁数量：%s\n' "${current_banned:-0}"
  printf '  累计封禁数量：%s\n' "${total_banned:-0}"
  printf '  已封禁 IP：%s\n' "${banned_ips:-无}"
  printf '  白名单 IP：%s\n' "${ignore_ips:-未配置}"
  printf '  日志来源：/var/log/messages（Alpine syslog）\n'
}

show_fail2ban_status() {
  local status jail_list running=0
  if ! command -v fail2ban-client >/dev/null 2>&1; then
    printf 'Fail2ban：%s\n' "$(colored_status 未安装)"
    return
  fi
  printf 'Fail2ban 防护状态\n'
  if rc-service fail2ban status >/dev/null 2>&1; then
    running=1
    printf '  服务状态：%s\n' "$(colored_status 运行中)"
  else
    printf '  服务状态：%s\n' "$(colored_status 已停止)"
  fi
  if ((running == 0)) || ! status=$(fail2ban-client status 2>/dev/null); then
    printf '  防护规则：服务未运行，无法读取。\n'
    return
  fi
  jail_list=$(fail2ban_status_value "$status" 'Jail list')
  printf '  已启用防护规则：%s\n\n' "${jail_list:-无}"
  show_fail2ban_sshd_status
}

fail2ban_status() { show_fail2ban_status "$@"; }

configure_current_fail2ban() { configure_fail2ban; }

install_fail2ban() {
  apk_install fail2ban
  ensure_openssh
  ensure_fail2ban_client_protection
  if ! fail2ban-client -t; then
    show_fail2ban_start_diagnostics
    die "Fail2ban 配置校验失败，服务尚未启动；请先修复上面的配置错误。"
  fi
  rc-update add fail2ban default >/dev/null 2>&1 || true
  if rc-service fail2ban status >/dev/null 2>&1; then
    if ! rc-service fail2ban restart; then
      show_fail2ban_start_diagnostics
      die "Fail2ban 重启失败，未显示为已启用。"
    fi
  else
    if ! rc-service fail2ban start; then
      show_fail2ban_start_diagnostics
      die "Fail2ban 启动失败，未显示为已启用。"
    fi
  fi
  ensure_fail2ban_running
  unban_current_ssh_ip_if_needed
  ok "Fail2ban 已安装并启动，SSH 防护已自动启用。如需调整参数请使用选项 3。"
  show_fail2ban_sshd_status
}

reload_fail2ban() {
  command -v fail2ban-client >/dev/null 2>&1 || die "Fail2ban 尚未安装。"
  fail2ban-client -t
  if rc-service fail2ban status >/dev/null 2>&1; then
    fail2ban-client reload >/dev/null 2>&1 || rc-service fail2ban restart
  else
    rc-update add fail2ban default >/dev/null 2>&1 || true
    if ! rc-service fail2ban start; then
      show_fail2ban_start_diagnostics
      die "Fail2ban 启动失败，未重新加载配置。"
    fi
  fi
  ensure_fail2ban_running
  ok "Fail2ban 配置已校验并重新加载。"
}

unban_fail2ban_ip() {
  local address
  command -v fail2ban-client >/dev/null 2>&1 || die "Fail2ban 尚未安装。"
  show_fail2ban_sshd_status
  printf '\n'
  read -r -p "要解封的 IPv4/IPv6 地址（直接回车取消）：" address
  [[ -n $address ]] || die "取消解封。"
  [[ $address =~ ^[0-9A-Fa-f:.]+$ ]] || die "IP 地址格式无效。"
  fail2ban-client set sshd unbanip "$address"
  ok "已提交解封：${address}。"
}

stop_fail2ban() {
  command -v fail2ban-client >/dev/null 2>&1 || die "Fail2ban 尚未安装。"
  warn "停止 Fail2ban 后将不再自动封禁新的攻击来源。"
  confirm "确认停止 Fail2ban 吗？" || die "取消停止。"
  rc-service fail2ban stop
  rc-update del fail2ban default >/dev/null 2>&1 || true
  ok "Fail2ban 已停止并取消开机启动。"
}

uninstall_fail2ban() {
  command -v fail2ban-client >/dev/null 2>&1 || die "Fail2ban 尚未安装。"
  warn "将停止 Fail2ban 并移除软件包，但保留 /etc/fail2ban 配置。"
  confirm "确认卸载 Fail2ban 并保留配置吗？" || die "取消卸载。"
  rc-service fail2ban stop >/dev/null 2>&1 || true
  rc-update del fail2ban default >/dev/null 2>&1 || true
  apk del fail2ban
  ok "Fail2ban 软件包已移除，配置文件仍保留。"
}

allow_extra_nft_ports() {
  local input entry port proto
  printf '\n额外端口格式示例：8443/tcp,51820/udp。留空表示不添加。\n'
  read -r -p "需要额外放行的端口：" input
  [[ -n $input ]] || return 0

  IFS=',' read -r -a entries <<<"$input"
  for entry in "${entries[@]}"; do
    entry=${entry//[[:space:]]/}
    [[ -n $entry ]] || continue
    if [[ $entry =~ ^([0-9]+)/(tcp|udp)$ ]]; then
      port=${BASH_REMATCH[1]}
      proto=${BASH_REMATCH[2]}
      if valid_port "$port"; then
        nft_upsert_rule allow "$proto" "$((10#$port))" any "额外服务"
        ok "已添加待应用放行规则：$((10#$port))/${proto}"
        continue
      fi
    fi
    die "无效端口规则：${entry}。应使用 端口/tcp 或 端口/udp。"
  done
}

security_initialization_wizard() {
  local target current_port port snapshot tmp_conf ignoreip
  cat <<'EOF'
安全初始化向导将执行以下步骤：

  1. 在本地电脑生成密钥对并安装公钥，随后在第二个终端验证密钥登录
  2. 修改 SSH 端口（默认 28377）；请先确认云安全组已放行该端口
  3. 检查当前监听端口，并配置、启用 nftables 防火墙（默认入站拒绝）
  4. 启用 SSH 仅密钥登录，并在修改前备份配置
  5. 安装并配置 Fail2ban SSH 防护（自动将当前连接 IP 加入白名单）

仅建议用于新服务器或已确认全部公网服务端口的服务器。
EOF
  confirm "确认执行安全初始化向导吗？" || die "取消安全初始化。"

  ensure_openssh
  install_public_key
  target=$LAST_CONFIGURED_USER
  require_tested_key_login "$target"

  current_port=$(current_ssh_port)
  port=$(prompt_port "$DEFAULT_SSH_PORT" "新的 SSH 端口")
  warn "请先在云安全组放行 TCP/${port}，当前 SSH 会话不要关闭。"
  confirm "已经放行或服务器没有外部安全组吗？" || die "取消初始化。"

  apk_install nftables fail2ban
  show_listening_ports no
  nft_ensure_rules_file
  snapshot=$(mktemp)
  cp -a "$NFT_RULES_FILE" "$snapshot"

  nft_upsert_rule allow tcp "$port" any "SUF SSH 管理"
  if [[ $current_port != "$port" ]]; then
    nft_upsert_rule allow tcp "$current_port" any "当前 SSH 临时端口"
  fi
  if confirm "这台服务器需要对公网提供 HTTP/HTTPS 吗？"; then
    nft_upsert_rule allow tcp 80 any "网页 HTTP"
    nft_upsert_rule allow tcp 443 any "加密网页 HTTPS"
  fi
  allow_extra_nft_ports

  nft_sort_rules_file
  tmp_conf=$(mktemp)
  nft_render_config "$tmp_conf"
  if ! nft -c -f "$tmp_conf"; then
    cp -a "$snapshot" "$NFT_RULES_FILE"
    rm -f "$tmp_conf" "$snapshot"
    die "nftables 规则校验失败，初始化已中止。"
  fi
  warn "启用后，未明确放行的入站端口将被阻止。"
  show_nftables_allowed_ports
  if ! confirm "确认以上规则完整，可以启用 nftables 吗？"; then
    cp -a "$snapshot" "$NFT_RULES_FILE"
    rm -f "$tmp_conf" "$snapshot"
    die "取消初始化。"
  fi

  nft_apply_config_file "$tmp_conf"
  rm -f "$tmp_conf" "$snapshot"
  nft_handle_conflicting_filter_table
  rc-update add nftables default >/dev/null 2>&1 || true
  rc-service nftables start >/dev/null 2>&1 || true

  write_sshd_hardening "$port" "$target"
  ensure_alpine_syslog
  ignoreip=$(merge_fail2ban_ignoreip)
  configure_fail2ban_sshd "$port" 5 10m 1h "$ignoreip"
  ok "Alpine 安全初始化完成。"
  warn "不要关闭当前会话，先测试：ssh -p ${port} ${target}@服务器IP"
  if [[ $current_port != "$port" ]]; then
    warn "确认新连接成功后，可在 nftables 菜单删除不再需要的旧 SSH 端口 ${current_port}/tcp 规则。"
  fi
}

project_dir() {
  local caller_user caller_home
  if [[ -n ${SUF_HOME:-} ]]; then
    printf '%s\n' "$SUF_HOME"
    return
  fi
  caller_user=${DOAS_USER:-${SUDO_USER:-}}
  if [[ -n $caller_user && $caller_user != root ]]; then
    caller_home=$(user_home "$caller_user")
    if [[ -n $caller_home ]]; then
      printf '%s/suf\n' "$caller_home"
      return
    fi
  fi
  printf '%s/suf\n' "$HOME"
}
update_project() { local dir; apk_install git; dir=$(project_dir); [[ ! -L $dir ]] || die "${dir} 是符号链接，拒绝更新。"; if [[ -d ${dir}/.git ]]; then [[ $(git -C "$dir" remote get-url origin 2>/dev/null || true) == "${APP_REPOSITORY}.git" ]] || die "远程仓库不是 SUF。"; [[ -z $(git -C "$dir" status --porcelain) ]] || die "仓库存在未提交修改。"; git -C "$dir" pull --ff-only; elif [[ -e $dir ]]; then die "${dir} 不是 SUF Git 仓库。"; else git clone --depth 1 "${APP_REPOSITORY}.git" "$dir"; fi; [[ -f ${dir}/install.sh ]] || die "仓库中缺少 install.sh。"; bash "${dir}/install.sh" --no-launch; ok "SUF Alpine 已更新。退出后重新执行 suf 即可使用新版本。"; }

