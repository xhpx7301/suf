    service=${init_script##*/}
    if rc-service "$service" status >/dev/null 2>&1; then
      printf '  %s\n' "$service"
      found=1
    fi
  done
  ((found)) || printf '  没有检测到正在运行的 OpenRC 服务。\n'
}

