usage() { cat <<EOF
SUF ${APP_VERSION} - Alpine 服务器安全管理

用法：
  suf               打开 Alpine 安全管理菜单
  suf menu          打开 Alpine 安全管理菜单
  suf status        查看 SSH、nftables、Fail2ban 状态
  suf services      查看运行中的 OpenRC 服务和监听端口
  suf --version     显示版本
  suf --help        显示帮助

项目：${APP_REPOSITORY}
EOF
}

main() { case ${1:-menu} in -V|--version|version) printf 'suf %s\n' "$APP_VERSION";; -h|--help|help) usage;; menu|"") require_root "$@"; load_os; menu;; status) require_root "$@"; load_os; show_status;; services) require_root "$@"; load_os; show_runtime_status;; *) usage >&2; exit 2;; esac; }
[[ ${BASH_SOURCE[0]} == "$0" ]] && main "$@"
