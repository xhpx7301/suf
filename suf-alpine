#!/usr/bin/env bash
set -Eeuo pipefail

APP_VERSION="1.2.3"
APP_NAME="suf"
APP_REPOSITORY="https://github.com/xhpx7301/suf"
DEFAULT_SSH_PORT="28377"
SSH_MAIN="/etc/ssh/sshd_config"
SSH_DROPIN_DIR="/etc/ssh/sshd_config.d"
SSH_DROPIN="${SSH_DROPIN_DIR}/00-suf-hardening.conf"
BACKUP_ROOT="/var/backups/${APP_NAME}"
FAIL2BAN_JAIL_DIR="/etc/fail2ban/jail.d"
FAIL2BAN_JAIL_FILE="${FAIL2BAN_JAIL_DIR}/${APP_NAME}.local"
NFT_CONF="/etc/nftables.d/${APP_NAME}.nft"
NFT_MAIN="/etc/nftables.nft"
SSHD_BIN=""
LAST_CONFIGURED_USER=""
export LC_ALL=C

if [[ -t 1 ]]; then
  C_RED=$'\033[31m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_BLUE=$'\033[34m'; C_RESET=$'\033[0m'
else
  C_RED=""; C_GREEN=""; C_YELLOW=""; C_BLUE=""; C_RESET=""
fi

info() { printf '%s[INFO]%s %s\n' "$C_BLUE" "$C_RESET" "$*"; }
ok() { printf '%s[ OK ]%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn() { printf '%s[WARN]%s %s\n' "$C_YELLOW" "$C_RESET" "$*"; }
die() { printf '%s[FAIL]%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; exit 1; }
pause() { printf '\n'; read -r -p "按 Enter 返回菜单..." _; }
confirm() {
  local prompt=$1 answer
  while true; do
    if ! read -r -p "${prompt} [y/N，默认 N] " answer; then
      printf '\n' >&2
      return 1
    fi
    case "$answer" in
      [Yy]) return 0 ;;
      ""|[Nn]) return 1 ;;
      *) warn "请输入 y 或 n；直接按 Enter 默认为 n。" ;;
    esac
  done
}

require_root() {
  [[ $EUID -eq 0 ]] && return
  command -v doas >/dev/null 2>&1 || die "需要 root 权限，请使用 doas 或 root 执行 suf。"
  exec doas -- "$0" "$@"
}

load_os() {
  [[ -r /etc/os-release ]] || die "无法识别操作系统。"
  # shellcheck disable=SC1091
  source /etc/os-release
  [[ ${ID:-} == alpine ]] || die "Alpine 分支只能运行在 Alpine Linux。"
  command -v apk >/dev/null 2>&1 || die "未找到 apk。"
  command -v rc-service >/dev/null 2>&1 || die "未找到 OpenRC rc-service。"
  command -v rc-update >/dev/null 2>&1 || die "未找到 OpenRC rc-update。"
}

apk_install() {
  local missing=() package
  for package in "$@"; do
    apk info -e "$package" >/dev/null 2>&1 || missing+=("$package")
  done
  ((${#missing[@]} == 0)) && return
  info "安装软件包：${missing[*]}"
  apk add --no-cache "${missing[@]}"
}

user_home() { getent passwd "$1" | cut -d: -f6; }
user_is_admin() { id -nG "$1" 2>/dev/null | tr ' ' '\n' | grep -qx 'wheel'; }

ensure_openssh() {
  apk_install openssh
  command -v sshd >/dev/null 2>&1 || die "未找到 sshd。"
  SSHD_BIN=$(command -v sshd)
  rc-update add sshd default >/dev/null 2>&1 || true
  rc-service sshd start >/dev/null 2>&1 || true
}

find_sshd() {
  command -v sshd >/dev/null 2>&1 || return 1
  SSHD_BIN=$(command -v sshd)
}

effective_sshd_value() {
  # Consume all sshd output: exiting awk early can make sshd receive SIGPIPE.
  "$SSHD_BIN" -T 2>/dev/null | awk -v wanted="$1" '$1 == wanted && !found { print $2; found=1 }'
}
effective_sshd_values() { "$SSHD_BIN" -T 2>/dev/null | awk -v wanted="$1" '$1 == wanted { print $2 }'; }
current_ssh_port() { local port; port=$(effective_sshd_value port || true); printf '%s\n' "${port:-22}"; }
valid_port() { [[ $1 =~ ^[0-9]+$ ]] && ((10#$1 >= 1 && 10#$1 <= 65535)); }

prompt_port() {
  local default_port=$1 label=${2:-端口} entered
  while true; do
    read -r -p "${label} [${default_port}]：" entered
    entered=${entered:-$default_port}
    valid_port "$entered" && { printf '%s\n' "$((10#$entered))"; return; }
    warn "端口必须是 1 到 65535 的整数。"
  done
}

prompt_protocol() {
  local protocol
  while true; do
    read -r -p "协议 tcp/udp [tcp]：" protocol
    protocol=${protocol:-tcp}
    case "$protocol" in
      tcp|udp) printf '%s\n' "$protocol"; return ;;
      *) warn "协议只能是 tcp 或 udp。" ;;
    esac
  done
}

ensure_admin_user() {
  local target=$1
  [[ $target =~ ^[a-z_][a-z0-9_-]*$ ]] || die "用户名格式无效。"
  if [[ $target == root ]]; then return; fi
  if ! id "$target" >/dev/null 2>&1; then
    adduser -D "$target"
  fi
  addgroup "$target" wheel >/dev/null 2>&1 || true
  apk_install doas
  install -d -m 755 /etc/doas.d
  printf 'permit :wheel\n' >/etc/doas.d/00-suf.conf
  chmod 400 /etc/doas.d/00-suf.conf
}

validate_public_key() {
  local key=$1 tmp
  [[ $key != *$'\n'* ]] || return 1
  [[ $key =~ ^(ssh-ed25519|sk-ssh-ed25519@openssh.com)[[:space:]]+[A-Za-z0-9+/=]+([[:space:]].*)?$ ]] || return 1
  tmp=$(mktemp); printf '%s\n' "$key" >"$tmp"
  local result
  if ssh-keygen -lf "$tmp" >/dev/null 2>&1; then result=0; else result=$?; fi
  rm -f "$tmp"
  return "$result"
}

authorized_key_count() {
  local file=$1
  [[ -r $file ]] || { printf '0\n'; return; }
  awk '{for (i=1;i<NF;i++) if ($i ~ /^(ssh-ed25519|sk-ssh-ed25519@openssh.com)$/ && $(i+1)!="") {count++; break}} END {print count+0}' "$file"
}

install_public_key() {
  local target_user home ssh_dir auth_file public_key key_type key_body fingerprint
  printf '\n默认给 root 安装公钥，可直接获得完整管理权限；输入其他用户名则创建普通 wheel 管理员。\n'
  read -r -p "密钥登录用户名 [root]：" target_user
  target_user=${target_user:-root}
  ensure_admin_user "$target_user"
  home=$(user_home "$target_user")
  [[ -n $home && -d $home ]] || die "找不到 ${target_user} 的家目录。"
  printf '\n请准备登录设备上的 Ed25519 公钥；可使用已有公钥，也可在登录设备上生成新密钥对：\n'
  printf '  ssh-keygen -t ed25519 -a 100\n'
  printf '不要在服务器上生成登录密钥，私钥不要上传服务器或 GitHub。\n\n'
  read -r -p "准备好公钥后按 Enter 继续：" _
  read -r -p "粘贴 id_ed25519.pub 的完整单行内容：" public_key
  validate_public_key "$public_key" || die "公钥无效；仅接受 Ed25519 公钥。"
  ssh_dir="${home}/.ssh"; auth_file="${ssh_dir}/authorized_keys"
  install -d -m 700 -o "$target_user" -g "$target_user" "$ssh_dir"
  touch "$auth_file"; chown "$target_user:$target_user" "$auth_file"; chmod 600 "$auth_file"
  read -r key_type key_body _ <<<"$public_key"
  if awk -v type="$key_type" -v body="$key_body" '{for(i=1;i<NF;i++) if($i==type && $(i+1)==body) found=1} END {exit !found}' "$auth_file"; then
    warn "该公钥已存在，未重复写入。"
  else
    printf '%s\n' "$public_key" >>"$auth_file"
    ok "公钥已写入 ${auth_file}。"
  fi
  fingerprint=$(printf '%s\n' "$public_key" | ssh-keygen -lf - | awk '{print $2}')
  LAST_CONFIGURED_USER=$target_user
  printf '账号：%s\n指纹：%s\n' "$target_user" "$fingerprint"
  printf '\n请保持当前 SSH 会话不关闭，并在第二个终端测试：\n'
  printf '  ssh -p %s %s@服务器IP\n' "$(current_ssh_port)" "$target_user"
}

require_tested_key_login() {
  local target=$1 count home
  home=$(user_home "$target"); count=$(authorized_key_count "${home}/.ssh/authorized_keys")
  ((count > 0)) || die "账号 ${target} 没有有效的 Ed25519 公钥。"
  [[ $target == root ]] || user_is_admin "$target" || die "账号 ${target} 不在 wheel 管理组。"
  if [[ $target == root ]]; then
    warn "只有在第二个终端已用 root 密钥登录，并确认 whoami 输出 root 后才能继续。"
  else
    warn "只有在第二个终端已用 ${target} 的密钥登录并成功执行 doas -n true 后才能继续。"
  fi
  confirm "确认已完成上述测试吗？" || die "未确认测试，取消 SSH 加固。"
}

backup_ssh_config() {
  local stamp backup_dir; stamp=$(date +%Y%m%d-%H%M%S); backup_dir="${BACKUP_ROOT}/${stamp}"; mkdir -p "$backup_dir"
  cp -a "$SSH_MAIN" "${backup_dir}/sshd_config"
  if [[ -e $SSH_DROPIN ]]; then
    cp -a "$SSH_DROPIN" "${backup_dir}/00-suf-hardening.conf"
  else
    : >"${backup_dir}/dropin-was-absent"
  fi
  if [[ -d $SSH_DROPIN_DIR ]]; then
    cp -a "$SSH_DROPIN_DIR" "${backup_dir}/sshd_config.d"
  else
    : >"${backup_dir}/dropin-dir-was-absent"
  fi
  printf '%s\n' "$backup_dir"
}

restore_ssh_backup() {
  local dir=$1; cp -a "${dir}/sshd_config" "$SSH_MAIN"
  if [[ -e ${dir}/dropin-dir-was-absent ]]; then
    rm -rf "$SSH_DROPIN_DIR"
  elif [[ -d ${dir}/sshd_config.d ]]; then
    rm -rf "$SSH_DROPIN_DIR"
    cp -a "${dir}/sshd_config.d" "$SSH_DROPIN_DIR"
  elif [[ -e ${dir}/dropin-was-absent ]]; then
    rm -f "$SSH_DROPIN"
  else
    cp -a "${dir}/00-suf-hardening.conf" "$SSH_DROPIN"
  fi
}

ssh_config_includes_dropin_dir() {
  local escaped_dir=${SSH_DROPIN_DIR//./\\.}
  grep -qE "^[[:space:]]*[Ii][Nn][Cc][Ll][Uu][Dd][Ee][[:space:]]+${escaped_dir}/\\*" "$SSH_MAIN"
}

remove_suf_managed_include() {
  local tmp
  grep -q '^# BEGIN SUF managed include$' "$SSH_MAIN" || return
  tmp=$(mktemp)
  awk '$0 == "# BEGIN SUF managed include" { skip = 1; next } $0 == "# END SUF managed include" { skip = 0; next } !skip { print }' "$SSH_MAIN" >"$tmp"
  install -m 600 -o root -g root "$tmp" "$SSH_MAIN"
  rm -f "$tmp"
}

ensure_dropin_include_first() {
  local tmp
  if ssh_config_includes_dropin_dir; then
    remove_suf_managed_include
    return
  fi
  head -n 4 "$SSH_MAIN" | grep -q '^# BEGIN SUF managed include$' && return
  tmp=$(mktemp); { printf '# BEGIN SUF managed include\nInclude %s\n# END SUF managed include\n' "$SSH_DROPIN"; cat "$SSH_MAIN"; } >"$tmp"
  install -m 600 -o root -g root "$tmp" "$SSH_MAIN"; rm -f "$tmp"
}

active_foreign_ssh_port_directives() {
  local file
  while IFS= read -r -d '' file; do
    [[ $file == "$SSH_DROPIN" ]] && continue
    awk -v file="$file" '/^[[:space:]]*[Pp][Oo][Rr][Tt][[:space:]]+/ { printf "%s:%d:%s\\n", file, NR, $0 }' "$file"
  done < <(
    printf '%s\0' "$SSH_MAIN"
    if [[ -d $SSH_DROPIN_DIR ]]; then
      find "$SSH_DROPIN_DIR" -maxdepth 1 -type f -name '*.conf' -print0
    fi
  )
}

disable_foreign_ssh_port_directives() {
  local file
  while IFS= read -r -d '' file; do
    [[ $file == "$SSH_DROPIN" ]] && continue
    if grep -qE '^[[:space:]]*[Pp][Oo][Rr][Tt][[:space:]]+' "$file"; then
      sed -i -E 's/^[[:space:]]*([Pp][Oo][Rr][Tt][[:space:]]+)/# Disabled by SUF when setting SSH port: &/' "$file"
    fi
  done < <(
    printf '%s\0' "$SSH_MAIN"
    if [[ -d $SSH_DROPIN_DIR ]]; then
      find "$SSH_DROPIN_DIR" -maxdepth 1 -type f -name '*.conf' -print0
    fi
  )
}

reload_ssh() { "$SSHD_BIN" -t || return 1; rc-service sshd reload >/dev/null 2>&1 || rc-service sshd restart; }

write_sshd_hardening() {
  local port=$1 target=$2 backup_dir permit_root effective
  permit_root=$([[ $target == root ]] && printf 'prohibit-password' || printf 'no')
  backup_dir=$(backup_ssh_config); mkdir -p "$SSH_DROPIN_DIR"; ensure_dropin_include_first
  cat >"$SSH_DROPIN" <<EOF
# Managed by SUF ${APP_VERSION}
Port ${port}
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
ChallengeResponseAuthentication no
PermitEmptyPasswords no
AuthenticationMethods publickey
PermitRootLogin ${permit_root}
MaxAuthTries 3
LoginGraceTime 30
EOF
  chmod 600 "$SSH_DROPIN"; chown root:root "$SSH_DROPIN"
  if ! "$SSHD_BIN" -t; then restore_ssh_backup "$backup_dir"; die "SSH 配置校验失败，已恢复原配置。"; fi
  effective=$($SSHD_BIN -T -C "user=root,host=$(hostname),addr=127.0.0.1")
  grep -qx "port ${port}" <<<"$effective" || { restore_ssh_backup "$backup_dir"; die "SSH 端口未生效，已恢复原配置。"; }
  if ! reload_ssh; then restore_ssh_backup "$backup_dir"; reload_ssh || true; die "SSH 重载失败，已恢复原配置。"; fi
  info "SSH 配置备份：${backup_dir}"
}

write_sshd_port() {
  local port=$1 backup_dir effective_ports tmp
  backup_dir=$(backup_ssh_config); mkdir -p "$SSH_DROPIN_DIR"; ensure_dropin_include_first; tmp=$(mktemp)
  if [[ -e $SSH_DROPIN ]]; then
    awk -v port="$port" 'tolower($1)=="port" {if(!written++) print "Port " port; next} {print} END {if(!written) print "Port " port}' "$SSH_DROPIN" >"$tmp"
  else
    printf '# Managed by SUF %s\nPort %s\n' "$APP_VERSION" "$port" >"$tmp"
  fi
  install -m 600 -o root -g root "$tmp" "$SSH_DROPIN"; rm -f "$tmp"
  if ! disable_foreign_ssh_port_directives; then
    warn "无法禁用其它 SSH Port 配置，正在自动恢复。"
    restore_ssh_backup "$backup_dir"
    die "没有应用任何 SSH 端口变更。"
  fi
  if ! "$SSHD_BIN" -t; then
    warn "sshd 配置校验失败，正在自动恢复。"
    restore_ssh_backup "$backup_dir"
    "$SSHD_BIN" -t || die "旧配置恢复后仍无法通过校验，请保持当前会话并人工检查 ${SSH_MAIN}。"
    die "没有应用任何 SSH 变更。"
  fi
  effective_ports=$(effective_sshd_values port)
  if [[ $effective_ports != "$port" ]]; then
    warn "最终 SSH 端口未收敛为 TCP/${port}，当前生效端口：${effective_ports//$'\n'/, }。正在自动恢复。"
    restore_ssh_backup "$backup_dir"
    "$SSHD_BIN" -t || die "恢复后的旧配置无法通过校验。"
    die "没有应用任何 SSH 变更。"
  fi
  if ! reload_ssh; then
    warn "SSH 配置重新加载失败，正在自动恢复。"
    restore_ssh_backup "$backup_dir"
    reload_ssh || die "自动恢复失败；不要关闭当前 SSH 会话。"
    die "SSH 端口变更已撤销。"
  fi
  ok "SSH 端口已修改为 ${port}，认证策略未做改变。"
  info "原 SSH 配置备份位于 ${backup_dir}。"
  warn "不要关闭当前会话。请在新终端测试：ssh -p ${port} 用户名@服务器IP"
}

show_ssh_status() {
  local service_state config root_config port login_grace max_auth root_login pubkey password kbd auth_methods
  local root_text pubkey_text password_text kbd_text auth_text summary
  if ! find_sshd; then
    printf 'SSH 服务：未安装\n'
    return
  fi

  if rc-service sshd status >/dev/null 2>&1; then service_state='运行中'; else service_state='已停止或启动失败'; fi
  config=$("$SSHD_BIN" -T 2>/dev/null) || die "无法读取 SSH 生效配置。"
  root_config=$("$SSHD_BIN" -T -C "user=root,host=$(hostname),addr=127.0.0.1" 2>/dev/null) || root_config=$config
  port=$(awk '$1 == "port" { ports = ports ? ports ", " $2 : $2 } END { print ports }' <<<"$config")
  login_grace=$(awk '$1 == "logingracetime" {print $2; exit}' <<<"$config")
  max_auth=$(awk '$1 == "maxauthtries" {print $2; exit}' <<<"$config")
  pubkey=$(awk '$1 == "pubkeyauthentication" {print $2; exit}' <<<"$config")
  password=$(awk '$1 == "passwordauthentication" {print $2; exit}' <<<"$config")
  kbd=$(awk '$1 == "kbdinteractiveauthentication" {print $2; exit}' <<<"$config")
  auth_methods=$(awk '$1 == "authenticationmethods" {print $2; exit}' <<<"$config")
  root_login=$(awk '$1 == "permitrootlogin" {print $2; exit}' <<<"$root_config")

  case "$root_login" in
    no) root_text='已禁止' ;;
    prohibit-password|without-password) root_text='仅允许密钥（符合默认模式）' ;;
    forced-commands-only) root_text='仅允许强制命令（受限）' ;;
    yes) root_text='未限制（风险，取决于其他认证设置）' ;;
    *) root_text=${root_login:-未知} ;;
  esac
  [[ $pubkey == yes ]] && pubkey_text='已启用' || pubkey_text='未启用（风险）'
  [[ $password == no ]] && password_text='已禁止（安全）' || password_text='允许（建议关闭）'
  [[ $kbd == no ]] && kbd_text='已禁止（安全）' || kbd_text='允许（建议关闭）'
  case "$auth_methods" in
    publickey) auth_text='仅允许公钥' ;;
    any) auth_text='任意可用认证方式' ;;
    *) auth_text=${auth_methods:-未知} ;;
  esac
  if [[ $service_state != 运行中 ]]; then
    summary='SSH 服务未正常运行'
  elif [[ ($root_login == no || $root_login == prohibit-password || $root_login == without-password) && $pubkey == yes && $password == no && $kbd == no && $auth_methods == publickey ]]; then
    [[ $root_login == no ]] && summary='Root 登录已禁止，所有密码认证均已禁止' || summary='Root 仅可使用密钥登录，所有密码认证均已禁止'
  else
    summary='存在未加固项目，请检查标注为“风险”或“建议关闭”的设置'
  fi

  printf 'SSH 服务状态\n'
  printf '  服务名称：sshd\n'
  printf '  运行状态：%s\n' "$service_state"
  printf '  监听端口：%s\n' "${port:-未知}"
  printf '  登录等待时间：%s 秒\n' "${login_grace:-未知}"
  printf '  最大认证尝试：%s 次\n' "${max_auth:-未知}"
  printf '\nSSH 认证安全\n'
  printf '  Root 登录策略：%s\n' "$root_text"
  printf '  公钥认证：%s\n' "$pubkey_text"
  printf '  密码认证：%s\n' "$password_text"
  printf '  键盘交互认证：%s\n' "$kbd_text"
  printf '  强制认证方式：%s\n' "$auth_text"
  printf '\n安全判断：%s\n' "$summary"
}

install_openssh_service() { ensure_openssh; "$SSHD_BIN" -t; rc-service sshd start; ok "OpenSSH 服务已安装并启动。"; }

enable_key_only_login() {
  local current_port target
  ensure_openssh
  current_port=$(current_ssh_port)
  read -r -p "已验证密钥登录的用户名 [root]：" target
  target=${target:-root}
  require_tested_key_login "$target"
  warn "应用后将禁止所有 SSH 密码和键盘交互认证，只保留公钥登录；当前端口 ${current_port} 不变。"
  write_sshd_hardening "$current_port" "$target"
}

reload_ssh_service() {
  ensure_openssh
  "$SSHD_BIN" -t
  reload_ssh
  ok "SSH 配置校验通过并已重新加载。"
}

restore_latest_ssh_backup() {
  local backup_file backup_dir
  ensure_openssh
  [[ -d $BACKUP_ROOT ]] || die "没有找到 SSH 配置备份。"
  backup_file=$(find "$BACKUP_ROOT" -type f -name sshd_config 2>/dev/null | sort | tail -n 1)
  [[ -n $backup_file ]] || die "没有找到 SSH 配置备份。"
  backup_dir=${backup_file%/sshd_config}
  warn "将恢复最新备份：${backup_dir}"
  confirm "确认恢复吗？" || die "取消操作。"
  restore_ssh_backup "$backup_dir"
  "$SSHD_BIN" -t || die "备份配置校验失败，未重新加载 SSH。"
  reload_ssh
  ok "已恢复 ${backup_dir}。请保持当前会话并测试新连接。"
}

change_ssh_port() {
  local current target active_ports foreign_directives
  ensure_openssh
  current=$(current_ssh_port)
  target=$(prompt_port "$DEFAULT_SSH_PORT" "新的 SSH 端口")
  active_ports=$(effective_sshd_values port)
  foreign_directives=$(active_foreign_ssh_port_directives)
  [[ $target != "$current" || $active_ports != "$target" ]] || { info "目标端口与当前端口相同，未做修改。"; return; }
  warn "请先确认云厂商安全组已放行 TCP/${target}。"
  confirm "已经放行或服务器没有外部安全组吗？" || die "取消操作。"
  if [[ -n $foreign_directives ]]; then
    warn "检测到以下额外的 SSH Port 配置："
    printf '%s\n' "$foreign_directives"
    warn "继续后将注释以上配置，仅保留 TCP/${target}。"
    confirm "确认仅保留新的 SSH 端口吗？" || die "取消操作。"
  fi
  if command -v nft >/dev/null 2>&1 && nft_table_exists; then
    if nft list chain inet suf input 2>/dev/null | grep -Eq "tcp dport ${target}([[:space:]]|$)"; then
      info "nftables 已有 TCP/${target} 放行规则。"
    else
      nft add rule inet suf input tcp dport "$target" accept comment "SUF SSH"
      nft list table inet suf >"$NFT_CONF"
      nft_persistence
      ok "nftables 已放行 TCP/${target}，原 SSH 端口规则暂时保留。"
    fi
  else
    warn "未检测到正在生效的 SUF nftables 规则，脚本无法自动放行新端口。"
    confirm "仍要继续修改 SSH 端口吗？" || die "取消操作。"
  fi
  write_sshd_port "$target"
}

nft_table_exists() { nft list table inet suf >/dev/null 2>&1; }
nft_persistence() {
  install -d -m 755 /etc/nftables.d
  touch "$NFT_MAIN"
  grep -Fqx "include \"${NFT_CONF}\"" "$NFT_MAIN" || printf '\ninclude "%s"\n' "$NFT_CONF" >>"$NFT_MAIN"
}
nft_disable_persistence() {
  [[ -f $NFT_MAIN ]] || return 0
  local tmp; tmp=$(mktemp)
  grep -Fvx "include \"${NFT_CONF}\"" "$NFT_MAIN" >"$tmp" || true
  install -m 600 -o root -g root "$tmp" "$NFT_MAIN"; rm -f "$tmp"
}
nft_write_base() {
  local ssh_port=$1 extra=${2:-}
  install -d -m 755 /etc/nftables.d
  cat >"$NFT_CONF" <<EOF
table inet suf {
  chain input {
    type filter hook input priority -100; policy drop;
    iifname "lo" accept
    ct state established,related accept
    ip protocol icmp accept
    ip6 nexthdr icmpv6 accept
    tcp dport ${ssh_port} accept comment "SUF SSH"
${extra}
  }
  chain output { type filter hook output priority 100; policy accept; }
}
EOF
  nft delete table inet suf 2>/dev/null || true
  nft -f "$NFT_CONF"
  nft_persistence
}

require_nftables() { command -v nft >/dev/null 2>&1 || die "nftables 尚未安装，请先选择安装。"; }
install_nftables_service() { apk_install nftables; nft_persistence; rc-update add nftables default >/dev/null 2>&1 || true; ok "nftables 已安装。"; }
enable_nftables_service() {
  local port; require_nftables; ensure_openssh; port=$(current_ssh_port); nft_write_base "$port"; rc-service nftables start >/dev/null 2>&1 || true; ok "nftables 已启用，SSH 端口 ${port} 已放行。";
}
disable_nftables_service() { require_nftables; confirm "确认关闭 nftables 吗？" || die "取消关闭。"; nft delete table inet suf 2>/dev/null || true; nft_disable_persistence; ok "SUF nftables 防火墙规则已移除。"; }
uninstall_nftables_service() { require_nftables; confirm "确认卸载 nftables 并保留配置吗？" || die "取消卸载。"; nft delete table inet suf 2>/dev/null || true; nft_disable_persistence; rc-service nftables stop >/dev/null 2>&1 || true; apk del nftables; ok "nftables 已卸载。"; }
show_nftables_status() { if ! command -v nft >/dev/null 2>&1; then printf 'nftables：未安装\n'; elif nft_table_exists; then printf 'nftables：SUF 规则运行中\n'; nft list table inet suf; else printf 'nftables：未启用 SUF 规则\n'; fi; }
reload_nftables() { require_nftables; [[ -f $NFT_CONF ]] || die "未找到 SUF nftables 配置。"; nft delete table inet suf 2>/dev/null || true; nft -f "$NFT_CONF"; ok "nftables 规则已重新加载。"; }
allow_nft_port_value() {
  local port=$1 protocol=$2 comment=${3:-SUF extra}
  require_nftables
  nft_table_exists || die "SUF nftables 规则尚未启用，请先选择启用 nftables。"
  if nft list chain inet suf input 2>/dev/null | grep -Eq "${protocol} dport ${port}([[:space:]]|$)"; then
    warn "已存在 ${port}/${protocol} 的放行规则，未重复添加。"
    return
  fi
  nft add rule inet suf input "$protocol" dport "$port" accept comment "$comment"
  nft list table inet suf >"$NFT_CONF"
  nft_persistence
  ok "已放行 ${port}/${protocol}。"
}

allow_nft_port() {
  local port protocol
  port=$(prompt_port 443 "要放行的端口")
  protocol=$(prompt_protocol)
  allow_nft_port_value "$port" "$protocol"
}

public_listening_candidates() {
  if command -v ss >/dev/null 2>&1; then
    ss -H -lntu 2>/dev/null | awk '
      $1 ~ /^(tcp|udp)$/ {
        local_address = $5
        port = local_address
        sub(/^.*:/, "", port)
        host = local_address
        sub(/:[^:]*$/, "", host)
        gsub(/^\[/, "", host)
        gsub(/\]$/, "", host)
        if (host !~ /^127\./ && host != "::1") {
          printf "%s %s %s\n", $1, port, host
        }
      }
    ' | sort -u
  else
    netstat -lntu 2>/dev/null | awk '
      $1 ~ /^(tcp|udp)/ {
        protocol = $1
        sub(/[0-9]+$/, "", protocol)
        local_address = $4
        port = local_address
        sub(/^.*:/, "", port)
        host = local_address
        sub(/:[^:]*$/, "", host)
        gsub(/^\[/, "", host)
        gsub(/\]$/, "", host)
        if (host !~ /^127\./ && host != "::1") {
          printf "%s %s %s\n", protocol, port, host
        }
      }
    ' | sort -u
  fi
}

is_public_listening_port() {
  local port=$1 protocol=$2
  public_listening_candidates | awk -v wanted_port="$port" -v wanted_protocol="$protocol" '
    $1 == wanted_protocol && $2 == wanted_port { found = 1 }
    END { exit !found }
  '
}

show_listening_ports() {
  local offer_allow=${1:-yes} candidates port protocol
  command -v ss >/dev/null 2>&1 || command -v netstat >/dev/null 2>&1 || die "未找到 ss 或 netstat，无法查询监听端口。"
  printf '以下是实际监听的服务与端口，不代表已被 nftables 放行：\n\n'
  candidates=$(public_listening_candidates || true)
  if [[ -n $candidates ]]; then
    printf '可考虑对公网放行的监听端口（协议 / 端口 / 绑定地址）：\n'
    awk '{ printf "  %-4s %-7s %s\n", $1, $2, $3 }' <<<"$candidates"
    printf '\n'
  else
    printf '没有检测到对公网或指定网卡监听的端口。\n\n'
  fi
  printf '完整监听详情（最后一列为进程/服务）：\n'
  if command -v ss >/dev/null 2>&1; then ss -lntup; else netstat -lntup; fi

  [[ $offer_allow == yes ]] || return
  if ! command -v nft >/dev/null 2>&1 || ! nft_table_exists; then
    info "启用 SUF nftables 规则后，可从此处选择监听端口加入放行规则。"
    return
  fi
  [[ -n $candidates ]] || return
  confirm "要从上述公网监听端口中选择一个加入 nftables 放行规则吗？" || return
  read -r -p "输入要放行的端口号：" port
  valid_port "$port" || die "端口必须是 1 到 65535 的整数。"
  port=$((10#$port))
  protocol=$(prompt_protocol)
  is_public_listening_port "$port" "$protocol" || die "未检测到 ${port}/${protocol} 的公网监听；仅本机监听的服务不能通过此菜单开放。"
  allow_nft_port_value "$port" "$protocol" "SUF listening service"
}

show_running_services() {
