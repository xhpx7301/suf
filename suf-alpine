    source /etc/os-release
    os_name=${PRETTY_NAME:-Alpine Linux}
  fi
  printf '\n系统：%s\n\n' "$os_name"
  show_ssh_status
  printf '\n'
  show_nftables_status
  printf '\n'
  show_fail2ban_status
  printf '\n'
  show_security_consistency_check
}

