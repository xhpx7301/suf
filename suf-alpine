ensure_alpine_syslog() {
  local service="" probe="SUF-syslog-probe-$$"
  if [[ -x /etc/init.d/syslog ]]; then
    service=syslog
  elif [[ -x /etc/init.d/syslog-ng ]]; then
    service=syslog-ng
  else
    info "未找到 Alpine syslog 服务，尝试安装 syslog-ng。"
    apk_install syslog-ng
    service=syslog-ng
  fi

  rc-update add "$service" boot >/dev/null 2>&1 || true
  rc-service "$service" start >/dev/null 2>&1 || rc-service "$service" restart >/dev/null 2>&1 || die "无法启动 ${service}。"
  install -d -m 755 /var/log
  [[ -e /var/log/messages ]] || touch /var/log/messages

  if command -v logger >/dev/null 2>&1; then
    logger -t suf "$probe" || true
    for _ in 1 2 3 4 5; do
      grep -Fq "$probe" /var/log/messages 2>/dev/null && return
      sleep 1
    done
  fi
  die "syslog 已启动，但没有确认日志写入 /var/log/messages；未配置 Fail2ban。"
}

fail2ban_jail_value() {
  local key=$1
  [[ -r $FAIL2BAN_JAIL_FILE ]] || return 0
  awk -v wanted="$key" '
    BEGIN { in_sshd = 0 }
    /^[[:space:]]*[#;]/ { next }
    /^[[:space:]]*\[/ {
      section = $0
      sub(/^[[:space:]]*\[/, "", section)
      sub(/\].*$/, "", section)
      in_sshd = (tolower(section) == "sshd")
      next
    }
    in_sshd && $0 ~ /^[[:space:]]*[^=]+=/ {
      line = $0
      k = line
      sub(/[[:space:]]*=.*$/, "", k)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", k)
      if (tolower(k) == tolower(wanted)) {
        v = line
        sub(/^[^=]*=[[:space:]]*/, "", v)
        gsub(/[[:space:]]+$/, "", v)
        print v
        exit
      }
    }
  ' "$FAIL2BAN_JAIL_FILE"
}

merge_fail2ban_ignoreip() {
  local existing="" client_ip="" raw_tokens=() item merged=()
  if [[ -r $FAIL2BAN_JAIL_FILE ]]; then
    existing=$(awk '
      /^[[:space:]]*[#;]/ { next }
      tolower($0) ~ /^[[:space:]]*ignoreip[[:space:]]*=/ {
        v = $0
        sub(/^[^=]*=[[:space:]]*/, "", v)
        gsub(/,/, " ", v)
        out = out (out ? " " : "") v
      }
      END { print out }
    ' "$FAIL2BAN_JAIL_FILE")
  fi
  client_ip=$(current_ssh_client_ip || true)
  raw_tokens=("127.0.0.1/8" "::1")
  if [[ -n $existing ]]; then
    for item in $existing; do
      raw_tokens+=("$item")
    done
  fi
  for item in "$@"; do
    item=${item//,/ }
    for item in $item; do
      raw_tokens+=("$item")
    done
  done
  if [[ -n $client_ip ]]; then
    raw_tokens+=("$client_ip")
    if [[ $client_ip =~ ^::[fF]{4}:([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+)$ ]]; then
      raw_tokens+=("${BASH_REMATCH[1]}")
    fi
  fi
  for item in "${raw_tokens[@]}"; do
    [[ -n $item ]] || continue
    local seen=0 existing_item
    for existing_item in "${merged[@]:-}"; do
      if [[ $existing_item == "$item" ]]; then
        seen=1
        break
      fi
    done
    ((seen == 0)) && merged+=("$item")
  done
  printf '%s\n' "${merged[*]}"
}

prompt_fail2ban_ignoreip() {
  local default_ignoreip=$1 raw token tokens valid_tokens=()
  while true; do
    if ! read -r -p "白名单 IP（空格分隔，含当前连接保护）[${default_ignoreip}]：" raw; then
      printf '\n' >&2
      return 1
    fi
    raw=${raw:-$default_ignoreip}
    raw=${raw//,/ }
    valid_tokens=()
    local all_ok=1
    for token in $raw; do
      if ! valid_ip_or_cidr "$token"; then
        warn "白名单 IP 格式无效：${token}。"
        all_ok=0
        break
      fi
      valid_tokens+=("$token")
    done
    if ((all_ok == 1 && ${#valid_tokens[@]} > 0)); then
      local out=("127.0.0.1/8" "::1")
      for token in "${valid_tokens[@]}"; do
        local seen=0 existing_item
        for existing_item in "${out[@]}"; do
          [[ $existing_item == "$token" ]] && { seen=1; break; }
        done
        ((seen == 0)) && out+=("$token")
      done
      printf '%s\n' "${out[*]}"
      return
    fi
    ((all_ok == 0)) || warn "白名单不能为空，至少保留 127.0.0.1/8 ::1。"
  done
}

ensure_fail2ban_client_protection() {
  local ssh_port ignoreip_list client_ip tmp
  if [[ ! -f /var/log/messages ]] || { ! rc-service syslog status >/dev/null 2>&1 && ! rc-service syslog-ng status >/dev/null 2>&1; }; then
    ensure_alpine_syslog
  fi
  ssh_port=$(current_ssh_port)
  client_ip=$(current_ssh_client_ip || true)
  ignoreip_list=$(merge_fail2ban_ignoreip)
  mkdir -p "$FAIL2BAN_JAIL_DIR"

  if [[ ! -e $FAIL2BAN_JAIL_FILE ]]; then
    cat >"$FAIL2BAN_JAIL_FILE" <<EOF
# Managed by SUF: protect current SSH session and enable Alpine /var/log/messages sshd jail.
[sshd]
enabled = true
port = ${ssh_port}
backend = auto
logpath = /var/log/messages
ignoreip = ${ignoreip_list}
EOF
    chmod 600 "$FAIL2BAN_JAIL_FILE"
    chown root:root "$FAIL2BAN_JAIL_FILE"
  else
    tmp=$(mktemp)
    awk -v new_ignore="$ignoreip_list" '
      BEGIN { in_sshd = 0; seen_sshd = 0; wrote_ignore = 0 }
      /^[[:space:]]*\[/ {
        if (in_sshd && !wrote_ignore) {
          print "ignoreip = " new_ignore
          wrote_ignore = 1
        }
        section = $0
        sub(/^[[:space:]]*\[/, "", section)
        sub(/\].*$/, "", section)
        in_sshd = (tolower(section) == "sshd")
        if (in_sshd) seen_sshd = 1
        print
        next
      }
      in_sshd && tolower($0) ~ /^[[:space:]]*ignoreip[[:space:]]*=/ {
        if (!wrote_ignore) {
          print "ignoreip = " new_ignore
          wrote_ignore = 1
        }
        next
      }
      { print }
      END {
        if (in_sshd && !wrote_ignore) {
          print "ignoreip = " new_ignore
        } else if (!seen_sshd) {
          print ""
          print "[sshd]"
          print "ignoreip = " new_ignore
        }
      }
    ' "$FAIL2BAN_JAIL_FILE" >"$tmp"
    install -m 600 -o root -g root "$tmp" "$FAIL2BAN_JAIL_FILE"
    rm -f "$tmp"
  fi

  if [[ -n $client_ip ]]; then
    info "已将当前 SSH 来源 IP（${client_ip}）加入 Fail2ban 白名单，防止启动扫描历史日志时误封。"
  fi
}

