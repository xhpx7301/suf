public_listening_candidates() {
  if command -v ss >/dev/null 2>&1; then
    ss -H -lntu 2>/dev/null | awk '
      $1 ~ /^(tcp|udp)$/ {
        local_address = $5
        port = local_address
        sub(/^.*:/, "", port)
        host = local_address
        sub(/:[^:]*$/, "", host)
        gsub(/^\[/, "", host)
        gsub(/\]$/, "", host)
        if (host !~ /^127\./ && host != "::1" && host !~ /^::[fF]{4}:127\./) {
          printf "%s %s %s\n", $1, port, host
        }
      }
    ' | sort -u
  else
    netstat -lntu 2>/dev/null | awk '
      $1 ~ /^(tcp|udp)/ {
        protocol = $1
        sub(/[0-9]+$/, "", protocol)
        local_address = $4
        port = local_address
        sub(/^.*:/, "", port)
        host = local_address
        sub(/:[^:]*$/, "", host)
        gsub(/^\[/, "", host)
        gsub(/\]$/, "", host)
        if (host !~ /^127\./ && host != "::1" && host !~ /^::[fF]{4}:127\./) {
          printf "%s %s %s\n", protocol, port, host
        }
      }
    ' | sort -u
  fi
}

is_public_listening_port() {
  local port=$1 protocol=$2
  public_listening_candidates | awk -v wanted_port="$port" -v wanted_protocol="$protocol" '
    $1 == wanted_protocol && $2 == wanted_port { found = 1 }
    END { exit !found }
  '
}

show_listening_ports() {
  local offer_allow=${1:-yes} candidates port protocols protocol comment default_selection snapshot
  command -v ss >/dev/null 2>&1 || command -v netstat >/dev/null 2>&1 || die "未找到 ss 或 netstat，无法查询监听端口。"
  printf '以下是实际监听的服务与端口，不代表已被 nftables 放行：\n\n'
  candidates=$(public_listening_candidates || true)
  if [[ -n $candidates ]]; then
    printf '可考虑对公网放行的监听端口（协议 / 端口 / 绑定地址）：\n'
    awk '{ printf "  %-4s %-7s %s\n", $1, $2, $3 }' <<<"$candidates"
    printf '\n'
  else
    printf '没有检测到对公网或指定网卡监听的端口。\n\n'
  fi
  printf '完整监听详情（最后一列为进程/服务）：\n'
  if command -v ss >/dev/null 2>&1; then ss -lntup; else netstat -lntup; fi

  [[ $offer_allow == yes ]] || return
  if ! command -v nft >/dev/null 2>&1; then
    info "安装 nftables 后，可从此处选择监听端口加入放行规则。"
    return
  fi
  [[ -n $candidates ]] || return
  info "可直接输入上述公网监听端口加入 nftables 放行规则；直接回车结束。"

  while true; do
    read -r -p "输入要放行的端口号（直接回车结束）：" port || return 0
    [[ -n $port ]] || return 0
    if ! valid_port "$port"; then
      warn "端口必须是 1 到 65535 的整数。"
      continue
    fi
    port=$((10#$port))
    if is_public_listening_port "$port" tcp && is_public_listening_port "$port" udp; then
      default_selection=1
    elif is_public_listening_port "$port" tcp; then
      default_selection=2
    elif is_public_listening_port "$port" udp; then
      default_selection=3
    else
      warn "未检测到 ${port} 的公网 TCP/UDP 监听；仅本机监听的服务不能通过此菜单开放。"
      continue
    fi
    protocols=$(prompt_allow_protocols "$default_selection")
    for protocol in $protocols; do
      if ! is_public_listening_port "$port" "$protocol"; then
        warn "未检测到 ${port}/${protocol} 的公网监听；仅本机监听的服务不能通过此菜单开放。"
        protocols=""
        break
      fi
    done
    [[ -n $protocols ]] || continue
    comment=$(prompt_rule_comment '从监听服务放行')
    nft_ensure_rules_file
    snapshot=$(mktemp)
    cp -a "$NFT_RULES_FILE" "$snapshot"
    for protocol in $protocols; do
      if nft_rule_exists_any_source "$protocol" "$port"; then
        warn "已存在 ${port}/${protocol} 的广泛放行或限速规则，未重复添加。"
      else
        nft_upsert_rule allow "$protocol" "$port" any "$comment"
        ok "已将正在监听的 ${port}/${protocol} 加入 nftables 放行规则。"
      fi
    done
    nft_validate_and_sync "$snapshot"
    rm -f "$snapshot"
    printf '\n'
    show_nftables_allowed_ports
    printf '\n'
  done
}

