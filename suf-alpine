}

require_tested_key_login() {
  local target=$1 count home
  home=$(user_home "$target"); count=$(authorized_key_count "${home}/.ssh/authorized_keys")
  ((count > 0)) || die "账号 ${target} 没有有效的 Ed25519 公钥。"
  if [[ $target == root ]]; then
    warn "只有在第二个终端已用 root 密钥登录，并确认 whoami 输出 root 后才能继续。"
  elif user_is_admin "$target"; then
    warn "只有在第二个终端已用 ${target} 的密钥登录并成功执行 doas -n true 后才能继续。"
  else
    warn "只有在第二个终端已用 ${target} 的密钥登录，并确认 whoami 输出 ${target} 后才能继续。"
  fi
  confirm "确认已完成上述测试吗？" || die "未确认测试，取消 SSH 加固。"
}

backup_ssh_config() {
  local stamp backup_dir; stamp=$(date +%Y%m%d-%H%M%S); backup_dir="${BACKUP_ROOT}/${stamp}"; mkdir -p "$backup_dir"
  cp -a "$SSH_MAIN" "${backup_dir}/sshd_config"
  if [[ -e $SSH_DROPIN ]]; then
    cp -a "$SSH_DROPIN" "${backup_dir}/00-suf-hardening.conf"
  else
    : >"${backup_dir}/dropin-was-absent"
  fi
  if [[ -d $SSH_DROPIN_DIR ]]; then
    cp -a "$SSH_DROPIN_DIR" "${backup_dir}/sshd_config.d"
  else
    : >"${backup_dir}/dropin-dir-was-absent"
  fi
  printf '%s\n' "$backup_dir"
}

restore_ssh_backup() {
  local dir=$1; cp -a "${dir}/sshd_config" "$SSH_MAIN"
  if [[ -e ${dir}/dropin-dir-was-absent ]]; then
    rm -rf "$SSH_DROPIN_DIR"
  elif [[ -d ${dir}/sshd_config.d ]]; then
    rm -rf "$SSH_DROPIN_DIR"
    cp -a "${dir}/sshd_config.d" "$SSH_DROPIN_DIR"
  elif [[ -e ${dir}/dropin-was-absent ]]; then
    rm -f "$SSH_DROPIN"
  else
    cp -a "${dir}/00-suf-hardening.conf" "$SSH_DROPIN"
  fi
}

ssh_config_includes_dropin_dir() {
  local escaped_dir=${SSH_DROPIN_DIR//./\\.}
  grep -qE "^[[:space:]]*[Ii][Nn][Cc][Ll][Uu][Dd][Ee][[:space:]]+${escaped_dir}/\\*" "$SSH_MAIN"
}

remove_suf_managed_include() {
  local tmp
  grep -q '^# BEGIN SUF managed include$' "$SSH_MAIN" || return 0
  tmp=$(mktemp)
  awk '$0 == "# BEGIN SUF managed include" { skip = 1; next } $0 == "# END SUF managed include" { skip = 0; next } !skip { print }' "$SSH_MAIN" >"$tmp"
  install -m 600 -o root -g root "$tmp" "$SSH_MAIN"
  rm -f "$tmp"
}

ensure_dropin_include_first() {
  local tmp
  if ssh_config_includes_dropin_dir; then
    remove_suf_managed_include
    return
  fi
  head -n 4 "$SSH_MAIN" | grep -q '^# BEGIN SUF managed include$' && return
  tmp=$(mktemp); { printf '# BEGIN SUF managed include\nInclude %s\n# END SUF managed include\n' "$SSH_DROPIN"; cat "$SSH_MAIN"; } >"$tmp"
  install -m 600 -o root -g root "$tmp" "$SSH_MAIN"; rm -f "$tmp"
}

active_foreign_ssh_port_directives() {
  local file
  while IFS= read -r -d '' file; do
    [[ $file == "$SSH_DROPIN" ]] && continue
    awk -v file="$file" '/^[[:space:]]*[Pp][Oo][Rr][Tt][[:space:]]+/ { printf "%s:%d:%s\\n", file, NR, $0 }' "$file"
  done < <(
    printf '%s\0' "$SSH_MAIN"
    if [[ -d $SSH_DROPIN_DIR ]]; then
      find "$SSH_DROPIN_DIR" -maxdepth 1 -type f -name '*.conf' -print0
    fi
  )
}

disable_foreign_ssh_port_directives() {
  local file
  while IFS= read -r -d '' file; do
    [[ $file == "$SSH_DROPIN" ]] && continue
    if grep -qE '^[[:space:]]*[Pp][Oo][Rr][Tt][[:space:]]+' "$file"; then
      sed -i -E 's/^[[:space:]]*([Pp][Oo][Rr][Tt][[:space:]]+)/# Disabled by SUF when setting SSH port: &/' "$file"
    fi
  done < <(
    printf '%s\0' "$SSH_MAIN"
    if [[ -d $SSH_DROPIN_DIR ]]; then
      find "$SSH_DROPIN_DIR" -maxdepth 1 -type f -name '*.conf' -print0
    fi
  )
}

reload_ssh() { "$SSHD_BIN" -t || return 1; rc-service sshd reload >/dev/null 2>&1 || rc-service sshd restart; }

write_sshd_hardening() {
  local port=$1 target=$2 backup_dir permit_root effective expected effective_root effective_ports
  permit_root=$([[ $target == root ]] && printf 'prohibit-password' || printf 'no')
  backup_dir=$(backup_ssh_config); mkdir -p "$SSH_DROPIN_DIR"; ensure_dropin_include_first
  cat >"$SSH_DROPIN" <<EOF
# Managed by SUF ${APP_VERSION}
Port ${port}
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
ChallengeResponseAuthentication no
PermitEmptyPasswords no
AuthenticationMethods publickey
PermitRootLogin ${permit_root}
MaxAuthTries 3
LoginGraceTime 30
EOF
  chmod 600 "$SSH_DROPIN"; chown root:root "$SSH_DROPIN"
  if ! disable_foreign_ssh_port_directives; then
    warn "无法禁用其它 SSH Port 配置，正在自动恢复。"
    restore_ssh_backup "$backup_dir"
    die "没有应用任何 SSH 变更。"
  fi
  if ! "$SSHD_BIN" -t; then
    warn "sshd 配置校验失败，正在自动恢复。"
    restore_ssh_backup "$backup_dir"
    "$SSHD_BIN" -t || die "旧配置恢复后仍无法通过校验，请保持当前会话并人工检查 ${SSH_MAIN}。"
    die "没有应用任何 SSH 变更。"
  fi
  effective_ports=$(effective_sshd_values port)
  if [[ $effective_ports != "$port" ]]; then
    warn "最终 SSH 端口未收敛为 TCP/${port}，当前生效端口：${effective_ports//$'\n'/, }。正在自动恢复。"
    restore_ssh_backup "$backup_dir"
    "$SSHD_BIN" -t || die "恢复后的旧配置无法通过校验。"
    die "没有应用任何 SSH 变更。"
  fi
  effective=$("$SSHD_BIN" -T -C "user=root,host=$(hostname),addr=127.0.0.1")
  for expected in \
    "port ${port}" \
    "pubkeyauthentication yes" \
    "passwordauthentication no" \
    "kbdinteractiveauthentication no" \
    "authenticationmethods publickey"; do
    if ! grep -qx "$expected" <<<"$effective"; then
      warn "最终 SSH 配置未生效：${expected}，正在自动恢复。"
      restore_ssh_backup "$backup_dir"
      "$SSHD_BIN" -t || die "恢复后的旧配置无法通过校验。"
      die "没有应用任何 SSH 变更。"
    fi
  done
  effective_root=$(awk '$1 == "permitrootlogin" {print $2; exit}' <<<"$effective")
  if [[ $target == root ]]; then
    if [[ $effective_root != prohibit-password && $effective_root != without-password ]]; then
      warn "Root 密钥登录策略未生效，正在自动恢复。"
      restore_ssh_backup "$backup_dir"
      "$SSHD_BIN" -t || die "恢复后的旧配置无法通过校验。"
      die "没有应用任何 SSH 变更。"
    fi
  elif [[ $effective_root != no ]]; then
    warn "禁止 Root 登录的策略未生效，正在自动恢复。"
    restore_ssh_backup "$backup_dir"
    "$SSHD_BIN" -t || die "恢复后的旧配置无法通过校验。"
    die "没有应用任何 SSH 变更。"
  fi
  if ! reload_ssh; then
    restore_ssh_backup "$backup_dir"
    reload_ssh || true
    die "SSH 重载失败，已恢复原配置。"
  fi
  if [[ $target == root ]]; then
    ok "SSH 已设置为 root 仅密钥登录，所有密码认证均已禁止。"
  else
    ok "SSH 已设置为 ${target} 仅密钥登录，Root 登录和所有密码认证均已禁止。"
  fi
  info "SSH 配置备份：${backup_dir}"
}

write_sshd_port() {
  local port=$1 backup_dir effective_ports tmp
  backup_dir=$(backup_ssh_config); mkdir -p "$SSH_DROPIN_DIR"; ensure_dropin_include_first; tmp=$(mktemp)
  if [[ -e $SSH_DROPIN ]]; then
    awk -v port="$port" 'tolower($1)=="port" {if(!written++) print "Port " port; next} {print} END {if(!written) print "Port " port}' "$SSH_DROPIN" >"$tmp"
  else
    printf '# Managed by SUF %s\nPort %s\n' "$APP_VERSION" "$port" >"$tmp"
  fi
  install -m 600 -o root -g root "$tmp" "$SSH_DROPIN"; rm -f "$tmp"
  if ! disable_foreign_ssh_port_directives; then
    warn "无法禁用其它 SSH Port 配置，正在自动恢复。"
    restore_ssh_backup "$backup_dir"
    die "没有应用任何 SSH 端口变更。"
  fi
  if ! "$SSHD_BIN" -t; then
    warn "sshd 配置校验失败，正在自动恢复。"
    restore_ssh_backup "$backup_dir"
    "$SSHD_BIN" -t || die "旧配置恢复后仍无法通过校验，请保持当前会话并人工检查 ${SSH_MAIN}。"
    die "没有应用任何 SSH 变更。"
  fi
  effective_ports=$(effective_sshd_values port)
  if [[ $effective_ports != "$port" ]]; then
    warn "最终 SSH 端口未收敛为 TCP/${port}，当前生效端口：${effective_ports//$'\n'/, }。正在自动恢复。"
    restore_ssh_backup "$backup_dir"
    "$SSHD_BIN" -t || die "恢复后的旧配置无法通过校验。"
    die "没有应用任何 SSH 变更。"
  fi
  if ! reload_ssh; then
    warn "SSH 配置重新加载失败，正在自动恢复。"
    restore_ssh_backup "$backup_dir"
    reload_ssh || die "自动恢复失败；不要关闭当前 SSH 会话。"
    die "SSH 端口变更已撤销。"
  fi
  ok "SSH 端口已修改为 ${port}，认证策略未做改变。"
  info "原 SSH 配置备份位于 ${backup_dir}。"
  warn "不要关闭当前会话。请在新终端测试：ssh -p ${port} 用户名@服务器IP"
}

show_ssh_status() {
  local service_state config root_config port login_grace max_auth root_login pubkey password kbd auth_methods
  local root_text pubkey_text password_text kbd_text auth_text summary
  if ! find_sshd; then
    printf 'SSH 服务：未安装\n'
    return
  fi

  if rc-service sshd status >/dev/null 2>&1; then service_state='运行中'; else service_state='已停止'; fi
  config=$("$SSHD_BIN" -T 2>/dev/null) || die "无法读取 SSH 生效配置。"
  root_config=$("$SSHD_BIN" -T -C "user=root,host=$(hostname),addr=127.0.0.1" 2>/dev/null) || root_config=$config
  port=$(awk '$1 == "port" { ports = ports ? ports ", " $2 : $2 } END { print ports }' <<<"$config")
  login_grace=$(awk '$1 == "logingracetime" {print $2; exit}' <<<"$config")
  max_auth=$(awk '$1 == "maxauthtries" {print $2; exit}' <<<"$config")
  pubkey=$(awk '$1 == "pubkeyauthentication" {print $2; exit}' <<<"$config")
  password=$(awk '$1 == "passwordauthentication" {print $2; exit}' <<<"$config")
  kbd=$(awk '$1 == "kbdinteractiveauthentication" {print $2; exit}' <<<"$config")
  auth_methods=$(awk '$1 == "authenticationmethods" {print $2; exit}' <<<"$config")
  root_login=$(awk '$1 == "permitrootlogin" {print $2; exit}' <<<"$root_config")

  case "$root_login" in
    no) root_text='已禁止' ;;
    prohibit-password|without-password) root_text='仅允许密钥（符合默认模式）' ;;
    forced-commands-only) root_text='仅允许强制命令（受限）' ;;
    yes) root_text='未限制（风险，取决于其他认证设置）' ;;
    *) root_text=${root_login:-未知} ;;
  esac
  [[ $pubkey == yes ]] && pubkey_text='已启用' || pubkey_text='未启用（风险）'
  [[ $password == no ]] && password_text='已禁止（安全）' || password_text='允许（建议关闭）'
  [[ $kbd == no ]] && kbd_text='已禁止（安全）' || kbd_text='允许（建议关闭）'
  case "$auth_methods" in
    publickey) auth_text='仅允许公钥' ;;
    any) auth_text='任意可用认证方式' ;;
    *) auth_text=${auth_methods:-未知} ;;
  esac
  if [[ $service_state != 运行中 ]]; then
    summary='SSH 服务未正常运行'
  elif [[ ($root_login == no || $root_login == prohibit-password || $root_login == without-password) && $pubkey == yes && $password == no && $kbd == no && $auth_methods == publickey ]]; then
    [[ $root_login == no ]] && summary='Root 登录已禁止，所有密码认证均已禁止' || summary='Root 仅可使用密钥登录，所有密码认证均已禁止'
  else
    summary='存在未加固项目，请检查标注为“风险”或“建议关闭”的设置'
  fi

  printf 'SSH 服务状态\n'
  printf '  服务名称：sshd\n'
  printf '  运行状态：%s\n' "$(colored_status "$service_state")"
  printf '  监听端口：%s\n' "${port:-未知}"
  printf '  登录等待时间：%s 秒\n' "${login_grace:-未知}"
  printf '  最大认证尝试：%s 次\n' "${max_auth:-未知}"
  printf '\nSSH 认证安全\n'
  printf '  Root 登录策略：%s\n' "$root_text"
  printf '  公钥认证：%s\n' "$pubkey_text"
  printf '  密码认证：%s\n' "$password_text"
  printf '  键盘交互认证：%s\n' "$kbd_text"
  printf '  强制认证方式：%s\n' "$auth_text"
  printf '\n安全判断：%s\n' "$summary"
}

install_openssh_service() { ensure_openssh; "$SSHD_BIN" -t; rc-service sshd start; ok "OpenSSH 服务已安装并启动。"; }

enable_key_only_login() {
  local current_port target
  ensure_openssh
  current_port=$(current_ssh_port)
  read -r -p "已验证密钥登录的用户名 [root]：" target
  target=${target:-root}
  require_tested_key_login "$target"
  warn "应用后将禁止所有 SSH 密码和键盘交互认证，只保留公钥登录；当前端口 ${current_port} 不变。"
  write_sshd_hardening "$current_port" "$target"
}

reload_ssh_service() {
  ensure_openssh
  "$SSHD_BIN" -t
  reload_ssh
  ok "SSH 配置校验通过并已重新加载。"
}

restore_latest_ssh_backup() {
  local backup_file backup_dir
  ensure_openssh
  [[ -d $BACKUP_ROOT ]] || die "没有找到 SSH 配置备份。"
  backup_file=$(find "$BACKUP_ROOT" -type f -name sshd_config 2>/dev/null | sort | tail -n 1)
  [[ -n $backup_file ]] || die "没有找到 SSH 配置备份。"
  backup_dir=${backup_file%/sshd_config}
  warn "将恢复最新备份：${backup_dir}"
  confirm "确认恢复吗？" || die "取消操作。"
  restore_ssh_backup "$backup_dir"
  "$SSHD_BIN" -t || die "备份配置校验失败，未重新加载 SSH。"
  reload_ssh
  ok "已恢复 ${backup_dir}。请保持当前会话并测试新连接。"
}

change_ssh_port() {
  local current target active_ports foreign_directives snapshot
  ensure_openssh
  current=$(current_ssh_port)
  target=$(prompt_port "$DEFAULT_SSH_PORT" "新的 SSH 端口")
  active_ports=$(effective_sshd_values port)
  foreign_directives=$(active_foreign_ssh_port_directives)
  [[ $target != "$current" || $active_ports != "$target" ]] || { info "目标端口与当前端口相同，未做修改。"; return; }
  warn "请先确认云厂商安全组已放行 TCP/${target}。"
  confirm "已经放行或服务器没有外部安全组吗？" || die "取消操作。"
  if [[ -n $foreign_directives ]]; then
    warn "检测到以下额外的 SSH Port 配置："
    printf '%s\n' "$foreign_directives"
    warn "继续后将注释以上配置，仅保留 TCP/${target}。"
    confirm "确认仅保留新的 SSH 端口吗？" || die "取消操作。"
  fi
  if command -v nft >/dev/null 2>&1; then
    nft_ensure_rules_file
    if nft_rule_exists_any_source tcp "$target"; then
      info "nftables 规则中已有 TCP/${target} 放行记录。"
    else
      snapshot=$(mktemp)
      cp -a "$NFT_RULES_FILE" "$snapshot"
      nft_upsert_rule allow tcp "$target" any "SUF SSH 管理"
      nft_validate_and_sync "$snapshot"
      rm -f "$snapshot"
      if nft_table_exists; then
        ok "nftables 已放行 TCP/${target}，原 SSH 端口规则暂时保留。"
      else
        info "已将 TCP/${target} 写入待应用的 SUF nftables 规则（当前 nftables 未启用）。"
      fi
    fi
  else
    warn "尚未安装 nftables，脚本无法自动放行新端口。"
    confirm "仍要继续修改 SSH 端口吗？" || die "取消操作。"
  fi
  write_sshd_port "$target"
  sync_fail2ban_ssh_port "$target"
}

pad_col() {
  local str=$1 target_cols=$2
  local stripped=${str//[ -~]/}
  local ascii_count=$((${#str} - ${#stripped}))
  local wide_count=$((${#stripped} / 3))
  local cols=$((ascii_count + wide_count * 2))
  printf '%s' "$str"
  while ((cols < target_cols)); do
    printf ' '
    ((cols += 1))
  done
}

nft_table_exists() { nft list table inet suf >/dev/null 2>&1; }

nft_backup_main_once() {
  [[ -f $NFT_MAIN ]] || return 0
  grep -q '^# Managed by SUF' "$NFT_MAIN" && return 0
  if [[ ! -e ${NFT_BACKUP_DIR}/nftables.nft.orig ]]; then
    install -d -m 700 -o root -g root "$NFT_BACKUP_DIR"
    cp -a "$NFT_MAIN" "${NFT_BACKUP_DIR}/nftables.nft.orig"
    info "原 ${NFT_MAIN} 已备份至 ${NFT_BACKUP_DIR}/nftables.nft.orig。"
  fi
}

nft_persistence() {
  local tmp
  install -d -m 755 "$(dirname "$NFT_CONF")"
  install -d -m 755 "$(dirname "$NFT_MAIN")"
  nft_backup_main_once
  tmp=$(mktemp)
  cat >"$tmp" <<EOF
#!/usr/sbin/nft -f
# Managed by SUF ${APP_VERSION} - original backed up under ${NFT_BACKUP_DIR}
include "${NFT_CONF}"
EOF
  install -m 700 -o root -g root "$tmp" "$NFT_MAIN"
  rm -f "$tmp"
}

nft_disable_persistence() {
  local tmp
  rm -f "$NFT_CONF"
  rc-update del nftables default >/dev/null 2>&1 || true
  [[ -f $NFT_MAIN ]] || return 0
  tmp=$(mktemp)
  if grep -q '^# Managed by SUF' "$NFT_MAIN"; then
    cat >"$tmp" <<'EOF'
#!/usr/sbin/nft -f
# Managed by SUF - disabled
EOF
  else
    grep -Fvx "include \"${NFT_CONF}\"" "$NFT_MAIN" >"$tmp" || true
  fi
  install -m 700 -o root -g root "$tmp" "$NFT_MAIN"
  rm -f "$tmp"
}

nft_handle_conflicting_filter_table() {
  nft list table inet filter >/dev/null 2>&1 || return 0
  warn "检测到内核中存在默认的 table inet filter（Alpine 默认规则会拒绝未显式放行的端口，可能拦截 SSH 新端口及 80/443）。"
  if confirm "移除冲突的 table inet filter，改由 SUF nftables 规则统一管理吗？"; then
    nft delete table inet filter 2>/dev/null || warn "移除 table inet filter 失败，请手动检查 nft list ruleset。"
    ok "已移除冲突的 table inet filter。"
  else
    warn "已保留 table inet filter；若端口访问异常，请检查 nft list table inet filter。"
  fi
}

nft_sort_rules_file() {
  [[ -f $NFT_RULES_FILE ]] || return 0
  [[ -s $NFT_RULES_FILE ]] || return 0
  local tmp
  tmp=$(mktemp)
  awk -F'|' '
    NF >= 4 && ($1 == "allow" || $1 == "limit") && ($2 == "tcp" || $2 == "udp") && $3 ~ /^[0-9]+$/ && $4 != "" {
      comment = $5
      for (i = 6; i <= NF; i++) comment = comment " " $i
      gsub(/["\\|]/, "", comment)
      if (comment == "") comment = "受 SUF 管理的服务"
      key = $1 "|" $2 "|" ($3 + 0) "|" $4
      if (!(key in seen)) {
        keys[++count] = key
        seen[key] = 1
      }
      entry[key] = $1 "|" $2 "|" ($3 + 0) "|" $4 "|" comment
    }
    END {
      for (i = 1; i <= count; i++) {
        k = keys[i]
        split(entry[k], f, "|")
        proto_rank = (f[2] == "tcp" ? 1 : 2)
        src_rank = (f[4] == "any" ? 1 : (f[4] ~ /:/ ? 3 : 2))
        act_rank = (f[1] == "allow" ? 1 : 2)
        printf "%010d|%d|%d|%s|%d|%s\n", f[3] + 0, proto_rank, src_rank, f[4], act_rank, entry[k]
      }
    }
  ' "$NFT_RULES_FILE" |
    sort -t '|' -k1,1n -k2,2n -k3,3n -k4,4 -k5,5n |
    cut -d '|' -f6- >"$tmp"
  install -m 600 -o root -g root "$tmp" "$NFT_RULES_FILE"
  rm -f "$tmp"
}

nft_migrate_legacy_rules() {
  local raw=""
  if nft_table_exists; then
    raw=$(nft list table inet suf 2>/dev/null || true)
  elif [[ -s $NFT_CONF ]]; then
    raw=$(cat "$NFT_CONF" 2>/dev/null || true)
  fi
  [[ -n $raw ]] || return 0
  awk '
    /^[[:space:]]*(table|chain|type[[:space:]]+filter|\}|\{|iifname|ct[[:space:]]+state[[:space:]]+established|ip[[:space:]]+protocol[[:space:]]+icmp|ip6[[:space:]]+nexthdr[[:space:]]+icmpv6)/ { next }
    {
      line = $0
      if (match(line, /(tcp|udp)[[:space:]]+dport[[:space:]]+[0-9]+/)) {
        dp = substr(line, RSTART, RLENGTH)
        split(dp, dp_parts, /[[:space:]]+/)
        proto = dp_parts[1]
        port = dp_parts[3]
      } else {
        next
      }
      action = (line ~ /limit[[:space:]]+rate/ ? "limit" : "allow")
      src = "any"
      if (match(line, /ip6?[[:space:]]+saddr[[:space:]]+[^[:space:]]+/)) {
        sa = substr(line, RSTART, RLENGTH)
        split(sa, sa_parts, /[[:space:]]+/)
        src = sa_parts[3]
      }
      comment = "已迁移规则"
      if (match(line, /comment[[:space:]]+"[^"]*"/)) {
        cm = substr(line, RSTART, RLENGTH)
        sub(/^comment[[:space:]]+"/, "", cm)
        sub(/"$/, "", cm)
        gsub(/["\\|]/, "", cm)
        if (cm != "") comment = cm
      }
      printf "%s|%s|%s|%s|%s\n", action, proto, port, src, comment
    }
  ' <<<"$raw" >"$NFT_RULES_FILE"
  nft_sort_rules_file
}

nft_ensure_rules_file() {
  if [[ ! -f $NFT_RULES_FILE ]]; then
    install -d -m 700 -o root -g root "$(dirname "$NFT_RULES_FILE")"
    : >"$NFT_RULES_FILE"
    chmod 600 "$NFT_RULES_FILE"
    chown root:root "$NFT_RULES_FILE"
    nft_migrate_legacy_rules
  fi
}

nft_rule_exists_any_source() {
  local protocol=$1 port=$2
  nft_ensure_rules_file
  awk -F'|' -v proto="$protocol" -v port="$port" '
    $2 == proto && ($3 + 0) == (port + 0) && $4 == "any" { found = 1 }
    END { exit !found }
  ' "$NFT_RULES_FILE"
}

nft_rule_exists_exact() {
  local action=$1 protocol=$2 port=$3 source=$4
  nft_ensure_rules_file
  awk -F'|' -v act="$action" -v proto="$protocol" -v port="$port" -v src="$source" '
    $1 == act && $2 == proto && ($3 + 0) == (port + 0) && $4 == src { found = 1 }
    END { exit !found }
  ' "$NFT_RULES_FILE"
}

nft_upsert_rule() {
  local action=$1 protocol=$2 port=$3 source=$4 comment=$5
  nft_ensure_rules_file
  printf '%s|%s|%s|%s|%s\n' "$action" "$protocol" "$((10#$port))" "$source" "$comment" >>"$NFT_RULES_FILE"
  nft_sort_rules_file
}

nft_render_config() {
  local output_path=$1 action proto port src comment
  nft_ensure_rules_file
  {
    cat <<EOF
# Managed by SUF ${APP_VERSION}
table inet suf
delete table inet suf
table inet suf {
  chain input {
    type filter hook input priority -100; policy drop;
    iifname "lo" accept
    ct state established,related accept
    ip protocol icmp accept
    ip6 nexthdr icmpv6 accept
EOF
    while IFS='|' read -r action proto port src comment; do
      [[ -n ${action:-} && -n ${proto:-} && -n ${port:-} && -n ${src:-} ]] || continue
      comment=${comment:-受 SUF 管理的服务}
      if [[ $src == any ]]; then
        if [[ $action == limit ]]; then
          printf '    %s dport %s ct state new limit rate 12/minute burst 6 packets accept comment "%s"\n' \
            "$proto" "$port" "$comment"
        else
          printf '    %s dport %s accept comment "%s"\n' "$proto" "$port" "$comment"
        fi
      elif [[ $src == *:* ]]; then
        if [[ $action == limit ]]; then
          printf '    ip6 saddr %s %s dport %s ct state new limit rate 12/minute burst 6 packets accept comment "%s"\n' \
            "$src" "$proto" "$port" "$comment"
        else
          printf '    ip6 saddr %s %s dport %s accept comment "%s"\n' "$src" "$proto" "$port" "$comment"
        fi
      else
        if [[ $action == limit ]]; then
          printf '    ip saddr %s %s dport %s ct state new limit rate 12/minute burst 6 packets accept comment "%s"\n' \
            "$src" "$proto" "$port" "$comment"
        else
          printf '    ip saddr %s %s dport %s accept comment "%s"\n' "$src" "$proto" "$port" "$comment"
        fi
      fi
    done <"$NFT_RULES_FILE"
    cat <<'EOF'
  }
  chain output { type filter hook output priority 100; policy accept; }
}
EOF
  } >"$output_path"
}

nft_apply_config_file() {
  local conf_file=$1
  install -d -m 755 "$(dirname "$NFT_CONF")"
  install -m 600 -o root -g root "$conf_file" "$NFT_CONF"
  if ! nft -f "$NFT_CONF"; then
    nft delete table inet suf 2>/dev/null || true
    nft -f "$NFT_CONF"
  fi
  nft_persistence
}

nft_validate_and_sync() {
  local snapshot=${1:-} tmp_conf
  nft_ensure_rules_file
  nft_sort_rules_file
  tmp_conf=$(mktemp)
  nft_render_config "$tmp_conf"
  if ! nft -c -f "$tmp_conf"; then
    rm -f "$tmp_conf"
    if [[ -n $snapshot && -f $snapshot ]]; then
      cp -a "$snapshot" "$NFT_RULES_FILE"
    fi
    die "nftables 规则校验失败，未应用变更。"
  fi
  if nft_table_exists; then
    nft_apply_config_file "$tmp_conf"
  fi
  rm -f "$tmp_conf"
}

nft_format_source() {
  local src=$1
  if [[ $src == any ]]; then
    printf '任意来源（IPv4/IPv6）'
  elif [[ $src == *:* ]]; then
    printf '%s（IPv6）' "$src"
  else
    printf '%s（IPv4）' "$src"
  fi
}

nft_format_action() {
  case "$1" in
    allow) printf '允许入站' ;;
    limit) printf '限制入站连接' ;;
    *) printf '%s' "$1" ;;
  esac
}

nft_print_rules_table() {
  local numbered=${1:-yes} index=0 action proto port src comment
  local target_text action_text source_text
  nft_ensure_rules_file
  nft_sort_rules_file
  if [[ ! -s $NFT_RULES_FILE ]]; then
    printf '  当前没有已保存的放行或连接限速规则。\n'
    return 0
  fi
  if [[ $numbered == yes ]]; then
    printf '  '; pad_col "编号" 5; printf ' '; pad_col "目标" 12; printf ' '; pad_col "操作" 14; printf ' '; pad_col "来源" 28; printf ' %s\n' "备注"
  else
    printf '  '; pad_col "目标" 12; printf ' '; pad_col "操作" 14; printf ' '; pad_col "来源" 28; printf ' %s\n' "备注"
  fi
  while IFS='|' read -r action proto port src comment; do
    [[ -n ${action:-} && -n ${proto:-} && -n ${port:-} && -n ${src:-} ]] || continue
    index=$((index + 1))
    target_text="${port}/${proto}"
    action_text=$(nft_format_action "$action")
    source_text=$(nft_format_source "$src")
    if [[ $numbered == yes ]]; then
      printf '  '; pad_col "[${index}]" 5; printf ' '; pad_col "$target_text" 12; printf ' '; pad_col "$action_text" 14; printf ' '; pad_col "$source_text" 28; printf ' %s\n' "${comment:-受 SUF 管理的服务}"
    else
      printf '  '; pad_col "$target_text" 12; printf ' '; pad_col "$action_text" 14; printf ' '; pad_col "$source_text" 28; printf ' %s\n' "${comment:-受 SUF 管理的服务}"
    fi
  done <"$NFT_RULES_FILE"
  ((index > 0)) || printf '  当前没有已保存的放行或连接限速规则。\n'
}

nft_ssh_port_covered_by_rules() {
  local port=$1 client_ip=${2:-} action proto rport src _comment
  nft_ensure_rules_file
  while IFS='|' read -r action proto rport src _comment; do
    [[ $proto == tcp && $((10#$rport)) -eq $((10#$port)) ]] || continue
    [[ $src == any ]] && return 0
    if [[ -n $client_ip ]] && ip_matches_source "$client_ip" "$src"; then
      return 0
    fi
  done <"$NFT_RULES_FILE"
  return 1
}

nft_warn_if_ssh_uncovered() {
  local ssh_port client_ip
  find_sshd >/dev/null 2>&1 || return 0
  ssh_port=$(current_ssh_port)
  client_ip=$(current_ssh_client_ip || true)
  if ! nft_ssh_port_covered_by_rules "$ssh_port" "$client_ip"; then
    warn "当前规则中没有任何放行 SSH 端口 ${ssh_port}/tcp 的规则！若防火墙已启用，应用后可能导致 SSH 断开并无法重连。"
  fi
}

require_nftables() { command -v nft >/dev/null 2>&1 || die "nftables 尚未安装，请先选择安装。"; }

ensure_default_web_nft_rules() {
  local port protocol comment snapshot added=0
  nft_ensure_rules_file
  snapshot=$(mktemp)
  cp -a "$NFT_RULES_FILE" "$snapshot"
  for port in 80 443; do
    if [[ $port == 80 ]]; then comment='网页 HTTP'; else comment='加密网页 HTTPS'; fi
    for protocol in tcp udp; do
      if nft_rule_exists_any_source "$protocol" "$port"; then
        continue
      fi
      nft_upsert_rule allow "$protocol" "$port" any "$comment"
      ok "已默认保存放行规则：${port}/${protocol}。"
      added=1
    done
  done
  if ((added)); then
    nft_validate_and_sync "$snapshot"
  fi
  rm -f "$snapshot"
}

install_nftables_service() {
  apk_install nftables
  ensure_default_web_nft_rules
  ok "nftables 已安装。安装不会自动启用防火墙。"
}

enable_nftables_service() {
  local ssh_port source_ip snapshot tmp_conf has_any_rule=0
  require_nftables
  if nft_table_exists; then
    ok "SUF nftables 规则已经处于启用状态。"
    return
  fi
  ensure_openssh
  nft_ensure_rules_file
  ssh_port=$(current_ssh_port)
  source_ip=$(current_ssh_client_ip || true)

  snapshot=$(mktemp)
  cp -a "$NFT_RULES_FILE" "$snapshot"

  if awk -F'|' -v port="$ssh_port" '$2 == "tcp" && ($3 + 0) == (port + 0) { found = 1 } END { exit !found }' "$NFT_RULES_FILE"; then
    has_any_rule=1
  fi
  if ((has_any_rule == 0)); then
    info "为当前 SSH 端口 ${ssh_port}/tcp 自动添加放行规则（同时支持 IPv4/IPv6）。"
    nft_upsert_rule allow tcp "$ssh_port" any "SUF SSH 管理"
  elif ! nft_ssh_port_covered_by_rules "$ssh_port" "$source_ip"; then
    if [[ -n $source_ip ]]; then
      info "检测到 ${ssh_port}/tcp 已限制来源，为当前 SSH 来源 ${source_ip} 补充临时访问权限防锁死。"
      nft_upsert_rule allow tcp "$ssh_port" "$source_ip" "当前 SSH 客户端"
    else
      warn "未检测到当前 SSH 来源且 ${ssh_port}/tcp 已设置来源限制；为防止失联，将放行所有来源访问 TCP/${ssh_port}。"
      confirm "确认按此方式保护当前管理入口吗？" || { cp -a "$snapshot" "$NFT_RULES_FILE"; rm -f "$snapshot"; die "取消启用。"; }
      nft_upsert_rule allow tcp "$ssh_port" any "SSH 管理入口"
    fi
  fi

  nft_sort_rules_file
  tmp_conf=$(mktemp)
  nft_render_config "$tmp_conf"
  if ! nft -c -f "$tmp_conf"; then
    cp -a "$snapshot" "$NFT_RULES_FILE"
    rm -f "$tmp_conf" "$snapshot"
    die "nftables 规则校验失败，未启用防火墙。"
  fi

  warn "nftables 启用后，未明确放行的入站端口将被阻止；云安全组不受本机防火墙控制。"
  show_nftables_allowed_ports
  if ! confirm "确认以上规则完整，可以启用 SUF nftables 吗？"; then
    cp -a "$snapshot" "$NFT_RULES_FILE"
    rm -f "$tmp_conf" "$snapshot"
    die "未启用 nftables。"
  fi

  nft_apply_config_file "$tmp_conf"
  rm -f "$tmp_conf" "$snapshot"
  nft_handle_conflicting_filter_table
  rc-update add nftables default >/dev/null 2>&1 || true
  rc-service nftables start >/dev/null 2>&1 || true
  ok "SUF nftables 规则已启用，SSH 端口 ${ssh_port} 已放行。"
  show_nftables_status
}

disable_nftables_service() {
  require_nftables
  warn "关闭 SUF nftables 规则会让监听端口失去这层防火墙保护。"
  confirm "确认关闭 SUF nftables 规则吗？" || die "取消关闭。"
  nft delete table inet suf 2>/dev/null || true
  nft_disable_persistence
  ok "SUF nftables 防火墙规则已移除；规则记录仍保留在 ${NFT_RULES_FILE}。"
}

uninstall_nftables_service() {
  require_nftables
  warn "将移除 SUF nftables 规则并卸载软件包，但保留 ${NFT_RULES_FILE} 配置。"
  confirm "确认卸载 nftables 并保留配置吗？" || die "取消卸载。"
  nft delete table inet suf 2>/dev/null || true
  nft_disable_persistence
  rc-service nftables stop >/dev/null 2>&1 || true
  rc-update del nftables default >/dev/null 2>&1 || true
  apk del nftables
  ok "nftables 已卸载，规则配置仍保留。"
}

show_nftables_status() {
  if ! command -v nft >/dev/null 2>&1; then
    printf 'nftables：%s\n' "$(colored_status 未安装)"
    return
  fi
  nft_ensure_rules_file
  printf 'nftables 防火墙状态\n'
  if nft_table_exists; then
    printf '  状态：%s\n' "$(colored_status 已启用)"
  else
    printf '  状态：%s\n' "$(colored_status 未启用)"
  fi
  printf '  规则表类型：inet（同时支持 IPv4 / IPv6）\n'
  printf '  默认策略：拒绝（入站），允许（出站）\n'
  printf '  基础放行：本地回环（lo）、已建立连接（established/related）、ICMP、ICMPv6\n'
  if nft_table_exists; then
    printf '\n已应用的放行/限速规则：\n'
  else
    printf '\n待应用的放行/限速规则（启用后生效）：\n'
  fi
  nft_print_rules_table no
}

show_nftables_rules() {
  local tmp_conf
  require_nftables
  nft_ensure_rules_file
  printf 'nftables 规则（按编号）\n'
  nft_print_rules_table yes
  if nft_table_exists; then
    printf '\n已应用的底层 nftables 规则：\n'
    nft list table inet suf
  else
    warn "nftables 当前未启用，以上编号为待应用规则编号。"
    printf '\n待应用的底层 nftables 规则预览：\n'
    tmp_conf=$(mktemp)
    nft_render_config "$tmp_conf"
    cat "$tmp_conf"
    rm -f "$tmp_conf"
  fi
}

reload_nftables() {
  local tmp_conf
  require_nftables
  nft_ensure_rules_file
  nft_sort_rules_file
  if ! nft_table_exists; then
    warn "SUF nftables 规则当前未启用，仅校验已保存规则。"
    tmp_conf=$(mktemp)
    nft_render_config "$tmp_conf"
    nft -c -f "$tmp_conf" || { rm -f "$tmp_conf"; die "nftables 规则校验失败。"; }
    rm -f "$tmp_conf"
    ok "待应用规则校验通过；如需开启防火墙请选择“启用 SUF nftables 规则”。"
    return
  fi
  nft_validate_and_sync
  ok "nftables 规则已重新加载。"
}

show_nftables_allowed_ports() {
  local action proto port src comment found=0
  require_nftables
  nft_ensure_rules_file
  nft_sort_rules_file
  printf 'nftables 已保存的放行/限速端口\n'
  if ! nft_table_exists; then
    warn "nftables 当前未启用；以下规则将在启用后生效。"
  fi
  while IFS='|' read -r action proto port src comment; do
    [[ -n ${action:-} && -n ${proto:-} && -n ${port:-} && -n ${src:-} ]] || continue
    if [[ $action == limit ]]; then
      printf '  限速：%s/%s' "$port" "$proto"
    else
      printf '  放行：%s/%s' "$port" "$proto"
    fi
    if [[ $src != any ]]; then
      printf '，来源 %s' "$(nft_format_source "$src")"
    fi
    printf '，备注 %s\n' "${comment:-受 SUF 管理的服务}"
    found=1
  done <"$NFT_RULES_FILE"
  ((found)) || printf '  没有保存的放行或连接限速规则。\n'
}

nft_allow_port() {
  local port protocols protocol comment snapshot
  require_nftables
  nft_ensure_rules_file
  port=$(prompt_port 443 "要放行的端口")
  protocols=$(prompt_allow_protocols)
  comment=$(prompt_rule_comment '受 SUF 管理的服务')
  snapshot=$(mktemp)
  cp -a "$NFT_RULES_FILE" "$snapshot"
  for protocol in $protocols; do
    nft_upsert_rule allow "$protocol" "$port" any "$comment"
  done
  nft_validate_and_sync "$snapshot"
  rm -f "$snapshot"
  ok "已放行端口 ${port} 的协议：${protocols}，备注：${comment}。"
}

nft_allow_source_to_port() {
  local source port protocol comment snapshot broad_count
  require_nftables
  nft_ensure_rules_file
  while true; do
    if ! read -r -p "允许的来源 IP 或 CIDR：" source; then
      printf '\n' >&2
      return 1
    fi
    valid_ip_or_cidr "$source" && break
    warn "IP 或 CIDR 格式无效（例如 1.2.3.4、1.2.3.0/24、2404:3881::/32）。"
  done
  port=$(prompt_port 22 "要限制来源的端口")
  protocol=$(prompt_protocol)
  comment=$(prompt_rule_comment '仅限指定来源')

  snapshot=$(mktemp)
  cp -a "$NFT_RULES_FILE" "$snapshot"

  broad_count=$(awk -F'|' -v proto="$protocol" -v port="$port" '
    $2 == proto && ($3 + 0) == (port + 0) && $4 == "any" { count++ }
    END { print count + 0 }
  ' "$NFT_RULES_FILE")
  if ((broad_count > 0)); then
    warn "检测到 ${port}/${protocol} 仍有对所有来源开放的规则："
    awk -F'|' -v proto="$protocol" -v port="$port" '
      $2 == proto && ($3 + 0) == (port + 0) && $4 == "any" {
        printf "  %s：%s/%s（%s）\n", ($1 == "limit" ? "限速" : "放行"), $3, $2, $5
      }
    ' "$NFT_RULES_FILE"
    if ! confirm "删除这些广泛放行规则，使 IP 限制真正生效吗？"; then
      rm -f "$snapshot"
      die "已保留广泛规则，因此不能称为仅允许指定 IP。"
    fi
    local tmp
    tmp=$(mktemp)
    awk -F'|' -v proto="$protocol" -v port="$port" '
      !($2 == proto && ($3 + 0) == (port + 0) && $4 == "any") { print }
    ' "$NFT_RULES_FILE" >"$tmp"
    install -m 600 -o root -g root "$tmp" "$NFT_RULES_FILE"
    rm -f "$tmp"
  fi

  nft_upsert_rule allow "$protocol" "$port" "$source" "$comment"
  nft_warn_if_ssh_uncovered
  nft_validate_and_sync "$snapshot"
  rm -f "$snapshot"
  ok "已限制为 $(nft_format_source "$source") 可访问 ${port}/${protocol}。"
}

nft_limit_port() {
  local default_port=22 port comment snapshot tmp
  require_nftables
  nft_ensure_rules_file
  if find_sshd >/dev/null 2>&1; then
    default_port=$(current_ssh_port)
  fi
  port=$(prompt_port "$default_port" "要限制新连接的 TCP 端口")
  comment=$(prompt_rule_comment '连接限速服务')
  snapshot=$(mktemp)
  cp -a "$NFT_RULES_FILE" "$snapshot"
  if nft_rule_exists_exact allow tcp "$port" any; then
    tmp=$(mktemp)
    awk -F'|' -v port="$port" '
      !($1 == "allow" && $2 == "tcp" && ($3 + 0) == (port + 0) && $4 == "any") { print }
    ' "$NFT_RULES_FILE" >"$tmp"
    install -m 600 -o root -g root "$tmp" "$NFT_RULES_FILE"
    rm -f "$tmp"
  fi
  nft_upsert_rule limit tcp "$port" any "$comment"
  nft_validate_and_sync "$snapshot"
  rm -f "$snapshot"
  ok "已为 ${port}/tcp 添加连接限速规则（每分钟 12 次，突发 6 次）；限速仅用于 TCP 连接。"
}

nft_delete_numbered_rule() {
  local total number selected snapshot tmp action proto port src comment
  require_nftables
  nft_ensure_rules_file
  nft_sort_rules_file
  show_nftables_rules
  total=$(wc -l <"$NFT_RULES_FILE")
  ((total > 0)) || die "当前没有可删除的 nftables 规则。"
  read -r -p "要删除的规则编号（直接回车取消）：" number
  [[ -n $number ]] || die "取消删除。"
  [[ $number =~ ^[0-9]+$ ]] && ((10#$number >= 1 && 10#$number <= total)) || die "规则编号无效。"
  number=$((10#$number))
  selected=$(sed -n "${number}p" "$NFT_RULES_FILE")
  IFS='|' read -r action proto port src comment <<<"$selected"
  printf '即将删除规则 [%d]：%s %s/%s（%s，备注：%s）\n' \
    "$number" "$(nft_format_action "$action")" "$port" "$proto" "$(nft_format_source "$src")" "$comment"

  snapshot=$(mktemp)
  cp -a "$NFT_RULES_FILE" "$snapshot"
  tmp=$(mktemp)
  sed "${number}d" "$NFT_RULES_FILE" >"$tmp"
  install -m 600 -o root -g root "$tmp" "$NFT_RULES_FILE"
  rm -f "$tmp"
  nft_warn_if_ssh_uncovered
  if ! confirm "确认删除规则 ${number} 吗？"; then
    cp -a "$snapshot" "$NFT_RULES_FILE"
    rm -f "$snapshot"
    die "取消删除。"
  fi
  nft_validate_and_sync "$snapshot"
  rm -f "$snapshot"
  ok "已删除规则编号 ${number}。"
  show_nftables_rules
}

nft_delete_port_rules() {
  local port protocols protocol match_count snapshot tmp
  require_nftables
  nft_ensure_rules_file
  printf '请选择要删除的已放行或限速端口：\n'
  show_nftables_allowed_ports
  printf '\n'
  port=$(prompt_port 443 "要删除规则的端口")
  protocols=$(prompt_allow_protocols)

  match_count=$(awk -F'|' -v port="$port" -v protos="$protocols" '
    BEGIN { split(protos, p, " "); for (i in p) want[p[i]] = 1 }
    ($3 + 0) == (port + 0) && ($2 in want) { count++ }
    END { print count + 0 }
  ' "$NFT_RULES_FILE")
  ((match_count > 0)) || die "未找到端口 ${port}（${protocols}）的 nftables 规则。"

  printf '将删除端口 %s 的以下 %d 条规则：\n' "$port" "$match_count"
  awk -F'|' -v port="$port" -v protos="$protocols" '
    BEGIN { split(protos, p, " "); for (i in p) want[p[i]] = 1 }
    ($3 + 0) == (port + 0) && ($2 in want) {
      printf "  %s %s/%s（%s，备注：%s）\n", ($1 == "limit" ? "限制入站连接" : "允许入站"), $3, $2, ($4 == "any" ? "任意来源" : $4), $5
    }
  ' "$NFT_RULES_FILE"

  snapshot=$(mktemp)
  cp -a "$NFT_RULES_FILE" "$snapshot"
  tmp=$(mktemp)
  awk -F'|' -v port="$port" -v protos="$protocols" '
    BEGIN { split(protos, p, " "); for (i in p) want[p[i]] = 1 }
    !(($3 + 0) == (port + 0) && ($2 in want)) { print }
  ' "$NFT_RULES_FILE" >"$tmp"
  install -m 600 -o root -g root "$tmp" "$NFT_RULES_FILE"
  rm -f "$tmp"
  nft_warn_if_ssh_uncovered
  if ! confirm "确认删除这些规则吗？请输入 y 执行删除"; then
    cp -a "$snapshot" "$NFT_RULES_FILE"
    rm -f "$snapshot"
    die "取消删除。"
  fi
  nft_validate_and_sync "$snapshot"
  rm -f "$snapshot"
  ok "已删除端口 ${port} 的 ${match_count} 条规则。"
  show_nftables_rules
}

